{% extends 'base.html.twig' %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}{{ title }} | GTAC2A-IARDT{% endblock %}

{% block body %}
<div class="mb-3 flex-shrink-0">
    <a href="{{ path('app_personnel_index') }}" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 mb-2">
        <i class="bi bi-arrow-left"></i>
        <span>Retour au répertoire du personnel</span>
    </a>
    <div class="d-flex align-items-center gap-2">
        <div class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0"
             style="width: 44px; height: 44px; background: linear-gradient(135deg, var(--gta-orange) 0%, #ff8c1a 100%);">
            <i class="bi bi-person-vcard fs-5"></i>
        </div>
        <div>
            <h1 class="h3 fw-bold mb-0" style="color: #121212;">{{ title }}</h1>
            <p class="text-muted mb-0 small">Enregistrement et gestion des collaborateurs et intervenants</p>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 col-xl-9">
        <div class="card card-form mb-4">
            <div class="card-body p-4 p-md-5">
                {{ form_start(form) }}

                <!-- Section 1 : Identification & Profil -->
                <div class="form-section-title d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <i class="bi bi-person-badge-fill text-primary"></i>
                    <span class="fw-bold">Identification & Statut Professionnel</span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-4">
                        {{ form_label(form.matricule) }}
                        <div class="input-group">
                            <span class="input-group-text font-monospace bg-light"><i class="bi bi-upc"></i></span>
                            {{ form_widget(form.matricule, {'attr': {'id': 'personnel_matricule'}}) }}
                            <button type="button" class="btn btn-outline-secondary" onclick="autoGenerateMatricule()" title="Régénérer automatiquement selon le service">
                                <i class="bi bi-arrow-repeat"></i>
                            </button>
                        </div>
                        <div class="form-text small" style="font-size: 0.72rem;">Exemple : <code>PROD-0058</code>, <code>SANTE-0012</code></div>
                        {{ form_errors(form.matricule) }}
                    </div>

                    <div class="col-12 col-md-8">
                        {{ form_label(form.nom) }}
                        {{ form_widget(form.nom) }}
                        {{ form_errors(form.nom) }}
                    </div>

                    <div class="col-12 col-md-6">
                        {{ form_label(form.type) }}
                        {{ form_widget(form.type) }}
                        {{ form_errors(form.type) }}
                    </div>

                    <div class="col-12 col-md-6">
                        {{ form_label(form.service) }}
                        {{ form_widget(form.service, {'attr': {'id': 'personnel_service', 'onchange': 'onServiceChanged(this.value)', 'onblur': 'onServiceChanged(this.value)'}}) }}
                        <datalist id="services_datalist">
                            {% for s in services|default([]) %}
                                <option value="{{ s }}">
                            {% endfor %}
                        </datalist>
                        {{ form_errors(form.service) }}
                    </div>
                </div>

                <!-- Section 2 : Coordonnées & Statut -->
                <div class="form-section-title d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <i class="bi bi-telephone-inbound-fill text-success"></i>
                    <span class="fw-bold">Coordonnées & État Opérationnel</span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-5">
                        {{ form_label(form.email) }}
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            {{ form_widget(form.email) }}
                        </div>
                        {{ form_errors(form.email) }}
                    </div>

                    <div class="col-12 col-md-4">
                        {{ form_label(form.telephone) }}
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                            {{ form_widget(form.telephone) }}
                        </div>
                        {{ form_errors(form.telephone) }}
                    </div>

                    <div class="col-12 col-md-3">
                        {{ form_label(form.statut) }}
                        {{ form_widget(form.statut) }}
                        {{ form_errors(form.statut) }}
                    </div>

                    <div class="col-12">
                        {{ form_label(form.notes) }}
                        {{ form_widget(form.notes) }}
                        {{ form_errors(form.notes) }}
                    </div>
                </div>

                <!-- Boutons d'action -->
                <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                    <a href="{{ path('app_personnel_index') }}" class="btn btn-outline-secondary">Annuler</a>
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 fw-bold shadow-sm">
                        <i class="bi bi-check-lg fs-5"></i>
                        <span>Enregistrer le personnel</span>
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <!-- Carte d'aide latérale -->
    <div class="col-12 col-xl-3">
        <div class="card border-0 shadow-sm p-3 mb-3 bg-light">
            <h6 class="fw-bold mb-2 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-info-circle text-primary"></i>
                <span>Format du Matricule</span>
            </h6>
            <p class="small text-muted mb-2">
                Le matricule est automatiquement composé du code du <strong>Service</strong> et d'un numéro d'ordre :
            </p>
            <ul class="small text-muted ps-3 mb-2">
                <li>Production : <code>PROD-0058</code></li>
                <li>Santé : <code>SANTE-0012</code></li>
                <li>Commercial : <code>COMM-0004</code></li>
                <li>Informatique : <code>DSI-0001</code></li>
                <li>Générique : <code>PERS-0001</code></li>
            </ul>
            <small class="text-secondary fst-italic">
                Vous pouvez le modifier manuellement à tout moment si besoin.
            </small>
        </div>

        {% if personnel.id %}
            <div class="card border-0 shadow-sm p-3">
                <h6 class="fw-bold mb-2 text-dark">Matériels Actuellement Détenus</h6>
                {% set attributions = personnel.attributions %}
                {% if attributions|length > 0 %}
                    <div class="d-flex flex-column gap-2">
                        {% for a in attributions %}
                            {% if a.statut == 'En cours' and a.equipement %}
                                <div class="p-2 border rounded bg-light small">
                                    <div class="fw-bold text-dark">{{ a.equipement.nom }}</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">{{ a.equipement.tagInventaire ?: a.equipement.numeroSerie }}</div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-muted small mb-0">Aucun équipement attribué pour l'instant.</p>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>

<script>
    function onServiceChanged(serviceVal) {
        const matInput = document.getElementById('personnel_matricule');
        // Si matricule vide ou commence par un code générique, proposer le nouveau matricule
        if (matInput && (!matInput.value || matInput.value.startsWith('PERS-'))) {
            autoGenerateMatricule();
        }
    }

    function autoGenerateMatricule() {
        const serviceInput = document.getElementById('personnel_service');
        const matInput = document.getElementById('personnel_matricule');
        const serviceVal = serviceInput ? serviceInput.value : '';

        fetch('{{ path("api_personnel_next_matricule") }}?service=' + encodeURIComponent(serviceVal))
            .then(res => res.json())
            .then(data => {
                if (data && data.matricule && matInput) {
                    matInput.value = data.matricule;
                }
            })
            .catch(err => console.error('Erreur génération matricule', err));
    }
</script>
{% endblock %}


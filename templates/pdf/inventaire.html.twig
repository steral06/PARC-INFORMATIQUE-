{% extends 'pdf/base_pdf.html.twig' %}

{% block title %}Procès-Verbal d'Inventaire — {{ campagne.titre }} | GTAC2A-IARDT{% endblock %}
{% block doc_title %}PROCÈS-VERBAL D'INVENTAIRE{% endblock %}

{% block extra_styles %}
    @page { margin: 15mm 12mm 15mm 12mm; }
    .kpi-table { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
    .kpi-table td {
        padding: 8px;
        text-align: center;
        border: 1px solid #ddd;
        background: #faf8f5;
    }
    .kpi-table .num { font-size: 14pt; font-weight: bold; color: #121212; }
    .kpi-table .lbl { font-size: 7.5pt; color: #666; text-transform: uppercase; }
{% endblock %}

{% block body %}

{# ─── Titre & Synthèse ───────────────────────────────────────── #}
<div style="margin-bottom: 14px;">
    <div style="font-size: 14pt; font-weight: bold; color: #121212;">{{ campagne.titre }}</div>
    <div class="small text-muted">
        Année : <span class="text-bold">{{ campagne.annee }}</span>
        &bull; Période : du {{ campagne.dateDebut|date('d/m/Y') }}
        {% if campagne.dateCloture %}au {{ campagne.dateCloture|date('d/m/Y') }}{% else %}(en cours){% endif %}
        &bull; Responsable : <span class="text-bold">{{ campagne.creePar ?? 'DSI' }}</span>
        &bull; Statut : <span class="text-bold">{{ campagne.statut }}</span>
    </div>
</div>

{# ═════════════════════════════════════════════════════════════════
   Synthèse Chiffrée
═══════════════════════════════════════════════════════════════════ #}
<div class="section-title">1. Synthèse du Recensement Physique</div>

<table class="kpi-table">
    <tr>
        <td style="width: 16%;">
            <div class="num">{{ campagne.totalEquipements }}</div>
            <div class="lbl">Parc Théorique</div>
        </td>
        <td style="width: 16%;">
            <div class="num" style="color: #059669;">{{ campagne.conformesCount }}</div>
            <div class="lbl">Conformes</div>
        </td>
        <td style="width: 16%;">
            <div class="num" style="color: #E47000;">{{ campagne.deplacesCount }}</div>
            <div class="lbl">Déplacés</div>
        </td>
        <td style="width: 16%;">
            <div class="num" style="color: #dc2626;">{{ campagne.manquantsCount }}</div>
            <div class="lbl">Manquants</div>
        </td>
        <td style="width: 16%;">
            <div class="num" style="color: #6c757d;">{{ campagne.horsServiceCount }}</div>
            <div class="lbl">Hors Service</div>
        </td>
        <td style="width: 20%;">
            <div class="num" style="color: #2563eb;">{{ campagne.tauxProgression }}%</div>
            <div class="lbl">Taux Couverture</div>
        </td>
    </tr>
</table>

{# ═════════════════════════════════════════════════════════════════
   Rapport d'écarts
═══════════════════════════════════════════════════════════════════ #}
<div class="section-title">2. Relevé des Écarts &amp; Anomalies ({{ ecarts|length }} cas identifiés)</div>

{% if ecarts is empty %}
    <div class="notes-box text-center">
        <strong>Félicitations :</strong> Aucun écart n'a été constaté lors de ce recensement. Tous les matériels contrôlés sont présents et conformes à leurs affectations théoriques.
    </div>
{% else %}
    <table class="data-table" style="font-size: 8pt;">
        <thead>
            <tr>
                <th style="width: 22%;">Équipement</th>
                <th style="width: 16%;">S/N / Tag</th>
                <th style="width: 12%;">Type d'Écart</th>
                <th style="width: 16%;">Lieu Attendu</th>
                <th style="width: 16%;">Lieu Constaté</th>
                <th style="width: 18%;">Observations DSI</th>
            </tr>
        </thead>
        <tbody>
            {% for l in ecarts %}
                {% set eq = l.equipement %}
                <tr>
                    <td class="text-bold">{{ eq.nom }}</td>
                    <td class="mono">{{ eq.numeroSerie }}</td>
                    <td>
                        {% if l.statutConstate == 'Déplacé' %}
                            <span class="badge badge-warning">Déplacé</span>
                        {% elseif l.statutConstate == 'Manquant' %}
                            <span class="badge badge-danger">Manquant</span>
                        {% elseif l.statutConstate == 'Hors service' %}
                            <span class="badge badge-secondary">Hors service</span>
                        {% endif %}
                    </td>
                    <td>{{ l.lieuAttendu ?? '—' }}</td>
                    <td>{{ l.lieuConstate ? l.lieuConstate.nomLieu : '—' }}</td>
                    <td class="small">{{ l.observations ?? 'N/C' }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}

{# ═════════════════════════════════════════════════════════════════
   Conclusions & Signatures
═══════════════════════════════════════════════════════════════════ #}
<div class="section-title" style="margin-top: 20px;">3. Conclusions &amp; Signatures des Parties Prenantes</div>

<div class="notes-box mb-2" style="font-size: 8.5pt;">
    Le présent procès-verbal atteste de l'exactitude des opérations de recensement physique conduites dans le cadre de la campagne d'inventaire <strong>« {{ campagne.titre }} »</strong>. Les anomalies identifiées ci-dessus feront l'objet d'actions correctives (recherches, réaffectations de bureaux, ouverture de tickets de maintenance).
</div>

<table style="width: 100%; border-collapse: collapse; margin-top: 30px; font-size: 9pt;">
    <tr>
        <td style="width: 50%; padding: 10px; border: 1px solid #ddd; vertical-align: top;">
            <div class="text-bold text-center">Pour la Direction des Systèmes d'Information (DSI)</div>
            <div class="text-muted text-center small">Le Responsable d'Inventaire</div>
            <div style="height: 60px;"></div>
            <div class="text-center small">Nom, Prénom &amp; Signature : _____________________</div>
        </td>
        <td style="width: 50%; padding: 10px; border: 1px solid #ddd; vertical-align: top;">
            <div class="text-bold text-center">Pour la Direction Générale / Contrôle Interne</div>
            <div class="text-muted text-center small">Visa de Conformité</div>
            <div style="height: 60px;"></div>
            <div class="text-center small">Date &amp; Signature : _____________________</div>
        </td>
    </tr>
</table>

{% endblock %}


{% extends 'base.html.twig' %}

{% macro historique_row(att) %}
    {% set eq = att.equipement %}
    <div class="d-flex align-items-center justify-content-between gap-3 px-3 py-3 att-row border-bottom">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:38px;height:38px;background:rgba(108,117,125,.1);color:#6c757d;">
                {% if eq %}
                    {% set catName = eq.categorie ? eq.categorie.nomCat : '' %}
                    {% if 'Portable' in catName %}<i class="bi bi-laptop fs-5"></i>
                    {% elseif 'Centrale' in catName or 'PC Fix' in catName or 'bureau' in catName %}<i class="bi bi-pc-display fs-5"></i>
                    {% elseif 'Imprimante' in catName %}<i class="bi bi-printer fs-5"></i>
                    {% elseif 'Serveur' in catName %}<i class="bi bi-server fs-5"></i>
                    {% elseif 'Réseau' in catName %}<i class="bi bi-router fs-5"></i>
                    {% elseif 'Onduleur' in catName %}<i class="bi bi-battery-charging fs-5"></i>
                    {% elseif 'cran' in catName %}<i class="bi bi-display fs-5"></i>
                    {% else %}<i class="bi bi-hdd fs-5"></i>
                    {% endif %}
                {% else %}
                    <i class="bi bi-question-circle fs-5"></i>
                {% endif %}
            </div>
            <div>
                {% if eq %}
                    <div class="fw-semibold small">
                        <a href="{{ path('app_equipement_show', {'id': eq.id}) }}"
                           class="text-decoration-none text-dark">{{ eq.nom }}</a>
                    </div>
                    <div class="text-muted" style="font-size:.75rem;">
                        {{ eq.marque }} {{ eq.modele }}
                        {% if eq.tagInventaire %}&bull; <span class="font-monospace">{{ eq.tagInventaire }}</span>{% endif %}
                    </div>
                    <div class="mt-1" style="font-size:.72rem;">
                        <span class="badge bg-light text-dark border">
                            {{ eq.categorie ? eq.categorie.nomCat : 'Sans catégorie' }}
                        </span>
                    </div>
                {% else %}
                    <span class="text-muted small fst-italic">Équipement supprimé</span>
                    {% if att.beneficiaireNom %}<div class="small text-muted">{{ att.beneficiaireNom }}</div>{% endif %}
                {% endif %}
            </div>
        </div>
        <div class="text-end flex-shrink-0">
            {% if att.statut == 'Restitué' %}
                <span class="badge badge-att-restitue rounded-pill mb-1">Restitué</span>
            {% elseif att.statut == 'Prolongé' %}
                <span class="badge badge-att-prolonge rounded-pill mb-1">Prolongé</span>
            {% else %}
                <span class="badge bg-secondary-subtle text-dark border rounded-pill mb-1">{{ att.statut }}</span>
            {% endif %}
            <div class="text-muted small">{{ att.dateDebut|date('d/m/Y') }}</div>
            {% if att.dateRestitution %}
                <div class="text-muted" style="font-size:.72rem;">
                    Restitué le {{ att.dateRestitution|date('d/m/Y') }}
                </div>
            {% elseif att.dateFinPrevue %}
                <div class="text-muted" style="font-size:.72rem;">
                    Prévu le {{ att.dateFinPrevue|date('d/m/Y') }}
                </div>
            {% endif %}
        </div>
    </div>
{% endmacro %}

{% block title %}{{ personnel.nom }} | Fiche Personnel — GTAC2A-IARDT{% endblock %}

{% block stylesheets %}
<style>
    /* ─── Avatar initiales ─── */
    .avatar-circle {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 700;
        flex-shrink: 0;
        background: linear-gradient(135deg, var(--gta-orange) 0%, #ff8c1a 100%);
        color: #fff;
        letter-spacing: 1px;
        box-shadow: 0 4px 16px rgba(228, 112, 0, 0.25);
    }

    /* ─── Type badges ─── */
    .badge-type-employe    { background: rgba(16,185,129,.12); color:#059669; border:1px solid rgba(16,185,129,.3); font-weight:600; }
    .badge-type-prestataire{ background: rgba(37,99,235,.12);  color:#2563eb; border:1px solid rgba(37,99,235,.3);  font-weight:600; }
    .badge-type-stagiaire  { background: rgba(147,51,234,.12); color:#9333ea; border:1px solid rgba(147,51,234,.3); font-weight:600; }
    .badge-type-visiteur   { background: rgba(228,112,0,.12);  color:var(--gta-orange); border:1px solid rgba(228,112,0,.35); font-weight:600; }

    [data-bs-theme="dark"] .badge-type-employe    { background: rgba(5,46,22,.35);   color:#6ee7b7; border-color: rgba(16,185,129,.3); }
    [data-bs-theme="dark"] .badge-type-prestataire{ background: rgba(12,35,64,.45);  color:#93c5fd; border-color: rgba(59,130,246,.3); }
    [data-bs-theme="dark"] .badge-type-stagiaire  { background: rgba(46,16,101,.4);  color:#d8b4fe; border-color: rgba(168,85,247,.3); }
    [data-bs-theme="dark"] .badge-type-visiteur   { background: rgba(69,26,3,.4);    color:#fbbf24; border-color: rgba(228,112,0,.4); }

    /* ─── Scroll pane droite ─── */
    .scroll-pane-right { max-height: calc(100vh - 100px); overflow-y: auto; }

    /* ─── Ligne tableau hover ─── */
    .att-row { transition: background .12s; }
    .att-row:hover { background: rgba(228, 112, 0, 0.04); }

    /* ─── Carte fixe gauche ─── */
    .fiche-sticky { position: sticky; top: 0; }

    /* ─── Statut badges attribution ─── */
    .badge-att-encours   { background: rgba(16,185,129,.12); color:#059669; border:1px solid rgba(16,185,129,.3); }
    .badge-att-restitue  { background: rgba(108,117,125,.12); color:#6c757d; border:1px solid rgba(108,117,125,.3); }
    .badge-att-prolonge  { background: rgba(228,112,0,.12); color:var(--gta-orange); border:1px solid rgba(228,112,0,.35); }

    [data-bs-theme="dark"] .fiche-sticky .card { background: #191e2b !important; }
</style>
{% endblock %}

{% block body %}

{# ─── Fil d'Ariane + Header ──────────────────────────────────── #}
<div class="mb-3 flex-shrink-0">
    <a href="{{ path('app_personnel_index') }}" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 mb-2">
        <i class="bi bi-arrow-left"></i>
        <span>Retour au répertoire</span>
    </a>
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div class="d-flex align-items-center gap-3">
            {# Avatar initiales #}
            <div class="avatar-circle">
                {{ personnel.nom|split(' ')|map(w => w|slice(0,1))|join('')|upper|slice(0,2) }}
            </div>
            <div>
                <h1 class="h3 fw-bold mb-1" style="color: #121212;">{{ personnel.nom }}</h1>
                <p class="text-muted mb-0 small">
                    <span class="font-monospace text-dark fw-semibold me-2">{{ personnel.matricule }}</span>
                    {% if personnel.service %}&bull; {{ personnel.service }}{% endif %}
                </p>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            {# Bouton PDF grisé pour version ultérieure #}
            <button type="button"
                    class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 shadow-sm opacity-50"
                    disabled
                    title="Export PDF bientôt disponible (version ultérieure)"
                    style="cursor: not-allowed;">
                <i class="bi bi-file-earmark-pdf text-secondary"></i>
                <span>PDF</span>
                <span class="badge bg-secondary-subtle text-secondary border ms-1" style="font-size: 0.65rem;">Bientôt</span>
            </button>
            <a href="{{ path('app_attribution_new', {'personnel_id': personnel.id}) }}"
               class="btn btn-dark btn-sm d-inline-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-laptop"></i>
                <span>Attribuer un équipement</span>
            </a>
            <a href="{{ path('app_personnel_edit', {'id': personnel.id}) }}"
               class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 shadow-sm"
               data-shortcut="m" title="Raccourci : M">
                <i class="bi bi-pencil"></i>
                <span>Modifier</span>
            </a>
        </div>
    </div>
</div>

<div class="row g-4 align-items-start">

    {# ═══════════════════════════════════════════════════════════════
       COLONNE GAUCHE — Fiche Identité (sticky)
    ═══════════════════════════════════════════════════════════════ #}
    <div class="col-12 col-lg-5 fiche-sticky">

        {# Carte Identité #}
        <div class="card card-form mb-3">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <span class="fw-bold small"><i class="bi bi-person-badge me-1 text-primary"></i> Identité</span>
                {% if personnel.statut == 'Actif' %}
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Actif</span>
                {% elseif personnel.statut == 'Inactif' %}
                    <span class="badge bg-secondary-subtle text-dark border">Inactif</span>
                {% else %}
                    <span class="badge bg-warning-subtle text-dark border">{{ personnel.statut }}</span>
                {% endif %}
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush small">

                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted">Matricule</span>
                        <strong class="font-monospace text-dark">{{ personnel.matricule }}</strong>
                    </li>

                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted">Type</span>
                        {% set typeClass = {
                            'Employé':     'badge-type-employe',
                            'Prestataire': 'badge-type-prestataire',
                            'Stagiaire':   'badge-type-stagiaire',
                            'Visiteur':    'badge-type-visiteur'
                        } %}
                        {% set typeIcon = {
                            'Employé':     'bi-briefcase-fill',
                            'Prestataire': 'bi-building',
                            'Stagiaire':   'bi-mortarboard-fill',
                            'Visiteur':    'bi-person-walking'
                        } %}
                        <span class="badge {{ typeClass[personnel.type] ?? 'bg-secondary-subtle text-dark border' }}">
                            <i class="bi {{ typeIcon[personnel.type] ?? 'bi-person' }} me-1"></i>
                            {{ personnel.type }}
                        </span>
                    </li>

                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted">Service / Direction</span>
                        <span class="fw-semibold">{{ personnel.service ?? '—' }}</span>
                    </li>

                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted">Adresse e-mail</span>
                        {% if personnel.email %}
                            <a href="mailto:{{ personnel.email }}" class="text-decoration-none small font-monospace text-primary">
                                <i class="bi bi-envelope me-1"></i>{{ personnel.email }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </li>

                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted">Téléphone</span>
                        {% if personnel.telephone %}
                            <a href="tel:{{ personnel.telephone }}" class="text-decoration-none small font-monospace text-primary">
                                <i class="bi bi-telephone me-1"></i>{{ personnel.telephone }}
                            </a>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </li>

                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted">Date d'enregistrement</span>
                        <span>{{ personnel.dateAjout|date('d/m/Y') }}</span>
                    </li>

                </ul>
            </div>
            {% if personnel.notes %}
                <div class="card-footer bg-light p-3">
                    <small class="text-muted fw-bold d-block mb-1"><i class="bi bi-sticky me-1"></i>Notes :</small>
                    <p class="small text-dark mb-0">{{ personnel.notes }}</p>
                </div>
            {% endif %}
        </div>

        {# Carte Compteurs rapides #}
        <div class="card mb-3 shadow-sm border-0">
            <div class="card-body p-3">
                <div class="row g-2 text-center">
                    <div class="col-4">
                        <div class="p-2 rounded-3 bg-success-subtle">
                            <div class="fw-bold fs-5 text-success">{{ attributions_actives|length }}</div>
                            <div class="small text-muted" style="font-size:.72rem;">En cours</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded-3 bg-secondary-subtle">
                            <div class="fw-bold fs-5 text-secondary">{{ attributions_historique|length }}</div>
                            <div class="small text-muted" style="font-size:.72rem;">Historique</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded-3" style="background:rgba(228,112,0,.1);">
                            <div class="fw-bold fs-5" style="color:var(--gta-orange);">{{ (attributions_actives|length + attributions_historique|length) }}</div>
                            <div class="small text-muted" style="font-size:.72rem;">Total</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Bouton Supprimer #}
        {% if is_granted('ROLE_ADMIN') %}
        {% set totalAttribitions = attributions_actives|length + attributions_historique|length %}
        <button type="button"
                class="btn btn-outline-danger btn-sm w-100 d-flex align-items-center justify-content-center gap-1 shadow-sm"
                data-bs-toggle="modal"
                data-bs-target="#gtaDeleteModal"
                data-delete-url="{{ path('app_personnel_delete', {'id': personnel.id}) }}"
                data-item-name="{{ personnel.nom }} ({{ personnel.matricule }})"
                data-token="{{ csrf_token('delete_personnel_' ~ personnel.id) }}"
                data-scandal-count="{{ totalAttribitions }}"
                data-scandal-text="{{ totalAttribitions > 0 ? '⚠️ Ce personnel est lié à ' ~ totalAttribitions ~ ' attribution(s). Sa suppression dissociera ces données du parc !' : '' }}">
            <i class="bi bi-trash3"></i>
            <span>Supprimer cette fiche</span>
        </button>
        {% endif %}
    </div>

    {# ═══════════════════════════════════════════════════════════════
       COLONNE DROITE — Équipements & Historique
    ═══════════════════════════════════════════════════════════════ #}
    <div class="col-12 col-lg-7 scroll-pane-right">

        {# ── Équipements actuellement en dotation ────────────────── #}
        <div class="card mb-4 shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold small text-dark">
                        <i class="bi bi-laptop-fill me-1 text-success"></i> Équipements en dotation
                    </span>
                    <span class="badge bg-success-subtle text-success border font-monospace" style="font-size:.72rem;">
                        {{ attributions_actives|length }}
                    </span>
                </div>
                <a href="{{ path('app_attribution_new', {'personnel_id': personnel.id}) }}"
                   class="btn btn-sm btn-outline-dark py-0 px-2" style="font-size:.78rem;">
                    <i class="bi bi-plus-lg me-1"></i>Attribuer
                </a>
            </div>

            {% if attributions_actives is empty %}
                <div class="card-body text-center py-5">
                    <div class="mb-2 text-muted fs-1"><i class="bi bi-inbox"></i></div>
                    <p class="text-muted small mb-0">Aucun équipement actuellement attribué à ce collaborateur.</p>
                </div>
            {% else %}
                <div class="card-body p-0">
                    {% for att in attributions_actives %}
                        {% set eq = att.equipement %}
                        <div class="d-flex align-items-center justify-content-between gap-3 px-3 py-3 att-row border-bottom">
                            <div class="d-flex align-items-center gap-3">
                                {# Icône catégorie #}
                                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width:40px;height:40px;background:rgba(228,112,0,.1);color:var(--gta-orange);">
                                    {% if eq %}
                                        {% set catName = eq.categorie ? eq.categorie.nomCat : '' %}
                                        {% if 'Portable' in catName or 'portable' in catName %}
                                            <i class="bi bi-laptop fs-5"></i>
                                        {% elseif 'Centrale' in catName or 'PC Fix' in catName or 'bureau' in catName %}
                                            <i class="bi bi-pc-display fs-5"></i>
                                        {% elseif 'Imprimante' in catName or 'Scanner' in catName %}
                                            <i class="bi bi-printer fs-5"></i>
                                        {% elseif 'Serveur' in catName %}
                                            <i class="bi bi-server fs-5"></i>
                                        {% elseif 'Réseau' in catName or 'Télécom' in catName %}
                                            <i class="bi bi-router fs-5"></i>
                                        {% elseif 'Onduleur' in catName or 'nergie' in catName %}
                                            <i class="bi bi-battery-charging fs-5"></i>
                                        {% elseif 'cran' in catName or 'Moniteur' in catName %}
                                            <i class="bi bi-display fs-5"></i>
                                        {% else %}
                                            <i class="bi bi-hdd fs-5"></i>
                                        {% endif %}
                                    {% else %}
                                        <i class="bi bi-question-circle fs-5 text-muted"></i>
                                    {% endif %}
                                </div>
                                <div>
                                    {% if eq %}
                                        <div class="fw-semibold small">
                                            <a href="{{ path('app_equipement_show', {'id': eq.id}) }}"
                                               class="text-decoration-none text-dark">
                                                {{ eq.nom }}
                                            </a>
                                        </div>
                                        <div class="text-muted" style="font-size:.75rem;">
                                            {{ eq.marque }} {{ eq.modele }}
                                            {% if eq.tagInventaire %}
                                                &bull; <span class="font-monospace">{{ eq.tagInventaire }}</span>
                                            {% endif %}
                                            {% if eq.adresseIp %}
                                                &bull; <i class="bi bi-broadcast text-success me-1"></i>{{ eq.adresseIp }}
                                            {% endif %}
                                        </div>
                                        <div class="mt-1" style="font-size:.72rem;">
                                            <span class="badge bg-light text-dark border">
                                                {{ eq.categorie ? eq.categorie.nomCat : 'Sans catégorie' }}
                                            </span>
                                        </div>
                                    {% else %}
                                        <span class="text-muted small fst-italic">Équipement supprimé</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="text-end flex-shrink-0">
                                <div class="badge badge-att-encours rounded-pill mb-1">
                                    <i class="bi bi-circle-fill me-1" style="font-size:.5rem;"></i>En cours
                                </div>
                                <div class="text-muted small">Depuis le</div>
                                <div class="fw-semibold small">{{ att.dateDebut|date('d/m/Y') }}</div>
                                {% if att.dateFinPrevue %}
                                    <div class="text-muted" style="font-size:.72rem;">
                                        Fin prévue : {{ att.dateFinPrevue|date('d/m/Y') }}
                                    </div>
                                {% endif %}
                                {% if eq %}
                                    <a href="{{ path('app_attribution_new', {'equipement_id': eq.id, 'personnel_id': personnel.id}) }}"
                                       class="btn btn-outline-secondary btn-sm py-0 px-2 mt-1" style="font-size:.7rem;" title="Voir l'attribution">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {# ── Historique des équipements passés ───────────────────── #}
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold small text-dark">
                        <i class="bi bi-clock-history me-1 text-secondary"></i> Historique des attributions
                    </span>
                    {% if attributions_historique|length > 0 %}
                        <span class="badge bg-secondary-subtle text-secondary border font-monospace" style="font-size:.72rem;">
                            {{ attributions_historique|length }}
                        </span>
                    {% endif %}
                </div>
                {% if attributions_historique|length > 5 %}
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size:.78rem;"
                            type="button" data-bs-toggle="collapse" data-bs-target="#historiqueCollapse">
                        <i class="bi bi-chevron-down"></i> Tout voir
                    </button>
                {% endif %}
            </div>

            {% if attributions_historique is empty %}
                <div class="card-body text-center py-5">
                    <div class="mb-2 text-muted fs-1"><i class="bi bi-journal-x"></i></div>
                    <p class="text-muted small mb-0">Aucun historique d'équipement pour ce collaborateur.</p>
                </div>
            {% else %}
                <div class="card-body p-0">
                    {% from _self import historique_row %}
                    {# Afficher les 5 premiers toujours visibles #}
                    {% for att in attributions_historique|slice(0, 5) %}
                        {{ historique_row(att) }}
                    {% endfor %}

                    {# Les suivants dans un collapse #}
                    {% if attributions_historique|length > 5 %}
                        <div class="collapse" id="historiqueCollapse">
                            {% for att in attributions_historique|slice(5) %}
                                {{ historique_row(att) }}
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                {# Tableau récapitulatif #}
                <div class="card-footer bg-light py-2 px-3">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        {{ attributions_historique|length }} équipement(s) restitué(s) ou archivé(s)
                        sur un total de {{ attributions_actives|length + attributions_historique|length }} attribution(s).
                    </small>
                </div>
            {% endif %}
        </div>

    </div>{# fin col droite #}
</div>

{% endblock %}

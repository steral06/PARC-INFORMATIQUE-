<script>
    var currentEquipementId = {{ equipement.id }};
    var currentEquipementFamily = '{{ equipement_family }}';
    var personnelActiveDevices = {{ personnel_active_devices|json_encode|raw }};

    function toggleQuickReassignSelect(val) {
        var wrapper = document.getElementById('quickReassignSelectWrapper');
        if (wrapper) {
            wrapper.classList.toggle('d-none', val !== 'reassign');
        }
    }

    function populateQuickReassignOptions(currentPersonnelId) {
        var pSelect = document.getElementById('attr_personnel_id');
        var reassignSelect = document.getElementById('quickReassignPersonnelSelect');
        if (!pSelect || !reassignSelect) return;

        var currentSelected = reassignSelect.value;
        reassignSelect.innerHTML = '<option value="">-- Choisir un collaborateur --</option>';

        Array.from(pSelect.options).forEach(function(opt) {
            if (!opt.value || opt.value === String(currentPersonnelId)) return;
            var newOpt = document.createElement('option');
            newOpt.value = opt.value;
            newOpt.textContent = opt.textContent;
            if (newOpt.value === currentSelected) newOpt.selected = true;
            reassignSelect.appendChild(newOpt);
        });
    }

    function checkQuickConflict(personnelId) {
        var notice = document.getElementById('quickConflictNoticeBlock');
        var deviceSpan = document.getElementById('quickConflictDeviceName');
        if (!notice) return;

        // Seules les catégories individuelles (laptop, bureau, imprimante) sont restreintes — un collaborateur peut avoir 1 laptop + 1 bureau simultanément
        if (currentEquipementFamily !== 'laptop' && currentEquipementFamily !== 'desktop' && currentEquipementFamily !== 'printer') {
            notice.classList.add('d-none');
            return;
        }

        if (!personnelId || !personnelActiveDevices[personnelId]) {
            notice.classList.add('d-none');
            return;
        }

        var devices = personnelActiveDevices[personnelId] || [];
        var conflicting = devices.find(function(d) {
            return d.family === currentEquipementFamily && String(d.id) !== String(currentEquipementId);
        });

        if (conflicting) {
            notice.classList.remove('d-none');
            if (deviceSpan) {
                deviceSpan.textContent = conflicting.nom + ' (' + conflicting.catNom + ' — S/N: ' + conflicting.sn + ')';
            }
            populateQuickReassignOptions(personnelId);
        } else {
            notice.classList.add('d-none');
        }
    }

    function onQuickModalPersonnelChange(select) {
        var opt = select.selectedOptions ? select.selectedOptions[0] : null;
        var preview = document.getElementById('quickPersonnelCardPreview');
        var inputNom = document.getElementById('attr_beneficiaireNom');
        var inputService = document.getElementById('attr_beneficiaireService');

        if (!opt || !opt.value) {
            if (preview) preview.classList.add('d-none');
            checkQuickConflict(null);
            return;
        }

        var nom = opt.getAttribute('data-nom') || '';
        var service = opt.getAttribute('data-service') || '';
        var matricule = opt.getAttribute('data-matricule') || '';
        var type = opt.getAttribute('data-type') || 'Employé';
        var atts = opt.getAttribute('data-active-atts') || '0';

        if (inputNom) inputNom.value = nom;
        if (inputService) inputService.value = service;

        if (preview) {
            preview.classList.remove('d-none');
            document.getElementById('quickPreviewNom').textContent = nom;
            document.getElementById('quickPreviewMatricule').textContent = matricule;
            document.getElementById('quickPreviewService').textContent = service || 'Sans direction';
            document.getElementById('quickPreviewAttsCount').textContent = atts;

            var typeBadge = document.getElementById('quickPreviewTypeBadge');
            if (typeBadge) {
                typeBadge.className = 'badge rounded-pill px-2 py-0 ';
                if (type === 'Employé') {
                    typeBadge.className += 'bg-success-subtle text-success border border-success-subtle';
                    typeBadge.innerHTML = '👔 Employé';
                } else if (type === 'Prestataire') {
                    typeBadge.className += 'bg-primary-subtle text-primary border border-primary-subtle';
                    typeBadge.innerHTML = '💼 Prestataire';
                } else if (type === 'Stagiaire') {
                    typeBadge.className += 'bg-purple-subtle text-purple border';
                    typeBadge.style.color = '#9333ea';
                    typeBadge.innerHTML = '🎓 Stagiaire';
                } else if (type === 'Visiteur') {
                    typeBadge.className += 'bg-warning-subtle text-warning border border-warning-subtle';
                    typeBadge.innerHTML = '🏷️ Visiteur';
                } else {
                    typeBadge.className += 'bg-secondary-subtle text-secondary border';
                    typeBadge.innerHTML = type;
                }
            }
        }

        checkQuickConflict(opt.value);
    }
</script>


<script>
(function() {
    window.currentFicheData = null;

    window.copierCheminFiche = function(btn) {
        const text = document.getElementById('fiche-chemin-sauvegarde')?.textContent?.trim() || '';
        if (!text) return;
        navigator.clipboard.writeText(text).then(function() {
            if (btn) {
                const lbl = btn.querySelector('.copy-lbl');
                const orig = lbl ? lbl.textContent : '';
                if (lbl) lbl.textContent = 'Copié !';
                btn.className = 'btn btn-sm btn-success py-0 px-2';
                setTimeout(function() {
                    if (lbl) lbl.textContent = orig;
                    btn.className = 'btn btn-sm btn-outline-primary py-0 px-2';
                }, 1500);
            }
        });
    };

    window.ouvrirFichePoste = function(equipementId) {
        const modalEl = document.getElementById('modalFichePoste');
        if (!modalEl) return;

        const loading = document.getElementById('fiche-loading');
        const content = document.getElementById('fiche-content');

        if (loading) {
            loading.className = 'text-center py-5';
            loading.innerHTML = '<div class="spinner-border text-primary" role="status"></div><div class="text-body-secondary mt-2 small">Chargement de la fiche de sécurité...</div>';
            loading.classList.remove('d-none');
        }
        if (content) content.classList.add('d-none');

        // Afficher la modale
        if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
            bootstrap.Modal.getOrCreateInstance(modalEl).show();
        } else {
            modalEl.classList.add('show');
            modalEl.style.display = 'block';
        }

        // Appel AJAX pour charger la fiche via la route Symfony officielle
        const ficheUrl = "{{ path('app_sauvegarde_poste_fiche', {'id': 999999}) }}".replace('999999', equipementId);
        fetch(ficheUrl, {
            headers: {
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function(res) {
            if (!res.ok) {
                return res.text().then(function(t) {
                    throw new Error('Erreur serveur HTTP ' + res.status);
                });
            }
            return res.json();
        })
        .then(function(data) {
            if (!data.success) throw new Error('Impossible de charger la fiche.');
            window.currentFicheData = data;

            // En-tête
            document.getElementById('fiche-nom-machine').textContent = data.nom;
            document.getElementById('fiche-os-badge').textContent = data.os;
            const statBadge = document.getElementById('fiche-statut-badge');
            statBadge.textContent = data.statut;
            statBadge.className = 'badge border ' + (data.statut === 'En service' ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-body');

            // 1. Matériel & Réseau
            document.getElementById('fiche-ip').textContent = data.ip;
            document.getElementById('fiche-modele').textContent = data.marque + ' ' + data.modele;
            document.getElementById('fiche-inventaire').textContent = data.code_inventaire;
            document.getElementById('fiche-sn').textContent = data.numero_serie;
            document.getElementById('fiche-lieu').textContent = data.lieu;

            // 2. Bénéficiaire & Session
            const benef = data.beneficiaire;
            document.getElementById('fiche-beneficiaire').textContent = benef.nom;
            document.getElementById('fiche-service').textContent = benef.service;
            document.getElementById('fiche-avatar').textContent = (benef.nom || 'NA').substring(0, 2).toUpperCase();
            document.getElementById('fiche-att-statut').textContent = benef.statut_attribution;
            document.getElementById('fiche-session').textContent = data.session_windows;

            // 3. Sécurité & Protection
            const secBadge = document.getElementById('fiche-securite-badge');
            if (data.dernier_point || data.derniere_sauvegarde) {
                secBadge.className = 'badge bg-success text-white';
                secBadge.textContent = 'Sécurisé';
            } else {
                secBadge.className = 'badge bg-danger text-white';
                secBadge.textContent = 'Non protégé';
            }

            const dpDate = document.getElementById('fiche-dernier-point-date');
            if (data.dernier_point) {
                dpDate.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i>' + data.dernier_point.date + '</span> (' + data.dernier_point.taille + ')';
            } else {
                dpDate.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle me-1"></i>Aucun point créé</span>';
            }

            const dsDate = document.getElementById('fiche-derniere-sauv-date');
            if (data.derniere_sauvegarde) {
                dsDate.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i>' + data.derniere_sauvegarde.date + '</span> (' + data.derniere_sauvegarde.taille + ')';
            } else {
                dsDate.innerHTML = '<span class="text-warning-emphasis"><i class="bi bi-exclamation-triangle me-1"></i>Jamais sauvegardé</span>';
            }

            // Emplacement physique
            document.getElementById('fiche-chemin-sauvegarde').textContent = data.chemin_sauvegarde;

            // Historique spécifique au poste
            const tbody = document.getElementById('fiche-historique-tbody');
            tbody.innerHTML = '';
            document.getElementById('fiche-nb-historique').textContent = (data.historique ? data.historique.length : 0) + ' opération(s)';

            if (data.historique && data.historique.length > 0) {
                data.historique.forEach(function(h) {
                    const tr = document.createElement('tr');
                    const opBadge = h.is_point 
                        ? '<span class="badge bg-primary-subtle text-primary border">⚡ Point Restauration</span>'
                        : '<span class="badge bg-success-subtle text-success border">💾 Sauvegarde Profil</span>';
                    tr.innerHTML = '<td class="font-monospace text-muted">' + h.date + '</td>' +
                        '<td>' + opBadge + '</td>' +
                        '<td><span class="badge bg-success text-white">Succès</span></td>' +
                        '<td class="text-muted text-truncate" style="max-width: 280px;" title="' + (h.details || '') + '">' + ((h.details || '').split('\n')[0]) + '</td>' +
                        '<td><span class="badge bg-light text-dark border">' + (h.lance_par || 'admin') + '</span></td>';
                    tbody.appendChild(tr);
                });
            } else {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted">Aucune intervention enregistrée pour ce poste.</td></tr>';
            }

            // Liens & Boutons
            const btnShow = document.getElementById('fiche-btn-equipement-show');
            if (btnShow) btnShow.href = data.url_fiche_complete;

            // Boutons d'action rapide vers la modale d'autorisation
            const btnPoint = document.getElementById('fiche-btn-lancer-point');
            const btnProfil = document.getElementById('fiche-btn-lancer-profil');

            if (btnPoint) {
                btnPoint.onclick = function() {
                    bootstrap.Modal.getInstance(modalEl)?.hide();
                    setTimeout(function() {
                        window.ouvrirModalAutorisation('POINT_RESTAURATION', data.id, data.nom, data.beneficiaire.nom, data.code_inventaire, data.session_windows, data.chemin_sauvegarde);
                    }, 350);
                };
            }

            if (btnProfil) {
                btnProfil.onclick = function() {
                    bootstrap.Modal.getInstance(modalEl)?.hide();
                    setTimeout(function() {
                        window.ouvrirModalAutorisation('SAUVEGARDE_PROFIL', data.id, data.nom, data.beneficiaire.nom, data.code_inventaire, data.session_windows, data.chemin_sauvegarde);
                    }, 350);
                };
            }

            if (loading) loading.classList.add('d-none');
            if (content) content.classList.remove('d-none');
        })
        .catch(function(err) {
            if (loading) loading.innerHTML = '<div class="alert alert-danger p-2 small"><i class="bi bi-exclamation-triangle me-1"></i>Erreur lors du chargement : ' + err.message + '</div>';
        });
    };

    window.currentBackupAction = '';
    window.currentBackupEquipementId = 0;
    window.currentBackupMachineName = '';
    window.currentBackupBeneficiaire = '';
    window.isMachineEnLigne = false;
    window.isForceEnvoi = false;

    window.toggleForce = function(checked) {
        window.isForceEnvoi = !!checked;
        const pinInput = document.getElementById('auth-admin-pin');
        const btnConfirmer = document.getElementById('btn-confirmer-action');

        if (window.isForceEnvoi) {
            if (pinInput) pinInput.disabled = false;
            if (btnConfirmer) btnConfirmer.disabled = false;
            if (pinInput) pinInput.focus();
        } else if (!window.isMachineEnLigne) {
            if (pinInput) pinInput.disabled = true;
            if (btnConfirmer) btnConfirmer.disabled = true;
        }
    };

    window.lancerTestPingModal = function() {
        const pingBox = document.getElementById('auth-ping-box');
        const pingContent = document.getElementById('auth-ping-content');
        const pinInput = document.getElementById('auth-admin-pin');
        const btnConfirmer = document.getElementById('btn-confirmer-action');
        const forceCheck = document.getElementById('auth-force-check');

        if (!pingContent || !pingBox) return;

        window.isMachineEnLigne = false;
        window.isForceEnvoi = false;
        if (pinInput) {
            pinInput.disabled = true;
            pinInput.value = '';
        }
        if (btnConfirmer) btnConfirmer.disabled = true;
        if (forceCheck) forceCheck.checked = false;

        pingBox.className = 'p-3 mb-3 rounded-3 border bg-light';
        pingContent.innerHTML = '<div class="d-flex align-items-center gap-2 small text-muted">' +
            '<div class="spinner-border spinner-border-sm text-primary" role="status"></div>' +
            '<span>Envoi d\'un Ping ICMP et vérification de la réactivité de la machine...</span>' +
            '</div>';

        fetch("{{ path('app_sauvegarde_poste_verifier') }}", {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify({ equipement_id: window.currentBackupEquipementId })
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.en_ligne) {
                window.isMachineEnLigne = true;
                pingBox.className = 'p-3 mb-3 rounded-3 border border-success bg-success-subtle text-success';
                pingContent.innerHTML = '<div class="d-flex align-items-center gap-2 fw-semibold">' +
                    '<i class="bi bi-check-circle-fill fs-5"></i>' +
                    '<div>Machine en ligne et réactive (Ping : ' + (data.temps_ms || '< 5ms') + ')</div>' +
                    '</div>' +
                    '<div class="small text-muted mt-1">' + (data.details || 'La machine est allumée et prête.') + ' Vous pouvez confirmer l\'autorisation ci-dessous.</div>';

                if (pinInput) {
                    pinInput.disabled = false;
                    setTimeout(function() { pinInput.focus(); }, 150);
                }
                if (btnConfirmer) btnConfirmer.disabled = false;
            } else {
                window.isMachineEnLigne = false;
                pingBox.className = 'p-3 mb-3 rounded-3 border border-danger bg-danger-subtle text-danger';
                pingContent.innerHTML = '<div class="d-flex align-items-center gap-2 fw-semibold">' +
                    '<i class="bi bi-x-circle-fill fs-5"></i>' +
                    '<div>Machine injoignable (Aucune réponse au Ping)</div>' +
                    '</div>' +
                    '<div class="small text-dark mt-1">' + (data.details || 'Le poste semble éteint ou hors du réseau.') + '</div>' +
                    '<div class="small text-muted mt-1">Impossible de configurer une machine hors-ligne. Allumez le poste cible puis cliquez sur <strong>Re-tester</strong>.</div>';

                if (pinInput) pinInput.disabled = true;
                if (btnConfirmer) btnConfirmer.disabled = true;
            }
        })
        .catch(function(err) {
            window.isMachineEnLigne = false;
            pingBox.className = 'p-3 mb-3 rounded-3 border border-danger bg-danger-subtle text-danger';
            pingContent.innerHTML = '<div class="d-flex align-items-center gap-2 fw-semibold text-danger">' +
                '<i class="bi bi-exclamation-triangle-fill fs-5"></i>' +
                '<div>Erreur lors du test de joignabilité : ' + err.message + '</div>' +
                '</div>';
        });
    };

    window.testerPingLigne = function(equipementId, btn) {
        if (!btn) return;
        const origContent = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm text-primary" role="status"></span>';
        btn.disabled = true;

        fetch("{{ path('app_sauvegarde_poste_verifier') }}", {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify({ equipement_id: equipementId })
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            btn.disabled = false;
            if (data.en_ligne) {
                btn.className = 'btn btn-outline-success btn-sm py-0 px-1 border-0 fw-semibold';
                btn.innerHTML = '<span class="badge bg-success-subtle text-success border">🟢 En ligne (' + (data.temps_ms || '<5ms') + ')</span>';
            } else {
                btn.className = 'btn btn-outline-danger btn-sm py-0 px-1 border-0 fw-semibold';
                btn.innerHTML = '<span class="badge bg-danger-subtle text-danger border">🔴 Hors ligne</span>';
            }
        })
        .catch(function() {
            btn.disabled = false;
            btn.innerHTML = origContent;
        });
    };

    window.preparerModalAutorisation = function(action, equipementId, machineName, beneficiaireName, codeInventaire, sessionSuggeree, previewPath) {
        window.currentBackupAction = action;
        window.currentBackupEquipementId = equipementId;
        window.currentBackupMachineName = machineName;
        window.currentBackupBeneficiaire = beneficiaireName;

        const formSection = document.getElementById('auth-form-section');
        const stepsSection = document.getElementById('auth-steps-section');
        const pinInput = document.getElementById('auth-admin-pin');
        const btnConfirmer = document.getElementById('btn-confirmer-action');
        const forceCheck = document.getElementById('auth-force-check');
        const machineLabel = document.getElementById('auth-modal-machine-name');
        const beneficiaireLabel = document.getElementById('auth-modal-beneficiaire-name');
        const codeInventaireLabel = document.getElementById('auth-modal-code-inventaire');
        const sessionLabel = document.getElementById('auth-modal-session-name');
        const destPathLabel = document.getElementById('auth-modal-dest-path');
        const destBox = document.getElementById('auth-dest-preview-box');
        const actionLabel = document.getElementById('auth-modal-action-label');
        const resultBox = document.getElementById('auth-result-box');
        const footer = document.getElementById('auth-modal-footer');

        if (formSection) formSection.classList.remove('d-none');
        if (stepsSection) stepsSection.classList.add('d-none');
        if (footer) footer.classList.remove('d-none');
        if (resultBox) {
            resultBox.classList.add('d-none');
            resultBox.innerHTML = '';
        }
        if (pinInput) {
            pinInput.value = '';
            pinInput.disabled = true;
        }
        if (btnConfirmer) btnConfirmer.disabled = true;
        if (forceCheck) forceCheck.checked = false;

        if (machineLabel) {
            machineLabel.textContent = machineName || 'Poste du réseau';
        }

        if (beneficiaireLabel) {
            beneficiaireLabel.textContent = beneficiaireName || 'Non attribué';
        }

        if (codeInventaireLabel) {
            codeInventaireLabel.textContent = codeInventaire || 'GTA-INVENTAIRE';
        }

        const safeSession = sessionSuggeree || 'default.user';
        if (sessionLabel) {
            sessionLabel.textContent = safeSession;
        }

        if (destPathLabel) {
            if (previewPath) {
                destPathLabel.textContent = previewPath;
            } else {
                const safeBenef = (beneficiaireName || 'Non_Attribue').replace(/[^a-zA-Z0-9_\-]/g, '_');
                const safeInv = (codeInventaire || 'GTA-INVENTAIRE').replace(/[^a-zA-Z0-9_\-]/g, '_');
                destPathLabel.textContent = 'C:\\GPARC_Sauvegardes\\' + safeBenef + '\\' + safeInv + '\\' + safeSession + '\\';
            }
        }

        if (destBox) {
            if (action === 'POINT_RESTAURATION') {
                destBox.classList.add('d-none');
            } else {
                destBox.classList.remove('d-none');
            }
        }

        if (actionLabel) {
            if (action === 'POINT_RESTAURATION') {
                actionLabel.textContent = '⚡ Créer un Point de Restauration Système Windows (Checkpoint-Computer)';
                actionLabel.className = 'p-2 rounded bg-body-secondary border fw-semibold text-primary';
            } else if (action === 'SAUVEGARDE_PROFIL') {
                actionLabel.textContent = '💾 Sauvegarde Incrémentielle Complète (Documents, Bureau, Musique, Vidéos, Images, Téléchargements)';
                actionLabel.className = 'p-2 rounded bg-body-secondary border fw-semibold text-success';
            } else {
                actionLabel.textContent = '⚡ Campagne Globale de Points de Restauration sur TOUS les PC du domaine';
                actionLabel.className = 'p-2 rounded bg-body-secondary border fw-semibold text-warning';
            }
        }

        // Lancer immédiatement le test de Ping en Étape 1 préalable !
        window.lancerTestPingModal();
    };

    window.ouvrirModalAutorisation = function(action, equipementId, machineName, beneficiaireName, codeInventaire, sessionSuggeree, previewPath) {
        window.preparerModalAutorisation(action, equipementId, machineName, beneficiaireName, codeInventaire, sessionSuggeree, previewPath);

        const modalEl = document.getElementById('modalAutorisationBackup');
        if (!modalEl) {
            alert('Modale introuvable dans le DOM.');
            return;
        }

        if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
            try {
                const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                bsModal.show();
                return;
            } catch(e) {
                console.warn('Bootstrap Modal instance error, activation du fallback direct :', e);
            }
        }

        modalEl.classList.add('show');
        modalEl.style.display = 'block';
        modalEl.removeAttribute('aria-hidden');
        modalEl.setAttribute('aria-modal', 'true');
        document.body.classList.add('modal-open');

        let backdrop = document.getElementById('modal-backup-backdrop');
        if (!backdrop) {
            backdrop = document.createElement('div');
            backdrop.id = 'modal-backup-backdrop';
            backdrop.className = 'modal-backdrop fade show';
            backdrop.onclick = window.fermerModalAutorisation;
            document.body.appendChild(backdrop);
        }
    };

    window.fermerModalAutorisation = function() {
        const modalEl = document.getElementById('modalAutorisationBackup');
        if (modalEl) {
            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                try {
                    const bsModal = bootstrap.Modal.getInstance(modalEl);
                    if (bsModal) bsModal.hide();
                } catch(e) {}
            }
            modalEl.classList.remove('show');
            modalEl.style.display = 'none';
            modalEl.setAttribute('aria-hidden', 'true');
            modalEl.removeAttribute('aria-modal');
        }
        document.body.classList.remove('modal-open');
        const backdrop = document.getElementById('modal-backup-backdrop');
        if (backdrop) backdrop.remove();
        document.querySelectorAll('.modal-backdrop').forEach(function(el) {
            el.remove();
        });
    };

    window.executerActionSecurisee = function() {
        const action = window.currentBackupAction;
        const equipementId = window.currentBackupEquipementId;
        const pinInput = document.getElementById('auth-admin-pin');
        const pinValue = pinInput ? pinInput.value.trim() : '';
        const isForced = !!window.isForceEnvoi;

        const formSection = document.getElementById('auth-form-section');
        const stepsSection = document.getElementById('auth-steps-section');
        const resultBox = document.getElementById('auth-result-box');
        const footer = document.getElementById('auth-modal-footer');

        if (!pinValue) {
            if (resultBox) {
                resultBox.className = 'alert alert-warning d-flex align-items-center gap-2 mt-3';
                resultBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill fs-5"></i><div>Veuillez saisir votre Code PIN Administrateur pour signer l\'autorisation.</div>';
                resultBox.classList.remove('d-none');
            }
            if (pinInput) pinInput.focus();
            return;
        }

        // Basculement vers l'affichage des étapes
        if (formSection) formSection.classList.add('d-none');
        if (stepsSection) stepsSection.classList.remove('d-none');
        if (footer) footer.classList.add('d-none');
        if (resultBox) resultBox.classList.add('d-none');

        // Réinitialiser les indicateurs d'étapes
        const s1Icon = document.getElementById('step1-icon');
        const s1Title = document.getElementById('step1-title');
        const s1Desc = document.getElementById('step1-desc');
        const s2Row = document.getElementById('step2-row');
        const s2Icon = document.getElementById('step2-icon');
        const s2Title = document.getElementById('step2-title');
        const s2Desc = document.getElementById('step2-desc');
        const s3Row = document.getElementById('step3-row');
        const s3Icon = document.getElementById('step3-icon');

        if (s1Icon) s1Icon.innerHTML = '<div class="spinner-border spinner-border-sm" role="status"></div>';
        if (s1Title) s1Title.textContent = 'Étape 1 : Vérification de l\'autorisation administrateur...';

        // Étape 1 : Demande et validation du token d'autorisation avec le Code PIN
        fetch("{{ path('app_sauvegarde_poste_token') }}", {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify({ action: action, pin: pinValue })
        })
        .then(function(res) {
            return res.json().then(function(data) {
                if (!res.ok || !data.success) {
                    throw new Error(data.message || 'Autorisation refusée.');
                }
                return data;
            });
        })
        .then(function(tokenData) {
            const token = tokenData.token;

            // Étape 1 Validée !
            if (s1Icon) {
                s1Icon.className = 'rounded-circle p-2 bg-success-subtle text-success d-flex align-items-center justify-content-center flex-shrink-0';
                s1Icon.innerHTML = '<i class="bi bi-check-lg fw-bold"></i>';
            }
            if (s1Title) s1Title.innerHTML = '<strong>Étape 1 : Autorisation accordée</strong> (' + (tokenData.admin || 'Admin') + ')';
            if (s1Desc) s1Desc.textContent = 'Token de session à usage unique généré avec succès.';

            // Étape 2 Activée : Contact réseau du PC
            if (s2Row) s2Row.classList.remove('opacity-50');
            if (s2Icon) {
                s2Icon.className = 'rounded-circle p-2 bg-primary-subtle text-primary d-flex align-items-center justify-content-center flex-shrink-0';
                s2Icon.innerHTML = '<div class="spinner-border spinner-border-sm" role="status"></div>';
            }
            if (s2Title) s2Title.textContent = 'Étape 2 : Contact et liaison réseau avec la machine cible...';

            let targetUrl = '';
            let bodyPayload = {};

            if (action === 'POINT_RESTAURATION') {
                targetUrl = "{{ path('app_sauvegarde_poste_point') }}";
                bodyPayload = { equipement_id: equipementId, token: token, force: isForced };
            } else if (action === 'SAUVEGARDE_PROFIL') {
                targetUrl = "{{ path('app_sauvegarde_poste_profil') }}";
                bodyPayload = { equipement_id: equipementId, token: token, force: isForced };
            } else {
                targetUrl = "{{ path('app_sauvegarde_poste_campagne') }}";
                bodyPayload = { token: token };
            }

            // Exécution vers la machine distante SEULEMENT après confirmation de l'autorisation
            return fetch(targetUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                },
                body: JSON.stringify(bodyPayload)
            });
        })
        .then(function(res) {
            return res.json().then(function(data) {
                if (!res.ok || !data.success) {
                    throw new Error(data.message || 'Échec lors de l\'exécution réseau.');
                }
                return data;
            });
        })
        .then(function(resultData) {
            // Étape 2 Validée : PC Cible atteint !
            if (s2Icon) {
                s2Icon.className = 'rounded-circle p-2 bg-success-subtle text-success d-flex align-items-center justify-content-center flex-shrink-0';
                s2Icon.innerHTML = '<i class="bi bi-check-lg fw-bold"></i>';
            }
            if (s2Title) s2Title.innerHTML = '<strong>Étape 2 : Machine cible atteinte sur le réseau</strong>';
            if (s2Desc) s2Desc.textContent = resultData.details_reseau || 'PC en ligne et réactif.';

            // Étape 3 Validée : Opération confirmée
            if (s3Row) s3Row.classList.remove('opacity-50');
            if (s3Icon) {
                s3Icon.className = 'rounded-circle p-2 bg-success-subtle text-success d-flex align-items-center justify-content-center flex-shrink-0';
                s3Icon.innerHTML = '<i class="bi bi-check-all fs-5 fw-bold"></i>';
            }
            const s3Title = document.getElementById('step3-title');
            const s3Desc = document.getElementById('step3-desc');
            if (s3Title) s3Title.innerHTML = '<strong>Étape 3 : Opération exécutée et enregistrée</strong>';
            if (s3Desc) s3Desc.textContent = 'Sauvegarde validée dans le journal G-PARC.';

            // Résultat de succès final
            if (resultBox) {
                resultBox.classList.remove('d-none');
                resultBox.className = 'alert alert-success d-flex align-items-center gap-2 mt-3';
                resultBox.innerHTML = '<i class="bi bi-check-circle-fill fs-4 flex-shrink-0"></i><div>' + resultData.message + '</div>';
                setTimeout(function() {
                    window.location.reload();
                }, 2200);
            }
        })
        .catch(function(err) {
            // En cas d'erreur (ex: code PIN faux ou machine injoignable)
            if (formSection) formSection.classList.remove('d-none');
            if (stepsSection) stepsSection.classList.add('d-none');
            if (footer) footer.classList.remove('d-none');

            if (resultBox) {
                resultBox.classList.remove('d-none');
                resultBox.className = 'alert alert-danger d-flex align-items-center gap-2 mt-3';
                resultBox.innerHTML = '<i class="bi bi-x-circle-fill fs-5 flex-shrink-0"></i><div>' + err.message + '</div>';
            }

            if (pinInput) {
                pinInput.value = '';
                pinInput.focus();
            }
        });
    };

    // Synchronisation Bootstrap data-bs-toggle
    function initModalDelegation() {
        const modalEl = document.getElementById('modalAutorisationBackup');
        if (!modalEl) return;
        modalEl.addEventListener('show.bs.modal', function(event) {
            const btn = event.relatedTarget;
            if (btn && btn.getAttribute('data-action')) {
                window.preparerModalAutorisation(
                    btn.getAttribute('data-action'),
                    parseInt(btn.getAttribute('data-equipement-id') || '0', 10),
                    btn.getAttribute('data-machine-name') || '',
                    btn.getAttribute('data-beneficiaire') || '',
                    btn.getAttribute('data-code-inventaire') || '',
                    btn.getAttribute('data-session') || '',
                    btn.getAttribute('data-preview-path') || ''
                );
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initModalDelegation);
    } else {
        initModalDelegation();
    }
    document.addEventListener('turbo:load', initModalDelegation);
})();
</script>
{% endblock %}


{% extends 'base.html.twig' %}

{% block title %}Rapport d'Écarts — {{ campagne.titre }} | GTAC2A-IARDT{% endblock %}

{% block body %}
<div class="mb-3 flex-shrink-0">
    <a href="{{ path('app_inventaire_show', {'id': campagne.id}) }}" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 mb-2">
        <i class="bi bi-arrow-left"></i>
        <span>Retour au pointage de la campagne</span>
    </a>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="h3 fw-bold mb-1" style="color: #121212;">
                    <i class="bi bi-exclamation-triangle text-warning me-2"></i>Rapport d'Écarts d'Inventaire
                </h1>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold">
                    {{ ecarts|length }} anomalie(s)
                </span>
            </div>
            <p class="text-muted small mb-0">
                Campagne : <strong>{{ campagne.titre }}</strong> &bull; Année {{ campagne.annee }}
            </p>
        </div>

        <div class="d-flex gap-2">
            <button type="button"
                    class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 shadow-sm opacity-50"
                    disabled
                    title="Téléchargement du PV PDF bientôt disponible (version ultérieure)"
                    style="cursor: not-allowed;">
                <i class="bi bi-file-earmark-pdf text-secondary"></i>
                <span>PV PDF</span>
                <span class="badge bg-secondary-subtle text-secondary border ms-1" style="font-size: 0.65rem;">Bientôt</span>
            </button>
            <a href="{{ path('app_inventaire_show', {'id': campagne.id}) }}" class="btn btn-dark btn-sm d-inline-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-list-check"></i>
                <span>Toutes les lignes</span>
            </a>
        </div>
    </div>
</div>

{# Synthèse par type d'écart #}
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm p-3" style="background: rgba(228, 112, 0, 0.08); border-left: 4px solid var(--gta-orange) !important;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="small text-muted fw-semibold">Machines Déplacées</div>
                    <div class="fs-4 fw-bold" style="color: var(--gta-orange);">{{ campagne.deplacesCount }}</div>
                    <div class="text-muted small" style="font-size: .72rem;">Retrouvées dans un autre bureau</div>
                </div>
                <i class="bi bi-arrows-move fs-2" style="color: var(--gta-orange); opacity: .5;"></i>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm p-3" style="background: rgba(239, 68, 68, 0.08); border-left: 4px solid #dc2626 !important;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="small text-muted fw-semibold">Machines Manquantes</div>
                    <div class="fs-4 fw-bold text-danger">{{ campagne.manquantsCount }}</div>
                    <div class="text-muted small" style="font-size: .72rem;">Introuvables lors du recensement</div>
                </div>
                <i class="bi bi-x-octagon fs-2 text-danger" style="opacity: .5;"></i>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm p-3" style="background: rgba(108, 117, 125, 0.08); border-left: 4px solid #6c757d !important;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="small text-muted fw-semibold">Machines Hors Service</div>
                    <div class="fs-4 fw-bold text-secondary">{{ campagne.horsServiceCount }}</div>
                    <div class="text-muted small" style="font-size: .72rem;">Trouvées en panne non signalée</div>
                </div>
                <i class="bi bi-tools fs-2 text-secondary" style="opacity: .5;"></i>
            </div>
        </div>
    </div>
</div>

{# Tableau détaillé des écarts #}
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <span class="fw-bold small text-dark">
            <i class="bi bi-exclamation-diamond me-1 text-danger"></i> Détail des anomalies constatées ({{ ecarts|length }})
        </span>
    </div>

    {% if ecarts is empty %}
        <div class="card-body text-center py-5">
            <div class="mb-2 text-success fs-1"><i class="bi bi-check-circle-fill"></i></div>
            <h5 class="fw-bold text-dark mb-1">Aucun écart constaté !</h5>
            <p class="text-muted small mb-0">Tous les équipements contrôlés sont conformes à leur localisation et statut théoriques.</p>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: .85rem;">
                <thead class="table-light small">
                    <tr>
                        <th>Équipement</th>
                        <th>Numéro de Série</th>
                        <th>Type d'Écart</th>
                        <th>Lieu Attendu</th>
                        <th>Lieu Constaté</th>
                        <th>Observations / Justification</th>
                        <th>Pointé par</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for l in ecarts %}
                        {% set eq = l.equipement %}
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">
                                    <a href="{{ path('app_equipement_show', {'id': eq.id}) }}" class="text-decoration-none text-dark" target="_blank">
                                        {{ eq.nom }}
                                    </a>
                                </div>
                                <div class="text-muted" style="font-size: .72rem;">{{ eq.marque }} {{ eq.modele }}</div>
                            </td>
                            <td>
                                <span class="font-monospace fw-semibold">{{ eq.numeroSerie }}</span>
                                {% if eq.tagInventaire %}
                                    <div class="text-muted font-monospace" style="font-size: .7rem;">{{ eq.tagInventaire }}</div>
                                {% endif %}
                            </td>
                            <td>
                                {% if l.statutConstate == 'Déplacé' %}
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle fw-bold">
                                        <i class="bi bi-arrows-move me-1"></i>Déplacé
                                    </span>
                                {% elseif l.statutConstate == 'Manquant' %}
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold">
                                        <i class="bi bi-x-octagon me-1"></i>Manquant
                                    </span>
                                {% elseif l.statutConstate == 'Hors service' %}
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle fw-bold">
                                        <i class="bi bi-tools me-1"></i>Hors service
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-dark border">{{ l.lieuAttendu ?? '—' }}</span>
                            </td>
                            <td>
                                {% if l.lieuConstate %}
                                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle fw-bold">
                                        {{ l.lieuConstate.nomLieu }}
                                    </span>
                                {% else %}
                                    <span class="text-muted small fst-italic">—</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if l.observations %}
                                    <span class="small">{{ l.observations }}</span>
                                {% else %}
                                    <span class="text-muted small fst-italic">Aucune observation</span>
                                {% endif %}
                            </td>
                            <td class="small">
                                <div>{{ l.pointePar ?? 'DSI' }}</div>
                                <div class="text-muted" style="font-size: .7rem;">{{ l.datePointage ? l.datePointage|date('d/m/Y') : '—' }}</div>
                            </td>
                            <td class="text-end">
                                <a href="{{ path('app_equipement_show', {'id': eq.id}) }}" class="btn btn-outline-dark btn-sm py-0 px-2" style="font-size: .75rem;" target="_blank">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>Fiche
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}


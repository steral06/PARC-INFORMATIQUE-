{% extends 'base.html.twig' %}

{% block title %}Sauvegardes | GTAC2A-IARDT{% endblock %}

{% block stylesheets %}
<style>
    /* Empêcher le défilement de toute la page : seule la liste des sauvegardes défile */
    .app-content {
        overflow-y: hidden !important;
        display: flex;
        flex-direction: column;
    }
    #backupAccordion {
        max-height: calc(100vh - 350px);
        overflow-y: auto;
    }

    /* ── Accordéon Sauvegardes ── */
    .backup-item {
        border: 1px solid var(--bs-border-color, #e5e7eb);
        border-radius: 0.75rem;
        overflow: hidden;
        transition: box-shadow 0.2s ease, border-color 0.2s ease;
        background: var(--bs-body-bg, #fff);
    }
    .backup-item:hover {
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.07);
        border-color: rgba(228, 112, 0, 0.35);
    }
    .backup-item.open {
        box-shadow: 0 6px 24px rgba(228, 112, 0, 0.12);
        border-color: rgba(228, 112, 0, 0.5);
    }

    /* En-tête cliquable */
    .backup-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.85rem 1.1rem;
        cursor: pointer;
        user-select: none;
        background: transparent;
        border: none;
        width: 100%;
        text-align: left;
    }
    .backup-header:focus-visible {
        outline: 2px solid var(--gta-orange);
        outline-offset: -2px;
    }

    /* Icône de fichier avec couleur */
    .backup-file-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
        background: rgba(228, 112, 0, 0.1);
        color: var(--gta-orange);
    }
    .backup-item:first-child .backup-file-icon { background: rgba(37, 99, 235, 0.1); color: #2563eb; }

    /* Méta-infos sur la ligne */
    .backup-meta {
        flex: 1;
        min-width: 0;
    }
    .backup-filename {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--bs-body-color);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .backup-date-inline {
        font-size: 0.75rem;
        color: var(--bs-secondary-color, #6b7280);
        margin-top: 0.1rem;
    }

    /* Badges latéraux */
    .backup-side {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 0;
    }

    /* Chevron animé */
    .backup-chevron {
        font-size: 0.9rem;
        color: var(--bs-secondary-color, #9ca3af);
        transition: transform 0.25s ease;
        flex-shrink: 0;
    }
    .backup-item.open .backup-chevron {
        transform: rotate(180deg);
        color: var(--gta-orange);
    }

    /* Corps déroulant */
    .backup-body {
        padding: 0 1.1rem 1rem;
        border-top: 1px solid var(--bs-border-color, #f0f0f0);
    }

    /* Grille de détails */
    .backup-detail-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 0.6rem;
        padding: 0.75rem 0;
    }
    .backup-detail-item {
        background: var(--bs-tertiary-bg, #f8fafc);
        border: 1px solid var(--bs-border-color, #e5e7eb);
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
    }
    .backup-detail-label {
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        color: var(--bs-secondary-color, #9ca3af);
        margin-bottom: 0.2rem;
    }
    .backup-detail-value {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--bs-body-color);
        font-family: ui-monospace, Consolas, monospace;
    }

    /* Barre d'actions */
    .backup-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        padding-top: 0.5rem;
    }

    /* Badge "Dernière" */
    .badge-latest {
        font-size: 0.68rem;
        padding: 0.2rem 0.55rem;
        border-radius: 20px;
        background: rgba(37, 99, 235, 0.1);
        color: #2563eb;
        border: 1px solid rgba(37, 99, 235, 0.25);
        font-weight: 600;
    }

    /* Mode Sombre */
    [data-bs-theme="dark"] .backup-item {
        background: #161922;
        border-color: rgba(255, 255, 255, 0.08);
    }
    [data-bs-theme="dark"] .backup-item:hover {
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
        border-color: rgba(228, 112, 0, 0.4);
    }
    [data-bs-theme="dark"] .backup-item.open {
        box-shadow: 0 6px 24px rgba(228, 112, 0, 0.15);
    }
    [data-bs-theme="dark"] .backup-filename { color: #e2e8f0; }
    [data-bs-theme="dark"] .backup-body {
        border-top-color: rgba(255, 255, 255, 0.07);
    }
    [data-bs-theme="dark"] .backup-detail-item {
        background: #1b1f2a;
        border-color: rgba(255, 255, 255, 0.08);
    }
    [data-bs-theme="dark"] .backup-detail-value { color: #e2e8f0; }
    [data-bs-theme="dark"] .badge-latest {
        background: rgba(96, 165, 250, 0.12);
        color: #93c5fd;
        border-color: rgba(96, 165, 250, 0.25);
    }
    [data-bs-theme="dark"] .backup-item:first-child .backup-file-icon {
        background: rgba(96, 165, 250, 0.12);
        color: #93c5fd;
    }
</style>
{% endblock %}

{% block body %}
<div class="d-flex flex-column flex-grow-1" style="min-height: 0;">
{# ── En-tête ── #}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 gap-2 flex-shrink-0">
    <div>
        <h1 class="h3 fw-bold mb-1" style="color: #121212;">Sauvegardes</h1>
        <p class="text-muted mb-0 small">Sauvegarde et restauration de la base de données</p>
    </div>
    <div class="d-flex gap-2">
        <form method="post" action="{{ path('app_backup_create') }}" onsubmit="const b=this.querySelector('button[type=submit]'); b.disabled=true; b.innerHTML='<span class=\'spinner-border spinner-border-sm me-1\'></span> Création en cours...';">
            <input type="hidden" name="_token" value="{{ csrf_token('backup_create') }}">
            <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm fw-bold">
                <i class="bi bi-shield-plus fs-5"></i>
                <span>Créer une Sauvegarde</span>
            </button>
        </form>
    </div>
</div>

{# ── Métriques ── #}
<div class="row g-3 mb-3 flex-shrink-0">
    <div class="col-12 col-sm-6 col-xl-4">
        <div class="card stat-card h-100 shadow-sm border-0">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Taille Base de Données</span>
                    <div class="fs-4 fw-bold mt-1" style="color: var(--gta-orange);">{{ db_size }}</div>
                </div>
                <div class="stat-icon" style="background: rgba(228, 112, 0, 0.12); color: var(--gta-orange);">
                    <i class="bi bi-database"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-4">
        <div class="card stat-card h-100 shadow-sm border-0" style="border-left-color: #16a34a !important;">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Archives Disponibles</span>
                    <div class="fs-4 fw-bold mt-1 text-success">{{ backups|length }}</div>
                </div>
                <div class="stat-icon bg-success-subtle text-success">
                    <i class="bi bi-archive-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-4">
        <div class="card stat-card h-100 shadow-sm border-0" style="border-left-color: #2563eb !important;">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Dernière Sauvegarde</span>
                    <div class="fs-5 fw-bold mt-1 text-primary">
                        {{ backups|length > 0 ? backups[0].date : 'Aucune' }}
                    </div>
                </div>
                <div class="stat-icon bg-primary-subtle text-primary">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
        </div>
    </div>
</div>

{# ── Liste Accordéon des Archives ── #}
<div class="card shadow-sm border flex-grow-1 d-flex flex-column" style="min-height: 0;">
    <div class="card-header py-3 border-bottom d-flex align-items-center justify-content-between flex-shrink-0">
        <h6 class="fw-bold mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-hdd-stack text-primary"></i>
            <span>Archives et Fichiers de Sauvegarde</span>
            <span class="badge bg-secondary-subtle text-dark border">{{ backups|length }}</span>
        </h6>
        {% if backups|length > 1 %}
        <button type="button" class="btn btn-sm btn-outline-secondary" id="toggleAllBtn" onclick="toggleAllBackups()">
            <i class="bi bi-chevron-expand me-1"></i>Tout déplier
        </button>
        {% endif %}
    </div>

    <div class="p-3 flex-grow-1" id="backupAccordion" style="overflow-y: auto; min-height: 0;">
        {% if backups|length == 0 %}
            {# État vide #}
            <div class="text-center py-5">
                <div class="mb-3" style="font-size: 3rem; opacity: 0.25;">
                    <i class="bi bi-archive"></i>
                </div>
                <p class="fw-semibold mb-1">Aucune sauvegarde disponible</p>
                <p class="text-muted small mb-3">Créez votre première archive pour sécuriser vos données.</p>
                <form method="post" action="{{ path('app_backup_create') }}" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('backup_create') }}">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-lg me-1"></i>Créer la première sauvegarde
                    </button>
                </form>
            </div>
        {% else %}
            <div class="d-flex flex-column gap-2">
                {% for b in backups %}
                <div class="backup-item{% if loop.first %} open{% endif %}" id="backupItem_{{ loop.index }}">

                    {# ── Ligne cliquable ── #}
                    <button class="backup-header"
                            onclick="toggleBackup({{ loop.index }})"
                            aria-expanded="{{ loop.first ? 'true' : 'false' }}"
                            aria-controls="backupBody_{{ loop.index }}">

                        {# Icône #}
                        <div class="backup-file-icon">
                            <i class="bi bi-file-earmark-zip-fill"></i>
                        </div>

                        {# Nom + date #}
                        <div class="backup-meta">
                            <div class="backup-filename" title="{{ b.filename }}">{{ b.filename }}</div>
                            <div class="backup-date-inline">
                                <i class="bi bi-calendar3 me-1"></i>{{ b.date }}
                            </div>
                        </div>

                        {# Badges côté droit #}
                        <div class="backup-side">
                            {% if loop.first %}
                                <span class="badge-latest d-none d-sm-inline">Dernière</span>
                            {% endif %}
                            <span class="badge bg-light text-dark border font-monospace"
                                  style="font-size: 0.72rem;">{{ b.size_formatted }}</span>
                        </div>

                        {# Chevron #}
                        <i class="bi bi-chevron-down backup-chevron"></i>
                    </button>

                    {# ── Contenu déroulant ── #}
                    <div class="backup-body collapse{% if loop.first %} show{% endif %}"
                         id="backupBody_{{ loop.index }}">

                        {# Détails #}
                        <div class="backup-detail-grid">
                            <div class="backup-detail-item">
                                <div class="backup-detail-label"><i class="bi bi-file-earmark me-1"></i>Fichier</div>
                                <div class="backup-detail-value" style="font-size: 0.75rem; word-break: break-all;">{{ b.filename }}</div>
                            </div>
                            <div class="backup-detail-item">
                                <div class="backup-detail-label"><i class="bi bi-hdd me-1"></i>Taille</div>
                                <div class="backup-detail-value">{{ b.size_formatted }}</div>
                            </div>
                            <div class="backup-detail-item">
                                <div class="backup-detail-label"><i class="bi bi-clock me-1"></i>Créée le</div>
                                <div class="backup-detail-value" style="font-size: 0.78rem;">{{ b.date }}</div>
                            </div>
                            <div class="backup-detail-item">
                                <div class="backup-detail-label"><i class="bi bi-shield-check me-1"></i>Statut</div>
                                <div class="backup-detail-value" style="color: #16a34a; font-family: inherit;">
                                    <i class="bi bi-check-circle-fill me-1"></i>Valide
                                </div>
                            </div>
                        </div>

                        {# Actions #}
                        <div class="backup-actions">
                            {# Télécharger #}
                            <a href="{{ path('app_backup_download', {'filename': b.filename}) }}"
                               class="btn btn-sm btn-success d-inline-flex align-items-center gap-2 fw-semibold"
                               title="Télécharger sur votre poste"
                               data-turbo="false"
                               download="{{ b.filename }}">
                                <i class="bi bi-cloud-arrow-down-fill"></i>
                                <span>Télécharger</span>
                            </a>

                            {# Restaurer #}
                            <button type="button"
                                    class="btn btn-sm btn-outline-warning d-inline-flex align-items-center gap-2"
                                    onclick="confirmRestore('{{ b.filename }}')"
                                    title="Restaurer cette version">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                <span>Restaurer</span>
                            </button>

                            {# Supprimer #}
                            <form method="post"
                                  action="{{ path('app_backup_delete', {'filename': b.filename}) }}"
                                  class="d-inline"
                                  onsubmit="return confirm('Supprimer définitivement cette archive ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('backup_delete_' ~ b.filename) }}">
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1"
                                        title="Supprimer">
                                    <i class="bi bi-trash3"></i>
                                    <span>Supprimer</span>
                                </button>
                            </form>

                            {# Formulaire caché pour la restauration #}
                            <form id="restoreForm_{{ loop.index }}"
                                  method="post"
                                  action="{{ path('app_backup_restore', {'filename': b.filename}) }}"
                                  class="d-none">
                                <input type="hidden" name="_token" value="{{ csrf_token('backup_restore_' ~ b.filename) }}">
                            </form>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
</div>

<script>
function toggleBackup(index) {
    const item = document.getElementById('backupItem_' + index);
    const body = document.getElementById('backupBody_' + index);
    const isOpen = item.classList.contains('open');

    if (isOpen) {
        // Fermer
        item.classList.remove('open');
        body.classList.remove('show');
        item.querySelector('.backup-header').setAttribute('aria-expanded', 'false');
    } else {
        // Ouvrir
        item.classList.add('open');
        body.classList.add('show');
        item.querySelector('.backup-header').setAttribute('aria-expanded', 'true');
    }
    updateToggleAllBtn();
}

function toggleAllBackups() {
    const items = document.querySelectorAll('.backup-item');
    const anyOpen = [...items].some(i => i.classList.contains('open'));

    items.forEach((item, idx) => {
        const body = document.getElementById('backupBody_' + (idx + 1));
        if (!body) return;
        if (anyOpen) {
            item.classList.remove('open');
            body.classList.remove('show');
            item.querySelector('.backup-header').setAttribute('aria-expanded', 'false');
        } else {
            item.classList.add('open');
            body.classList.add('show');
            item.querySelector('.backup-header').setAttribute('aria-expanded', 'true');
        }
    });
    updateToggleAllBtn();
}

function updateToggleAllBtn() {
    const btn = document.getElementById('toggleAllBtn');
    if (!btn) return;
    const anyOpen = [...document.querySelectorAll('.backup-item')].some(i => i.classList.contains('open'));
    btn.innerHTML = anyOpen
        ? '<i class="bi bi-chevron-contract me-1"></i>Tout replier'
        : '<i class="bi bi-chevron-expand me-1"></i>Tout déplier';
}

function confirmRestore(filename) {
    if (confirm('ATTENTION : Vous allez restaurer la base de données depuis :\n\n' + filename + '\n\nUn instantané de secours sera créé automatiquement avant l\'opération.\nContinuer ?')) {
        const forms = document.querySelectorAll('form[id^="restoreForm_"]');
        for (const f of forms) {
            if (f.action && f.action.includes(encodeURIComponent(filename))) {
                f.submit();
                break;
            }
        }
    }
}
</script>
{% endblock %}

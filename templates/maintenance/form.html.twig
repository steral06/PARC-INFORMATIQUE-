{% extends 'base.html.twig' %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}{{ title }} | GTAC2A-IARDT{% endblock %}

{% block body %}
<div class="mb-3 flex-shrink-0">
    <a href="{{ path('app_maintenance_index') }}" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 mb-2">
        <i class="bi bi-arrow-left"></i>
        <span>Retour aux tickets</span>
    </a>
    <div class="d-flex align-items-center gap-2">
        <div class="form-header-badge" style="background-color: #fee2e2; color: #dc2626;">
            <i class="bi bi-tools"></i>
        </div>
        <div>
            <h1 class="h3 fw-bold mb-0" style="color: #121212;">{{ title }}</h1>
            <p class="text-muted small mb-0">Déclarez un dépannage express DSI ou l'envoi d'un matériel chez un prestataire externe</p>
        </div>
    </div>
</div>

<div class="row g-4">
    {# Colonne Formulaire Principal #}
    <div class="col-12 col-xl-8">
        <div class="card card-form mb-4" style="border-top-color: #dc2626 !important;">
            <div class="card-body p-4 p-md-5">
                {{ form_start(form, {'attr': {'id': 'maintenance-form'}}) }}

                {# Section 1 : Choix du type de prise en charge #}
                <div class="form-section-title" style="color: #dc2626;">
                    <i class="bi bi-diagram-3-fill"></i>
                    <span>Type de Prise en Charge</span>
                </div>

                <div class="row g-2 mb-4">
                    {% for child in form.typeMaintenance %}
                        <div class="col-12 col-sm-6">
                            <div class="p-3 border rounded h-100 type-selection-card" style="cursor: pointer;">
                                <div class="form-check">
                                    {{ form_widget(child, {'attr': {'class': 'form-check-input type-radio-input'}}) }}
                                    {{ form_label(child, null, {'label_attr': {'class': 'form-check-label fw-bold'}}) }}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                    {{ form_errors(form.typeMaintenance) }}
                </div>

                {# Section 2 : Équipement & Panne #}
                <div class="form-section-title" style="color: #dc2626;">
                    <i class="bi bi-pc-display-horizontal"></i>
                    <span>Matériel & Incident</span>
                </div>

                <div class="mb-3">
                    {{ form_label(form.equipement) }}
                    {{ form_widget(form.equipement, {'attr': {'id': 'field-equipement'}}) }}
                    {{ form_errors(form.equipement) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.titre) }}
                    {{ form_widget(form.titre, {'attr': {'id': 'field-titre'}}) }}
                    {{ form_errors(form.titre) }}
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-6">
                        {{ form_label(form.priorite) }}
                        {{ form_widget(form.priorite) }}
                        {{ form_errors(form.priorite) }}
                    </div>
                    <div class="col-12 col-md-6">
                        {{ form_label(form.statut) }}
                        {{ form_widget(form.statut, {'attr': {'id': 'field-statut'}}) }}
                        {{ form_errors(form.statut) }}
                    </div>
                </div>

                {# Section 3A : Prise en charge DSI (Interne) #}
                <div id="section-dsi" class="p-3 bg-light rounded border mb-4">
                    <div class="fw-bold text-success mb-2 d-flex align-items-center gap-1">
                        <i class="bi bi-lightning-charge-fill"></i>
                        <span>Intervention Express DSI</span>
                    </div>
                    <div>
                        {{ form_label(form.technicien) }}
                        {{ form_widget(form.technicien, {'attr': {'placeholder': 'Ex: Support DSI, Technicien de permanence...'}}) }}
                        {{ form_errors(form.technicien) }}
                        <div class="form-text small">Indiquez le membre de l'équipe DSI qui effectue l'opération.</div>
                    </div>
                </div>

                {# Section 3B : Prise en charge Prestataire (Externe) #}
                <div id="section-prestataire" class="p-3 bg-light rounded border mb-4" style="display: none;">
                    <div class="fw-bold text-primary mb-2 d-flex align-items-center gap-1">
                        <i class="bi bi-buildings-fill"></i>
                        <span>Détails Prestataire & Expédition Atelier</span>
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            {{ form_label(form.prestataireNom) }}
                            {{ form_widget(form.prestataireNom) }}
                            {{ form_errors(form.prestataireNom) }}
                        </div>
                        <div class="col-12 col-md-6">
                            {{ form_label(form.numeroBon) }}
                            {{ form_widget(form.numeroBon) }}
                            {{ form_errors(form.numeroBon) }}
                        </div>
                        <div class="col-12 col-md-6">
                            {{ form_label(form.dateRetourPrevue) }}
                            {{ form_widget(form.dateRetourPrevue) }}
                            {{ form_errors(form.dateRetourPrevue) }}
                        </div>
                        <div class="col-12 col-md-6">
                            {{ form_label(form.cout) }}
                            <div class="input-group">
                                {{ form_widget(form.cout) }}
                                <span class="input-group-text bg-white text-muted">FCFA</span>
                            </div>
                            {{ form_errors(form.cout) }}
                        </div>
                    </div>
                </div>

                {# Section 4 : Symptômes & Diagnostic #}
                <div class="form-section-title" style="color: #dc2626;">
                    <i class="bi bi-clipboard-pulse"></i>
                    <span>Symptômes & Solution</span>
                </div>

                <div class="mb-3">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description, {'attr': {'id': 'field-description', 'rows': 4}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.solution) }}
                    {{ form_widget(form.solution, {'attr': {'id': 'field-solution', 'rows': 3}}) }}
                    {{ form_errors(form.solution) }}
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-6">
                        {{ form_label(form.dateResolution) }}
                        {{ form_widget(form.dateResolution) }}
                        {{ form_errors(form.dateResolution) }}
                    </div>
                </div>

                {# Actions du formulaire #}
                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a href="{{ path('app_maintenance_index') }}" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-x-lg me-1"></i> Annuler
                    </a>
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 shadow" data-shortcut="v" title="Raccourci : V">
                        <i class="bi bi-check2-circle fs-5"></i>
                        <span>{{ button_label }}</span>
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

    {# Colonne Latérale : Assistant Intelligent DSI & Pannes Courantes #}
    <div class="col-12 col-xl-4">
        <div class="card shadow-sm border-0 sticky-top" style="top: 1rem;">
            <div class="card-header bg-primary text-white py-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-robot fs-4"></i>
                    <div>
                        <h6 class="fw-bold mb-0">Assistant Diagnostic DSI</h6>
                        <small class="text-white-50">Base interne GTAC2A + Recherche Web</small>
                    </div>
                </div>
            </div>
            <div class="card-body p-3">
                <div class="mb-3">
                    <label for="side-search-input" class="form-label small fw-bold text-uppercase text-muted">
                        Rechercher un symptôme / panne :
                    </label>
                    <div class="input-group input-group-sm">
                        <input type="text" id="side-search-input" class="form-control" placeholder="Ex: bip 3 fois, disque 100%, écran noir...">
                        <button type="button" id="side-search-btn" class="btn btn-dark" onclick="window.executerDiagnosticForm(document.getElementById('side-search-input').value)">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>

                {# Pannes rapides en un clic #}
                <div class="mb-3">
                    <label class="form-label small fw-bold text-uppercase text-muted">
                        Pannes habituelles (1 clic) :
                    </label>
                    <div class="d-flex flex-column gap-1" style="max-height: 240px; overflow-y: auto;">
                        {% for id, p in pannes_courantes %}
                            <button type="button" class="btn btn-sm btn-outline-secondary text-start side-quick-btn d-flex align-items-center justify-content-between py-1 px-2"
                                    data-panne-titre="{{ p.titre }}"
                                    onclick="window.executerDiagnosticForm('{{ p.titre|e('js') }}')">
                                <span class="d-flex align-items-center gap-1 text-truncate" style="font-size: 0.8rem;">
                                    <i class="bi {{ p.icone }} text-primary"></i>
                                    <span>{{ p.titre }}</span>
                                </span>
                                <i class="bi bi-chevron-right text-muted small"></i>
                            </button>
                        {% endfor %}
                    </div>
                </div>

                {# Spinner #}
                <div id="side-spinner" class="text-center py-3 d-none">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <div class="small text-muted mt-1" style="font-size: 0.75rem;">Recherche de solution...</div>
                </div>

                {# Résultat du diagnostic #}
                <div id="side-result" class="d-none border rounded p-2 bg-light">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="badge bg-primary" id="side-res-source" style="font-size: 0.7rem;">Base DSI</span>
                        <span class="badge bg-secondary" id="side-res-severite" style="font-size: 0.7rem;">Moyenne</span>
                    </div>
                    <div class="fw-bold text-dark small mb-2" id="side-res-titre">Titre Panne</div>

                    <div class="small fw-semibold text-danger mb-1" style="font-size: 0.75rem;">Causes :</div>
                    <ul id="side-res-causes" class="ps-3 mb-2" style="font-size: 0.75rem;"></ul>

                    <div class="small fw-semibold text-success mb-1" style="font-size: 0.75rem;">Protocole :</div>
                    <ol id="side-res-actions" class="ps-3 mb-2" style="font-size: 0.75rem;"></ol>

                    <div id="side-res-cmd-box" class="d-none mb-2">
                        <div class="small fw-bold text-dark" style="font-size: 0.72rem;">Commande utile :</div>
                        <pre id="side-res-cmd" class="bg-dark text-light p-1 rounded font-monospace mb-0 user-select-all" style="font-size: 0.7rem;"></pre>
                    </div>

                    <button type="button" class="btn btn-success btn-sm w-100 d-inline-flex align-items-center justify-content-center gap-1 shadow-sm mt-2" id="btn-apply-to-form">
                        <i class="bi bi-arrow-down-left-square-fill"></i>
                        <span>Insérer dans le ticket</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    let lastDiag = null;

    // 1. Bascule dynamique DSI vs Prestataire
    window.updateTypeVisibility = function() {
        const radios = document.querySelectorAll('.type-radio-input');
        const secDsi = document.getElementById('section-dsi');
        const secPres = document.getElementById('section-prestataire');
        if (!secDsi || !secPres) return;

        let selectedValue = 'DSI';
        radios.forEach(r => {
            if (r.checked) {
                selectedValue = r.value;
            }
        });

        if (selectedValue === 'Prestataire') {
            secDsi.style.display = 'none';
            secPres.style.display = '';
        } else {
            secDsi.style.display = '';
            secPres.style.display = 'none';
        }
    };

    // 2. Diagnostic Assistant DSI
    window.executerDiagnosticForm = function(texte) {
        const sideInput = document.getElementById('side-search-input');
        const sideSpinner = document.getElementById('side-spinner');
        const sideResult = document.getElementById('side-result');
        const sideResSource = document.getElementById('side-res-source');
        const sideResSeverite = document.getElementById('side-res-severite');
        const sideResTitre = document.getElementById('side-res-titre');
        const sideResCauses = document.getElementById('side-res-causes');
        const sideResActions = document.getElementById('side-res-actions');
        const sideResCmdBox = document.getElementById('side-res-cmd-box');
        const sideResCmd = document.getElementById('side-res-cmd');
        const fieldEquipement = document.getElementById('field-equipement');

        if (!texte) {
            if (sideInput) texte = sideInput.value;
        }
        if (!texte || !texte.trim()) {
            alert('Veuillez décrire le problème ou sélectionner une panne habituelle.');
            if (sideInput) sideInput.focus();
            return;
        }

        if (sideInput) sideInput.value = texte;
        if (sideSpinner) sideSpinner.classList.remove('d-none');
        if (sideResult) sideResult.classList.add('d-none');

        const equipementId = fieldEquipement ? fieldEquipement.value : null;

        fetch("{{ path('app_maintenance_assistant') }}", {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify({
                question: texte,
                equipement_id: equipementId
            })
        })
        .then(res => res.json())
        .then(data => {
            if (sideSpinner) sideSpinner.classList.add('d-none');
            if (data.success && data.diagnostic) {
                lastDiag = data.diagnostic;

                if (sideResSource) sideResSource.textContent = lastDiag.source || 'Base DSI';
                if (sideResSeverite) sideResSeverite.textContent = lastDiag.severite || 'Moyenne';
                if (sideResTitre) sideResTitre.textContent = lastDiag.titre || texte;

                if (sideResCauses) {
                    sideResCauses.innerHTML = '';
                    (lastDiag.causes || []).slice(0, 3).forEach(c => {
                        const li = document.createElement('li');
                        li.textContent = c;
                        sideResCauses.appendChild(li);
                    });
                }

                if (sideResActions) {
                    sideResActions.innerHTML = '';
                    (lastDiag.actions || []).slice(0, 4).forEach(a => {
                        const li = document.createElement('li');
                        li.textContent = a;
                        sideResActions.appendChild(li);
                    });
                }

                if (sideResCmdBox && sideResCmd) {
                    if (lastDiag.commande) {
                        sideResCmd.textContent = lastDiag.commande;
                        sideResCmdBox.classList.remove('d-none');
                    } else {
                        sideResCmdBox.classList.add('d-none');
                    }
                }

                if (sideResult) sideResult.classList.remove('d-none');
            } else {
                alert(data.message || 'Diagnostic introuvable.');
            }
        })
        .catch(err => {
            if (sideSpinner) sideSpinner.classList.add('d-none');
            console.error('Erreur diagnostic form:', err);
            alert('Service de diagnostic temporairement indisponible.');
        });
    };

    function initFormListeners() {
        window.updateTypeVisibility();

        const radios = document.querySelectorAll('.type-radio-input');
        radios.forEach(r => {
            if (!r.dataset.listenerAttached) {
                r.dataset.listenerAttached = 'true';
                r.addEventListener('change', window.updateTypeVisibility);
            }
        });

        const sideInput = document.getElementById('side-search-input');
        if (sideInput && !sideInput.dataset.listenerAttached) {
            sideInput.dataset.listenerAttached = 'true';
            sideInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    window.executerDiagnosticForm(sideInput.value);
                }
            });
        }

        const btnApply = document.getElementById('btn-apply-to-form');
        if (btnApply && !btnApply.dataset.listenerAttached) {
            btnApply.dataset.listenerAttached = 'true';
            btnApply.addEventListener('click', function() {
                if (!lastDiag) return;

                const fieldTitre = document.getElementById('field-titre');
                const fieldDescription = document.getElementById('field-description');
                const fieldSolution = document.getElementById('field-solution');

                if (fieldTitre && (!fieldTitre.value || fieldTitre.value.trim() === '')) {
                    fieldTitre.value = lastDiag.titre || '';
                }

                if (fieldDescription) {
                    let descText = (lastDiag.causes || []).map(c => '• ' + c).join('\n');
                    if (fieldDescription.value && fieldDescription.value.trim() !== '') {
                        fieldDescription.value += '\n\n' + descText;
                    } else {
                        fieldDescription.value = descText;
                    }
                }

                if (fieldSolution) {
                    let solText = lastDiag.solution_recommandee || '';
                    if (lastDiag.actions && lastDiag.actions.length > 0) {
                        solText += '\n\nProtocole suivi :\n' + lastDiag.actions.join('\n');
                    }
                    if (fieldSolution.value && fieldSolution.value.trim() !== '') {
                        fieldSolution.value += '\n\n' + solText;
                    } else {
                        fieldSolution.value = solText;
                    }
                }

                const prevBtn = btnApply.innerHTML;
                btnApply.innerHTML = '<i class="bi bi-check2 text-white me-1"></i>Inséré dans le ticket !';
                setTimeout(() => { btnApply.innerHTML = prevBtn; }, 2000);
            });
        }
    }

    document.addEventListener('turbo:load', initFormListeners);
    document.addEventListener('DOMContentLoaded', initFormListeners);
    if (document.readyState !== 'loading') {
        initFormListeners();
    }
})();
</script>
{% endblock %}

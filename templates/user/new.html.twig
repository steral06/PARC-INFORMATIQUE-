{% extends 'base.html.twig' %}

{% block title %}Créer un Compte Utilisateur | GTAC2A-IARDT{% endblock %}

{% block body %}
<div class="mb-3 flex-shrink-0">
    <a href="{{ path('app_user_index') }}" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 mb-2">
        <i class="bi bi-arrow-left"></i>
        <span>Retour aux utilisateurs</span>
    </a>
    <div class="d-flex align-items-center gap-2">
        <div class="form-header-badge">
            <i class="bi bi-person-plus-fill"></i>
        </div>
        <div>
            <h1 class="h3 fw-bold mb-0" style="color: #121212;">Créer un Compte Utilisateur</h1>
            <p class="text-muted small mb-0">Définissez l'identifiant, les privilèges et le code PIN 2FA du compte</p>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card card-form mb-4">
            <div class="card-body p-4 p-md-5">
                <form method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('user_new') }}">
                    <div class="form-section-title">
                        <i class="bi bi-shield-lock-fill"></i>
                        <span>Identifiants & Droits d'Accès</span>
                    </div>

                    <div class="mb-3">
                        <label for="username" class="form-label fw-semibold text-dark">
                            <i class="bi bi-person me-1 text-primary"></i> Identifiant de connexion (login)
                        </label>
                        <input type="text" id="username" name="username" class="form-control" required placeholder="Ex: agence.port, dsi.support">
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label fw-semibold text-dark">
                            <i class="bi bi-key me-1 text-primary"></i> Mot de passe initial
                        </label>
                        <input type="password" id="password" name="password" class="form-control" required placeholder="Mot de passe temporaire">
                        <small class="text-muted d-block mt-1">L'utilisateur sera invité à le changer périodiquement (30 jours).</small>
                    </div>

                    <div class="mb-3">
                        <label for="pin" class="form-label fw-semibold text-dark">
                            <i class="bi bi-lock me-1 text-primary"></i> Code PIN de Sécurité 2FA (4 chiffres)
                        </label>
                        <input type="text" id="pin" name="pin" class="form-control font-monospace" maxlength="4" pattern="[0-9]{4}" value="1234" required>
                        <small class="text-muted d-block mt-1">Ce code sera demandé lors de la validation 2FA (défaut : 1234).</small>
                    </div>

                    <div class="mb-4">
                        <label for="role" class="form-label fw-semibold text-dark">
                            <i class="bi bi-award me-1 text-primary"></i> Rôle & Privilèges
                        </label>
                        <select id="role" name="role" class="form-select">
                            <option value="ROLE_USER">Utilisateur Standard (Gestion inventaire & opérations)</option>
                            <option value="ROLE_SUPER_ADMIN">Super Administrateur (Contrôle IP, restriction postes, utilisateurs)</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a href="{{ path('app_user_index') }}" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-x-lg me-1"></i> Annuler
                        </a>
                        <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 shadow" data-shortcut="v" title="Raccourci : V">
                            <i class="bi bi-check2-circle fs-5"></i>
                            <span>Créer le compte</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

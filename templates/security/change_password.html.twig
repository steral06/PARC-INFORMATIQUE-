<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="turbo-cache-control" content="no-cache">
        <meta name="turbo-visit-control" content="reload">
        <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
        <meta http-equiv="Pragma" content="no-cache">
        <meta http-equiv="Expires" content="0">
        <title>Renouvellement du mot de passe | GTAC2A-IARDT</title>
        <link rel="icon" type="image/png" href="{{ asset('images/logo-gta.png') }}">
        
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        <style>
            :root {
                --gta-orange: #E47000;
                --gta-orange-hover: #CC6400;
            }
            body {
                background: #121212;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1.5rem;
                margin: 0;
                font-family: system-ui, -apple-system, sans-serif;
            }
            .change-card {
                background: #ffffff;
                border-radius: 1rem;
                box-shadow: 0 25px 50px rgba(0, 0, 0, 0.7);
                width: 100%;
                max-width: 460px;
                overflow: hidden;
                border: 2px solid var(--gta-orange);
                padding: 2.25rem 2rem 2rem;
            }
            .btn-gta {
                background-color: var(--gta-orange);
                border-color: var(--gta-orange);
                color: #ffffff;
                font-weight: 600;
                padding: 0.75rem;
                border-radius: 0.5rem;
                transition: all 0.2s ease-in-out;
            }
            .btn-gta:hover, .btn-gta:focus {
                background-color: var(--gta-orange-hover);
                border-color: var(--gta-orange-hover);
                color: #ffffff;
                box-shadow: 0 4px 14px rgba(228, 112, 0, 0.4);
            }
            .policy-box {
                background: #FFF7ED;
                border: 1px solid #FED7AA;
                border-radius: 0.65rem;
                padding: 0.85rem 1rem;
                font-size: 0.85rem;
                color: #9A3412;
                margin-bottom: 1.5rem;
                text-align: left;
            }
            .form-control:focus {
                border-color: var(--gta-orange);
                box-shadow: 0 0 0 0.25rem rgba(228, 112, 0, 0.25);
            }
        </style>
    </head>
    <body>
        <div class="change-card">
            <div class="text-center mb-3">
                <img src="{{ asset('images/logo-gta.png') }}" alt="GTAC2A-IARDT" style="max-height: 70px; width: auto;">
            </div>

            <div class="text-center mb-3">
                <h4 class="fw-bold mb-1" style="color: #121212;">Modifier le mot de passe</h4>
            </div>

            <div class="policy-box d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-shield-exclamation fs-5 flex-shrink-0 text-warning"></i>
                <div class="small">Renouvellement obligatoire tous les <strong>30 jours</strong>.</div>
            </div>

            {# Flash messages #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show p-2 small mb-3" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close small" data-bs-dismiss="alert" aria-label="Fermer"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            <form method="post" action="{{ path('app_password_change') }}">
                <div class="mb-3 text-start">
                    <label for="current_password" class="form-label small fw-semibold text-dark">Mot de passe actuel</label>
                    <input type="password" name="current_password" id="current_password" class="form-control" required placeholder="Votre mot de passe actuel">
                </div>

                <div class="mb-3 text-start">
                    <label for="new_password" class="form-label small fw-semibold text-dark">Nouveau mot de passe</label>
                    <input type="password" name="new_password" id="new_password" class="form-control" minlength="6" required placeholder="Au moins 6 caractères">
                </div>

                <div class="mb-4 text-start">
                    <label for="confirm_password" class="form-label small fw-semibold text-dark">Confirmer le nouveau mot de passe</label>
                    <input type="password" name="confirm_password" id="confirm_password" class="form-control" minlength="6" required placeholder="Retapez le nouveau mot de passe">
                </div>

                <button class="btn btn-gta w-100 fw-bold d-flex align-items-center justify-content-center gap-2 shadow-sm" type="submit" data-shortcut="v" title="Raccourci : V">
                    <i class="bi bi-shield-lock-fill"></i>
                    <span>Valider pour les 30 prochains jours</span>
                </button>
            </form>

            <div class="mt-4 pt-3 border-top text-center">
                <a href="{{ path('app_logout') }}" class="text-muted small text-decoration-none d-inline-flex align-items-center gap-1">
                    <i class="bi bi-box-arrow-left"></i>
                    <span>Se déconnecter</span>
                </a>
            </div>
        </div>
    </body>
</html>

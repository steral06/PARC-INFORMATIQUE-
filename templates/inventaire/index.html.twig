{% extends 'base.html.twig' %}

{% block title %}Inventaire Périodique | GTAC2A-IARDT{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1" style="color: #121212;">
            <i class="bi bi-clipboard2-check text-warning me-2"></i>Inventaire Périodique
        </h1>
        <p class="text-muted small mb-0">
            Campagnes de passage en revue physique annuel du parc informatique &amp; détection d'écarts.
        </p>
    </div>
    <div>
        <a href="{{ path('app_inventaire_new') }}" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm" data-shortcut="n" title="Raccourci : N">
            <i class="bi bi-plus-circle"></i>
            <span>Lancer une Campagne</span>
        </a>
    </div>
</div>

{# Alerte si campagne active en cours #}
{% if campagne_active %}
    <div class="alert alert-warning border-0 shadow-sm p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2"
         style="background: rgba(228, 112, 0, 0.08); border-left: 4px solid var(--gta-orange) !important;">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width: 40px; height: 40px; background: rgba(228, 112, 0, 0.18); color: var(--gta-orange);">
                <i class="bi bi-hourglass-split fs-5"></i>
            </div>
            <div>
                <div class="fw-bold text-dark">Campagne active : « {{ campagne_active.titre }} »</div>
                <div class="small text-muted">
                    Démarrée le {{ campagne_active.dateDebut|date('d/m/Y') }} par <strong>{{ campagne_active.creePar ?? 'DSI' }}</strong>
                    &bull; Progression : <strong>{{ campagne_active.tauxProgression }}%</strong>
                    ({{ campagne_active.equipementsControlesCount }}/{{ campagne_active.totalEquipements }} contrôlés)
                </div>
            </div>
        </div>
        <a href="{{ path('app_inventaire_show', {'id': campagne_active.id}) }}" class="btn btn-dark btn-sm px-3 shadow-sm">
            <i class="bi bi-arrow-right-circle me-1"></i>Continuer le pointage
        </a>
    </div>
{% endif %}

{# Liste de toutes les campagnes #}
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <span class="fw-bold small text-dark">
            <i class="bi bi-clock-history me-1 text-primary"></i> Historique des Campagnes ({{ campagnes|length }})
        </span>
    </div>

    {% if campagnes is empty %}
        <div class="card-body text-center py-5">
            <div class="mb-2 text-muted fs-1"><i class="bi bi-clipboard2-x"></i></div>
            <p class="text-muted small mb-3">Aucune campagne d'inventaire n'a encore été réalisée.</p>
            <a href="{{ path('app_inventaire_new') }}" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Lancer la première campagne
            </a>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Titre de la Campagne</th>
                        <th>Année</th>
                        <th>Date de Début</th>
                        <th>Clôture</th>
                        <th>Progression</th>
                        <th>Écarts</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for c in campagnes %}
                        <tr>
                            <td>
                                <a href="{{ path('app_inventaire_show', {'id': c.id}) }}" class="fw-bold text-dark text-decoration-none">
                                    {{ c.titre }}
                                </a>
                                {% if c.notes %}
                                    <div class="text-muted small" style="font-size: 0.72rem;">{{ c.notes|slice(0, 60) }}...</div>
                                {% endif %}
                            </td>
                            <td><span class="badge bg-light text-dark border font-monospace">{{ c.annee }}</span></td>
                            <td class="small">{{ c.dateDebut|date('d/m/Y') }}</td>
                            <td class="small">{{ c.dateCloture ? c.dateCloture|date('d/m/Y') : '—' }}</td>
                            <td style="min-width: 140px;">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 6px;">
                                        <div class="progress-bar {% if c.statut == 'Clôturée' %}bg-success{% else %}bg-primary{% endif %}"
                                             role="progressbar"
                                             style="width: {{ c.tauxProgression }}%;"
                                             aria-valuenow="{{ c.tauxProgression }}"
                                             aria-valuemin="0"
                                             aria-valuemax="100"></div>
                                    </div>
                                    <span class="small fw-semibold" style="font-size: 0.72rem;">{{ c.tauxProgression }}%</span>
                                </div>
                                <div class="text-muted" style="font-size: 0.7rem;">
                                    {{ c.equipementsControlesCount }}/{{ c.totalEquipements }}
                                </div>
                            </td>
                            <td>
                                {% set totalEcarts = c.deplacesCount + c.manquantsCount + c.horsServiceCount %}
                                {% if totalEcarts > 0 %}
                                    <a href="{{ path('app_inventaire_ecarts', {'id': c.id}) }}" class="badge bg-danger-subtle text-danger border border-danger-subtle text-decoration-none fw-bold" title="Voir les écarts">
                                        <i class="bi bi-exclamation-triangle me-1"></i>{{ totalEcarts }} écart(s)
                                    </a>
                                {% else %}
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check me-1"></i>0 écart
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                {% if c.statut == 'En cours' %}
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                        <i class="bi bi-hourglass-split me-1"></i>En cours
                                    </span>
                                {% else %}
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle me-1"></i>Clôturée
                                    </span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ path('app_inventaire_show', {'id': c.id}) }}" class="btn btn-outline-dark" title="Consulter / Pointer">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="{{ path('app_inventaire_ecarts', {'id': c.id}) }}" class="btn btn-outline-warning" title="Rapport d'écarts">
                                        <i class="bi bi-exclamation-triangle"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-secondary opacity-50" disabled style="cursor: not-allowed;" title="Procès-verbal PDF bientôt disponible (version ultérieure)">
                                        <i class="bi bi-file-earmark-pdf text-secondary"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}


{% extends 'base.html.twig' %}

{% block title %}Tableau de bord | GTAC2A-IARDT{% endblock %}

{% block body %}
<div class="dash-wrapper pb-4">
    <!-- Topbar : Search Pill sophistiquée + Section Header + Date Pill -->
    <div class="dash-topbar">
        {# Command Palette Search — résultats live sans quitter le dashboard #}
        <div class="dash-search-wrapper" id="dashSearchWrapper">
            <div class="dash-search-pill" id="dashSearchPill" role="combobox" aria-haspopup="listbox" aria-expanded="false">
                <i class="bi bi-search text-muted" id="dashSearchIcon"></i>
                <input type="text"
                       id="dashSearchInput"
                       placeholder="Rechercher équipement, bénéficiaire, N° série... (Entrée pour valider)"
                       aria-label="Recherche globale"
                       aria-autocomplete="list"
                       aria-controls="dashSearchResults"
                       autocomplete="off"
                       spellcheck="false">
                <button type="button" id="dashSearchBtn"
                        class="btn btn-sm btn-warning px-2 py-0 ms-1 d-inline-flex align-items-center gap-1"
                        style="font-size:0.75rem; border-radius: 6px; height: 26px;"
                        title="Lancer la recherche">
                    <i class="bi bi-search"></i>
                    <span class="d-none d-sm-inline">Rechercher</span>
                </button>
                <span class="dash-search-shortcut" id="dashSearchShortcut">
                    <kbd>/</kbd>
                </span>
                <span class="dash-search-spinner d-none" id="dashSearchSpinner">
                    <span class="spinner-border spinner-border-sm text-muted" style="width:14px;height:14px;border-width:2px;"></span>
                </span>
            </div>

            {# Panneau de résultats — command palette #}
            <div class="dash-search-panel d-none" id="dashSearchPanel" role="listbox" aria-label="Résultats de recherche">
                <div id="dashSearchResults"></div>
                <div class="dash-search-footer">
                    <span><kbd>↑</kbd><kbd>↓</kbd> naviguer</span>
                    <span><kbd>↵</kbd> ouvrir</span>
                    <span><kbd>Esc</kbd> fermer</span>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-3 ms-auto">
            <h1 class="d-none d-md-inline fw-bold mb-0 dash-title" style="font-size: 1.15rem; letter-spacing: -0.3px;">
                Tableau de bord
            </h1>
            <div class="dash-date-pill">
                <i class="bi bi-calendar2-week" style="color: var(--gta-orange);"></i>
                <span>{{ "now"|date('l, d F Y')|capitalize }}</span>
            </div>
        </div>
    </div>

    {# Compteur d'animation pour le stagger séquentiel global #}
    {% set animIndex = 0 %}

    <!-- Grille Principale Bento sous la forme exacte de la maquette mais avec données 100% réelles -->
    <div class="row g-3">
        <!-- ==========================================
             COLONNE GAUCHE (Étroite : Cartes empilées)
             ========================================== -->
        <div class="col-12 col-xl-4 d-flex flex-column gap-3">

            {# 1. Carte Valeur du Parc — toujours visible (même à zéro c'est informatif) #}
            {% set animIndex = animIndex + 1 %}
            <div class="dash-bento-card dash-animate" style="animation-delay: {{ animIndex * 0.07 }}s;">
                <div class="dash-card-title">
                    <span>Valeur du Parc &bull; Valorisation</span>
                    <span class="badge rounded-pill bg-light text-dark border small" style="font-size: 0.68rem;">Global</span>
                </div>
                <div class="dash-metric-big text-warning font-monospace">
                    {% if total_valeur > 0 %}
                        {{ total_valeur|number_format(0, ',', ' ') }} <span style="font-size: 1.05rem; color: #9ca3af;">FCFA</span>
                    {% else %}
                        0 <span style="font-size: 1.05rem; color: #9ca3af;">FCFA</span>
                    {% endif %}
                </div>
                <div class="dash-metric-sub">
                    <i class="bi bi-circle-fill text-{{ stats.en_service > 0 ? 'success' : 'secondary' }} me-1" style="font-size: 0.55rem;"></i>
                    Aujourd'hui &bull; {{ stats.en_service }} opérationnel(s) sur {{ stats.equipements_count }} actif(s) au total
                </div>
                <div class="small text-muted mt-2 pt-2 border-top border-secondary border-opacity-25 d-flex justify-content-between">
                    <span>Mise à jour DSI</span>
                    <span class="font-monospace text-light">{{ "now"|date('d/m/Y') }}</span>
                </div>
            </div>

            {# 2. Carte Répartition par Catégorie — masquée si aucune catégorie #}
            {% if cat_distribution|length > 0 %}
                {% set animIndex = animIndex + 1 %}
                <div class="dash-bento-card dash-animate" style="animation-delay: {{ animIndex * 0.07 }}s;">
                    <div class="dash-card-title">
                        <span>Répartition par Catégorie</span>
                        <a href="{{ path('app_categorie_index') }}" class="text-warning text-decoration-none small" style="font-size: 0.72rem;">
                            Toutes <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                    <div class="d-flex flex-column gap-2 mt-2 dash-scroll-slim" style="max-height: 220px; overflow-y: auto; padding-right: 6px;">
                        {% set maxCount = 0 %}
                        {% for cat in cat_distribution %}
                            {% if cat.count > maxCount %}{% set maxCount = cat.count %}{% endif %}
                        {% endfor %}

                        {% for cat in cat_distribution %}
                            {% set pct = maxCount > 0 ? (cat.count / maxCount * 100)|round : 0 %}
                            <div class="dash-bar-item">
                                <div class="dash-bar-label">
                                    <span class="text-truncate" style="max-width: 190px;" title="{{ cat.label }}">{{ cat.label }}</span>
                                    <span class="fw-bold font-monospace">{{ cat.count }}</span>
                                </div>
                                <div class="dash-bar-track">
                                    <div class="dash-bar-fill" style="width: {{ pct }}%; background: {% if loop.index == 1 %}var(--gta-orange){% elseif loop.index == 2 %}#ff8c1a{% elseif loop.index == 3 %}#10b981{% elseif loop.index == 4 %}#38bdf8{% else %}#94a3b8{% endif %};"></div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {# 3. Carte Contrôles Système — toujours visible (info système) #}
            {% set animIndex = animIndex + 1 %}
            <div class="dash-bento-card dash-animate" style="animation-delay: {{ animIndex * 0.07 }}s;">
                <div class="dash-card-title">
                    <span>Contrôles Système &amp; Sécurité</span>
                    <i class="bi bi-sliders text-muted"></i>
                </div>
                <div class="d-flex flex-column gap-2 mt-1">
                    <div class="dash-toggle-row">
                        <div class="dash-switch active-orange"></div>
                        <div>
                            <div class="fw-semibold text-white small">Filtrage IP &amp; Postes</div>
                            <div class="text-muted" style="font-size: 0.72rem;">{{ stats.postes_count }} poste(s) autorisé(s)</div>
                        </div>
                    </div>

                    <div class="dash-toggle-row">
                        <div class="dash-switch active-green"></div>
                        <div>
                            <div class="fw-semibold text-white small">Double Authentification (2FA)</div>
                            <div class="text-muted" style="font-size: 0.72rem;">Code PIN actif à chaque session</div>
                        </div>
                    </div>

                    <div class="dash-toggle-row">
                        <div class="dash-switch active-green"></div>
                        <div>
                            <div class="fw-semibold text-white small">Audit &amp; Traçabilité DSI</div>
                            <div class="text-muted" style="font-size: 0.72rem;">Journalisation en continu</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ==========================================
             ZONE DROITE (Large : Emplacements + Gauges + Stock)
             ========================================== -->
        <div class="col-12 col-xl-8 d-flex flex-column gap-3">

            {# 1. Grande Carte : Progress (Dernières Attributions + Lieux) — masquée si aucune attribution ET aucun lieu #}
            {% if recent_attributions|length > 0 or lieux_distribution|length > 0 %}
                {% set animIndex = animIndex + 1 %}
                <div class="dash-bento-card dash-animate" style="animation-delay: {{ animIndex * 0.07 }}s;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="dash-card-title mb-0">
                            <span>Progress &bull; Dotations &amp; Emplacements Réels</span>
                        </div>
                        <span class="badge rounded-pill bg-white text-dark shadow-sm px-3 py-1 font-monospace" style="font-size: 0.72rem;">
                            <i class="bi bi-broadcast me-1 text-success"></i>Aujourd'hui
                        </span>
                    </div>

                    <div class="row g-3 align-items-start">
                        <!-- Sous-colonne Gauche : Tableau Dernières Attributions Réelles -->
                        <div class="col-12 col-md-5">
                            <div class="small fw-bold text-muted mb-2 text-uppercase d-flex justify-content-between align-items-center" style="letter-spacing: 0.5px; font-size: 0.72rem;">
                                <span>Dernières Dotations</span>
                                <a href="{{ path('app_attribution_index') }}" class="text-warning text-decoration-none" style="font-size: 0.7rem;">Voir tout</a>
                            </div>
                            <div class="table-responsive">
                                <table class="dash-inset-table">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Bénéficiaire</th>
                                            <th class="text-end">Matériel</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for att in recent_attributions %}
                                            <tr>
                                                <td class="font-monospace text-muted" style="font-size: 0.72rem;">{{ att.dateDebut|date('d/m') }}</td>
                                                <td class="text-truncate" style="max-width: 110px;" title="{{ att.beneficiaireNom }}">{{ att.beneficiaireNom }}</td>
                                                <td class="text-end text-warning text-truncate font-monospace" style="max-width: 90px;" title="{{ att.equipement ? att.equipement.nom : 'Matériel' }}">
                                                    {{ att.equipement ? att.equipement.nom|slice(0, 12) ~ '...' : '-' }}
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr>
                                                <td colspan="3" class="text-muted text-center py-3">
                                                    <i class="bi bi-inbox d-block fs-5 text-secondary mb-1"></i>
                                                    Aucune dotation active enregistrée
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Sous-colonne Droite : Répartition par Emplacement / Site GTA Réel -->
                        <div class="col-12 col-md-7">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small fw-bold text-muted text-uppercase" style="letter-spacing: 0.5px; font-size: 0.72rem;">
                                    Équipements par Emplacement Réel
                                </span>
                                <a href="{{ path('app_lieu_index') }}" class="text-warning text-decoration-none small" style="font-size: 0.7rem;">
                                    Gérer les lieux <i class="bi bi-chevron-right"></i>
                                </a>
                            </div>
                            <div class="d-flex flex-column gap-2">
                                {% set maxLieuCount = 0 %}
                                {% for l in lieux_distribution %}
                                    {% if l.count > maxLieuCount %}{% set maxLieuCount = l.count %}{% endif %}
                                {% endfor %}

                                {% for lieu in lieux_distribution %}
                                    {% set lieuPct = maxLieuCount > 0 ? (lieu.count / maxLieuCount * 100)|round : 0 %}
                                    <div class="p-2 rounded-3 border" style="background: rgba(0, 0, 0, 0.22); border-color: rgba(255,255,255,0.06) !important;">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <div class="d-flex align-items-center gap-2 overflow-hidden">
                                                <i class="bi bi-geo-alt-fill text-warning flex-shrink-0" style="font-size: 0.82rem;"></i>
                                                <span class="small text-white text-truncate fw-medium" title="{{ lieu.label }}">{{ lieu.label }}</span>
                                            </div>
                                            <span class="badge bg-dark border text-light font-monospace" style="font-size: 0.7rem;">
                                                {{ lieu.count }} actif{{ lieu.count > 1 ? 's' : '' }}
                                            </span>
                                        </div>
                                        <div class="progress" style="height: 4px; background: rgba(255,255,255,0.08); border-radius: 4px;">
                                            <div class="progress-bar" style="width: {{ lieuPct }}%; background: var(--gta-orange); border-radius: 4px;"></div>
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="text-center text-muted small p-3 rounded-3 border" style="background: rgba(0, 0, 0, 0.2); border-color: rgba(255,255,255,0.05) !important;">
                                        <i class="bi bi-geo-alt fs-4 d-block mb-1 text-secondary"></i>
                                        Aucun lieu configuré.
                                        <div class="mt-2">
                                            <a href="{{ path('app_lieu_new') }}" class="btn btn-outline-warning btn-sm py-0 px-2" style="font-size: 0.75rem;">
                                                + Ajouter un lieu
                                            </a>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {# 2. Rangée Médiane : 3 Cartes Jauges — chacune masquée si sa valeur est 0 #}
            {# Calcul dynamique du nombre de jauges visibles pour ajuster les colonnes #}
            {% set gaugeCount = (stats.en_service > 0 ? 1 : 0) + (stats.en_stock > 0 ? 1 : 0) + (vetuste_count > 0 ? 1 : 0) %}
            {% set gaugeCol = gaugeCount == 3 ? 4 : (gaugeCount == 2 ? 6 : 6) %}

            {% if gaugeCount > 0 %}
                <div class="row g-3 {% if gaugeCount == 1 %}justify-content-center{% endif %}">
                    {# Gauge 1 : En Service #}
                    {% if stats.en_service > 0 %}
                        {% set animIndex = animIndex + 1 %}
                        <div class="col-12 col-md-{{ gaugeCol }}">
                            <div class="dash-bento-card p-3 dash-animate" style="animation-delay: {{ animIndex * 0.07 }}s;">
                                <div class="dash-card-title mb-2">
                                    <span>Matériels en Service</span>
                                    <i class="bi bi-cpu text-warning small"></i>
                                </div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="position-relative d-inline-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                                        <svg class="dash-gauge-svg" width="58" height="58" viewBox="0 0 36 36">
                                            <path class="dash-gauge-bg" stroke-width="3.5" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                                            <path stroke="var(--gta-orange)" stroke-width="3.5" stroke-dasharray="{{ en_service_pct }}, 100" stroke-linecap="round" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                                        </svg>
                                        <span class="position-absolute fw-bold font-monospace text-white" style="font-size: 0.72rem;">{{ en_service_pct }}%</span>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold font-monospace text-white fs-4 mb-0">{{ stats.en_service }}</div>
                                        <div class="text-muted small" style="font-size: 0.72rem;">En service</div>
                                    </div>
                                </div>
                                <svg class="dash-sparkline-svg" viewBox="0 0 100 25" preserveAspectRatio="none">
                                    <path d="M0,18 Q 15,5 30,12 T 60,8 T 85,15 L 100,5" fill="none" stroke="var(--gta-orange)" stroke-width="2.5" stroke-linecap="round"/>
                                </svg>
                            </div>
                        </div>
                    {% endif %}

                    {# Gauge 2 : En Stock #}
                    {% if stats.en_stock > 0 %}
                        {% set animIndex = animIndex + 1 %}
                        <div class="col-12 col-md-{{ gaugeCol }}">
                            <div class="dash-bento-card p-3 dash-animate" style="animation-delay: {{ animIndex * 0.07 }}s;">
                                <div class="dash-card-title mb-2">
                                    <span>Disponibilité Stock</span>
                                    <i class="bi bi-boxes text-success small"></i>
                                </div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="position-relative d-inline-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                                        <svg class="dash-gauge-svg" width="58" height="58" viewBox="0 0 36 36">
                                            <path class="dash-gauge-bg" stroke-width="3.5" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                                            <path stroke="#10b981" stroke-width="3.5" stroke-dasharray="{{ en_stock_pct }}, 100" stroke-linecap="round" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                                        </svg>
                                        <span class="position-absolute fw-bold font-monospace text-white" style="font-size: 0.72rem;">{{ en_stock_pct }}%</span>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold font-monospace text-white fs-4 mb-0">{{ stats.en_stock }}</div>
                                        <div class="text-muted small" style="font-size: 0.72rem;">En réserve</div>
                                    </div>
                                </div>
                                <svg class="dash-sparkline-svg" viewBox="0 0 100 25" preserveAspectRatio="none">
                                    <path d="M0,14 Q 20,20 40,8 T 70,18 T 100,6" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round"/>
                                </svg>
                            </div>
                        </div>
                    {% endif %}

                    {# Gauge 3 : Vétusté #}
                    {% if vetuste_count > 0 %}
                        {% set animIndex = animIndex + 1 %}
                        <div class="col-12 col-md-{{ gaugeCol }}">
                            <div class="dash-bento-card p-3 dash-animate" style="animation-delay: {{ animIndex * 0.07 }}s;">
                                <div class="dash-card-title mb-2">
                                    <span>Audit Vétusté (&gt; 3 ans)</span>
                                    <i class="bi bi-clock-history text-info small"></i>
                                </div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="position-relative d-inline-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                                        <svg class="dash-gauge-svg" width="58" height="58" viewBox="0 0 36 36">
                                            <path class="dash-gauge-bg" stroke-width="3.5" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                                            <path stroke="#38bdf8" stroke-width="3.5" stroke-dasharray="{{ vetuste_pct }}, 100" stroke-linecap="round" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                                        </svg>
                                        <span class="position-absolute fw-bold font-monospace text-white" style="font-size: 0.72rem;">{{ vetuste_pct }}%</span>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold font-monospace text-white fs-4 mb-0">{{ vetuste_count }}</div>
                                        <div class="text-muted small" style="font-size: 0.72rem;">Vétustes (&gt; 3 ans)</div>
                                    </div>
                                </div>
                                <svg class="dash-sparkline-svg" viewBox="0 0 100 25" preserveAspectRatio="none">
                                    <path d="M0,10 Q 25,18 50,7 T 80,15 T 100,10" fill="none" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round"/>
                                </svg>
                            </div>
                        </div>
                    {% endif %}
                </div>
            {% endif %}

            {# 3. Rangée Basse : 2 Cartes (Chart + Stock) — masquée si aucun équipement du tout #}
            {% if stats.equipements_count > 0 %}
                <div class="row g-3">
                    <!-- Carte Gauche : Concentric Multi-ring Chart -->
                    {% set animIndex = animIndex + 1 %}
                    <div class="col-12 col-md-7">
                        <div class="dash-bento-card dash-animate" style="animation-delay: {{ animIndex * 0.07 }}s;">
                            <div class="dash-card-title mb-2">
                                <span>État Opérationnel du Parc</span>
                                <span class="badge bg-dark border small text-muted">GTAC2A-IARDT</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-around py-2">
                                <!-- SVG Multi-ring Concentric Chart -->
                                <div class="position-relative d-inline-flex align-items-center justify-content-center" style="width: 120px; height: 120px;">
                                    <svg width="120" height="120" viewBox="0 0 100 100" style="transform: rotate(-90deg);">
                                        <!-- Anneau Externe (Orange GTA : En service) -->
                                        <circle cx="50" cy="50" r="42" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="6"/>
                                        {% if en_service_pct > 0 %}
                                            <circle cx="50" cy="50" r="42" fill="none" stroke="var(--gta-orange)" stroke-width="6"
                                                    stroke-dasharray="{{ (en_service_pct * 2.64)|round }}, 264" stroke-linecap="round"/>
                                        {% endif %}

                                        <!-- Anneau Médian (Vert : En stock) -->
                                        <circle cx="50" cy="50" r="32" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="6"/>
                                        {% if en_stock_pct > 0 %}
                                            <circle cx="50" cy="50" r="32" fill="none" stroke="#10b981" stroke-width="6"
                                                    stroke-dasharray="{{ (en_stock_pct * 2.01)|round }}, 201" stroke-linecap="round"/>
                                        {% endif %}

                                        <!-- Anneau Interne (Bleu : Dotations) -->
                                        <circle cx="50" cy="50" r="22" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="6"/>
                                        {% if stats.attributions_actives > 0 and stats.equipements_count > 0 %}
                                            {% set attStroke = ((stats.attributions_actives / stats.equipements_count) * 138)|round %}
                                            <circle cx="50" cy="50" r="22" fill="none" stroke="#38bdf8" stroke-width="6"
                                                    stroke-dasharray="{{ attStroke }}, 138" stroke-linecap="round"/>
                                        {% endif %}
                                    </svg>
                                    <div class="position-absolute text-center">
                                        <span class="fw-bold font-monospace text-white d-block" style="font-size: 0.95rem;">
                                            {{ stats.equipements_count }}
                                        </span>
                                        <span class="text-muted text-uppercase" style="font-size: 0.55rem; letter-spacing: 0.5px;">Actifs</span>
                                    </div>
                                </div>

                                <!-- Légende avec carrés colorés (données réelles) -->
                                <div class="d-flex flex-column gap-2 small">
                                    <div class="d-flex align-items-center gap-2">
                                        <span style="width: 10px; height: 10px; border-radius: 2px; background: var(--gta-orange);"></span>
                                        <span class="text-light" style="font-size: 0.78rem;">En service</span>
                                        <span class="fw-bold font-monospace text-warning ms-auto">{{ stats.en_service }} ({{ en_service_pct }}%)</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span style="width: 10px; height: 10px; border-radius: 2px; background: #10b981;"></span>
                                        <span class="text-light" style="font-size: 0.78rem;">En réserve</span>
                                        <span class="fw-bold font-monospace text-success ms-auto">{{ stats.en_stock }} ({{ en_stock_pct }}%)</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span style="width: 10px; height: 10px; border-radius: 2px; background: #38bdf8;"></span>
                                        <span class="text-light" style="font-size: 0.78rem;">Attribués</span>
                                        <span class="fw-bold font-monospace text-info ms-auto">{{ stats.attributions_actives }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Carte Droite : Stock & Sorties Réels -->
                    {% set animIndex = animIndex + 1 %}
                    <div class="col-12 col-md-5">
                        <div class="dash-bento-card d-flex flex-column justify-content-between dash-animate" style="animation-delay: {{ animIndex * 0.07 }}s;">
                            <div class="dash-card-title mb-2">
                                <span>Disponibilité &amp; Dotations</span>
                                <i class="bi bi-box-seam text-warning small"></i>
                            </div>
                            <div>
                                <div class="dash-metric-big text-white font-monospace mb-0">
                                    {{ stats.en_stock }}
                                </div>
                                <div class="text-muted small fw-semibold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                    En Réserve / Stock
                                </div>
                            </div>

                            <!-- Thick Progress Bar Réelle -->
                            <div class="my-3">
                                <div class="progress" style="height: 10px; background: rgba(255,255,255,0.1); border-radius: 10px;">
                                    <div class="progress-bar" style="width: {{ en_stock_pct }}%; background: #ffffff; border-radius: 10px;"></div>
                                </div>
                            </div>

                            <div>
                                <div class="dash-metric-big text-light font-monospace mb-0" style="font-size: 1.8rem;">
                                    {{ stats.attributions_actives }}
                                </div>
                                <div class="text-muted small fw-semibold text-uppercase mb-3" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                    Attributions en cours
                                </div>

                                <a href="{{ path('app_equipement_index') }}" class="btn btn-outline-light btn-sm w-100 rounded-pill py-1 d-inline-flex align-items-center justify-content-center gap-1 shadow-sm" style="font-size: 0.78rem;">
                                    <span>Voir tout l'inventaire</span>
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- ============================================================
         NOUVELLE SECTION : VISUALISATION GRAPHIQUE KPI & ANALYSE DSI
         ============================================================ -->
    <div class="mt-4 pt-3 border-top border-secondary border-opacity-25">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-3 gap-2">
            <div>
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-pie-chart-fill" style="color: var(--gta-orange);"></i>
                    <span>Analyses Graphiques & Visualisation Décisionnelle</span>
                    <span class="badge bg-secondary-subtle text-dark border small" style="font-size: 0.7rem;">KPIs GTA</span>
                </h5>
                <small class="text-muted">Répartition du parc par statut opérationnel, systèmes d'exploitation (OS) et cycle d'obsolescence</small>
            </div>
            <span class="badge bg-light text-muted border font-monospace small">Mise à jour en direct</span>
        </div>

        <div class="row g-3">
            {# Graphique 1 : Statut Opérationnel #}
            <div class="col-12 col-md-4">
                <div class="card border rounded-3 shadow-sm h-100">
                    <div class="card-header py-2 px-3 border-bottom d-flex align-items-center justify-content-between">
                        <span class="small fw-bold text-dark"><i class="bi bi-check2-circle text-success me-1"></i> Statut Opérationnel</span>
                        <span class="badge bg-light text-dark border font-monospace" style="font-size: 0.7rem;">{{ stats.equipements_count }} actifs</span>
                    </div>
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center">
                        <div style="position: relative; width: 100%; max-width: 220px; height: 220px;">
                            <canvas id="chartStatus"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            {# Graphique 2 : Systèmes d'Exploitation (OS) #}
            <div class="col-12 col-md-4">
                <div class="card border rounded-3 shadow-sm h-100">
                    <div class="card-header py-2 px-3 border-bottom d-flex align-items-center justify-content-between">
                        <span class="small fw-bold text-dark"><i class="bi bi-window text-primary me-1"></i> Systèmes d'Exploitation (OS)</span>
                        <span class="badge bg-light text-dark border font-monospace" style="font-size: 0.7rem;">Postes & Serveurs</span>
                    </div>
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center">
                        <div style="position: relative; width: 100%; height: 220px;">
                            <canvas id="chartOs"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            {# Graphique 3 : Obsolescence & Tranches d'Âge #}
            <div class="col-12 col-md-4">
                <div class="card border rounded-3 shadow-sm h-100">
                    <div class="card-header py-2 px-3 border-bottom d-flex align-items-center justify-content-between">
                        <span class="small fw-bold text-dark"><i class="bi bi-hourglass-split text-warning me-1"></i> Cycle de Vie & Obsolescence</span>
                        <span class="badge bg-light text-dark border font-monospace" style="font-size: 0.7rem;">Durabilité GTA</span>
                    </div>
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center">
                        <div style="position: relative; width: 100%; max-width: 220px; height: 220px;">
                            <canvas id="chartAge"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(function () {
    'use strict';

    var API_URL = '{{ path('app_search_global') }}';

    function initDashSearch() {
        var input    = document.getElementById('dashSearchInput');
        var panel    = document.getElementById('dashSearchPanel');
        var results  = document.getElementById('dashSearchResults');
        var spinner  = document.getElementById('dashSearchSpinner');
        var shortcut = document.getElementById('dashSearchShortcut');
        var wrapper  = document.getElementById('dashSearchWrapper');

        if (!input || input.dataset.dashSearchInit) return;
        input.dataset.dashSearchInit = 'true';

        var timer     = null;
        var activeIdx = -1;
        var lastItems = [];
        var DEBOUNCE  = 280;

        function openPanel()  { panel.classList.remove('d-none'); shortcut.classList.add('d-none'); }
        function closePanel() { panel.classList.add('d-none'); shortcut.classList.remove('d-none'); activeIdx = -1; lastItems = []; }

        var typeLabels   = { equipement: 'Équipements', attribution: 'Attributions actives', user: 'Utilisateurs' };
        var typeColors   = { equipement: 'text-warning', attribution: 'text-success', user: 'text-info' };
        var statutColors = { 'En service': 'bg-success-subtle text-success', 'En stock': 'bg-primary-subtle text-primary', 'En panne': 'bg-danger-subtle text-danger', 'En cours': 'bg-success-subtle text-success' };

        function escHtml(s) {
            return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function highlightMatch(text, query) {
            if (!text || !query) return escHtml(text || '');
            var safe  = escHtml(text);
            var safeQ = escHtml(query).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            return safe.replace(new RegExp('(' + safeQ + ')', 'gi'), '<mark class="dash-search-mark">$1</mark>');
        }

        function render(data, query) {
            if (!data.results || data.results.length === 0) {
                results.innerHTML = '<div class="dash-search-empty"><i class="bi bi-inbox fs-4 d-block mb-2 text-secondary"></i><span>Aucun résultat pour « <strong>' + escHtml(query) + '</strong> »</span></div>';
                lastItems = [];
                return;
            }
            var groups = {};
            data.results.forEach(function (r) {
                if (!groups[r.type]) groups[r.type] = [];
                groups[r.type].push(r);
            });
            var html = ''; var itemIdx = 0; lastItems = [];
            Object.keys(groups).forEach(function (type) {
                html += '<div class="dash-search-group-label">' + (typeLabels[type] || type) + '</div>';
                groups[type].forEach(function (r) {
                    var hl = highlightMatch(r.label, query);
                    var hlSub = highlightMatch(r.sub, query);
                    var badge = r.statut ? '<span class="badge rounded-pill ms-auto ' + (statutColors[r.statut] || 'bg-secondary-subtle text-secondary') + '" style="font-size:0.65rem;">' + escHtml(r.statut) + '</span>' : '';
                    html += '<a class="dash-search-item" data-idx="' + itemIdx + '" href="' + escHtml(r.url) + '" role="option">'
                          + '<span class="dash-search-item-icon ' + (typeColors[type] || '') + '"><i class="bi ' + escHtml(r.icon) + '"></i></span>'
                          + '<span class="dash-search-item-content"><span class="dash-search-item-label">' + hl + '</span><span class="dash-search-item-sub">' + hlSub + '</span></span>'
                          + badge + '</a>';
                    lastItems.push(r); itemIdx++;
                });
            });
            results.innerHTML = html; activeIdx = -1;
        }

        function setActive(idx) {
            var items = results.querySelectorAll('.dash-search-item');
            items.forEach(function (el) { el.classList.remove('active'); });
            activeIdx = Math.max(-1, Math.min(idx, items.length - 1));
            if (activeIdx >= 0 && items[activeIdx]) {
                items[activeIdx].classList.add('active');
                items[activeIdx].scrollIntoView({ block: 'nearest' });
            }
        }

        /* ── Navigation clavier ── */
        input.addEventListener('keydown', function (e) {
            var items = results.querySelectorAll('.dash-search-item');
            if (e.key === 'ArrowDown') { e.preventDefault(); setActive(activeIdx + 1); }
            if (e.key === 'ArrowUp')   { e.preventDefault(); setActive(activeIdx - 1); }
            if (e.key === 'Enter') {
                e.preventDefault();
                if (activeIdx >= 0 && items[activeIdx]) {
                    items[activeIdx].click(); /* ouvrir le résultat sélectionné */
                } else {
                    doSearch(input.value.trim()); /* lancer la recherche */
                }
            }
            if (e.key === 'Escape') { closePanel(); input.blur(); }
        });

        function doSearch(q) {
            if (q.length < 2) { closePanel(); return; }
            openPanel();
            results.innerHTML = '<div class="dash-search-loading"><span class="spinner-border spinner-border-sm text-muted" style="width:16px;height:16px;border-width:2px;"></span> Recherche en cours...</div>';
            spinner.classList.remove('d-none');
            fetch(API_URL + '?q=' + encodeURIComponent(q), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (r) { return r.json(); })
                .then(function (data) { spinner.classList.add('d-none'); render(data, q); })
                .catch(function () { spinner.classList.add('d-none'); results.innerHTML = '<div class="dash-search-empty text-danger"><i class="bi bi-exclamation-circle me-1"></i>Erreur réseau.</div>'; });
        }

        /* Bouton loupe → déclenche la recherche */
        var searchBtn = document.getElementById('dashSearchBtn');
        if (searchBtn) { searchBtn.addEventListener('click', function () { doSearch(input.value.trim()); }); }

        input.addEventListener('focus', function () { if (this.value.trim().length >= 2) openPanel(); });

        document.addEventListener('mousedown', function (e) {
            if (!wrapper.contains(e.target)) closePanel();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === '/' && document.activeElement !== input && !['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)) {
                e.preventDefault(); input.focus(); input.select();
            }
        });

        results.addEventListener('click', function (e) {
            if (e.target.closest('.dash-search-item')) closePanel();
        });
    }

    function initGtaCharts() {
        if (typeof Chart === 'undefined') return;

        // 1. Chart Statut
        var ctxStatus = document.getElementById('chartStatus');
        if (ctxStatus && !ctxStatus.dataset.chartInit) {
            ctxStatus.dataset.chartInit = 'true';
            new Chart(ctxStatus, {
                type: 'doughnut',
                data: {
                    labels: ['En service', 'En stock', 'En panne', 'Prêté', 'Au rebut'],
                    datasets: [{
                        data: [
                            {{ status_distribution['En service']|default(0) }},
                            {{ status_distribution['En stock']|default(0) }},
                            {{ status_distribution['En panne']|default(0) }},
                            {{ status_distribution['Prêté']|default(0) }},
                            {{ status_distribution['Au rebut']|default(0) }}
                        ],
                        backgroundColor: ['#16a34a', '#2563eb', '#dc3545', '#f59e0b', '#64748b'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } }
                    },
                    cutout: '62%'
                }
            });
        }

        // 2. Chart OS
        var ctxOs = document.getElementById('chartOs');
        if (ctxOs && !ctxOs.dataset.chartInit) {
            ctxOs.dataset.chartInit = 'true';
            var osLabels = [{% for item in os_distribution %}'{{ item.label|e('js') }}'{% if not loop.last %}, {% endif %}{% endfor %}];
            var osData = [{% for item in os_distribution %}{{ item.count }}{% if not loop.last %}, {% endif %}{% endfor %}];
            if (osLabels.length === 0) {
                osLabels = ['Non spécifié'];
                osData = [{{ stats.equipements_count }}];
            }
            new Chart(ctxOs, {
                type: 'bar',
                data: {
                    labels: osLabels,
                    datasets: [{
                        label: 'Équipements',
                        data: osData,
                        backgroundColor: '#E47000',
                        borderRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    indexAxis: 'y',
                    scales: {
                        x: { beginAtZero: true, ticks: { precision: 0 } },
                        y: { ticks: { font: { size: 10 } } }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }

        // 3. Chart Age
        var ctxAge = document.getElementById('chartAge');
        if (ctxAge && !ctxAge.dataset.chartInit) {
            ctxAge.dataset.chartInit = 'true';
            new Chart(ctxAge, {
                type: 'doughnut',
                data: {
                    labels: ['Récent (< 3 ans)', 'Vieillissant (3-5 ans)', 'Obsolète (> 5 ans)'],
                    datasets: [{
                        data: [
                            {{ age_distribution.recent|default(0) }},
                            {{ age_distribution.aging|default(0) }},
                            {{ age_distribution.obsolete|default(0) }}
                        ],
                        backgroundColor: ['#10b981', '#f59e0b', '#ef4444'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } }
                    },
                    cutout: '62%'
                }
            });
        }
    }

    /* Compatible Turbo Drive + chargement initial */
    document.addEventListener('turbo:load', function() {
        initDashSearch();
        initGtaCharts();
    });
    if (document.readyState !== 'loading') {
        initDashSearch();
        initGtaCharts();
    } else {
        document.addEventListener('DOMContentLoaded', function() {
            initDashSearch();
            initGtaCharts();
        });
    }
})();
</script>
{% endblock %}

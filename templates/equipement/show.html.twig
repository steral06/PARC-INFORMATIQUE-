<script>
(function() {
    'use strict';

    /* ═══ ÉTAT GLOBAL ═══════════════════════════════════════════ */
    var equipementId = {{ equipement.id }};

    /* ═══ STEPPER PAS-À-PAS INTERACTIF ═════════════════════════ */
    window.initStepper = function(targetStep) {
        var container = document.getElementById('checklistWizardContent');
        if (!container) return;

        var totalSteps = parseInt(container.getAttribute('data-total-steps'), 10) || 0;
        var defaultStep = parseInt(container.getAttribute('data-default-step'), 10) || 0;
        var statut = container.getAttribute('data-statut') || '';

        // Si la checklist est terminée et qu'aucune étape précise n'est demandée, afficher le bilan
        if (statut === 'terminee' && (targetStep === undefined || targetStep === 'bilan')) {
            window.goToBilan();
            return;
        }

        var initialStep = defaultStep;
        if (typeof targetStep === 'number' && targetStep >= 0 && targetStep < totalSteps) {
            initialStep = targetStep;
        }

        if (targetStep === 'bilan') {
            window.goToBilan();
        } else {
            window.goToStep(initialStep);
        }
    };

    window.goToStep = function(stepIndex) {
        var container = document.getElementById('checklistWizardContent');
        if (!container) return;

        var totalSteps = parseInt(container.getAttribute('data-total-steps'), 10) || 0;
        if (stepIndex < 0 || stepIndex >= totalSteps) return;

        // Cacher toutes les cartes et afficher la carte ciblée
        for (var i = 0; i < totalSteps; i++) {
            var pane = document.getElementById('stepPane_' + i);
            if (pane) pane.style.display = (i === stepIndex) ? 'block' : 'none';

            // Mettre à jour l'effet sur la pastille
            var circle = document.getElementById('stepCircle_' + i);
            var label = document.getElementById('stepMiniLabel_' + i);
            if (circle) {
                if (i === stepIndex) {
                    circle.style.transform = 'scale(1.22)';
                    circle.style.boxShadow = '0 0 0 3px rgba(228, 112, 0, 0.45)';
                    if (label) {
                        label.classList.add('fw-bold', 'text-dark');
                        label.classList.remove('text-muted');
                    }
                } else {
                    circle.style.transform = 'scale(1)';
                    circle.style.boxShadow = 'none';
                    if (label) {
                        label.classList.remove('fw-bold', 'text-dark');
                        label.classList.add('text-muted');
                    }
                }
            }
        }

        // Cacher le bilan
        var bilanPane = document.getElementById('stepPane_bilan');
        if (bilanPane) bilanPane.style.display = 'none';

        // Mettre à jour le compteur en haut
        var displayNum = document.getElementById('currentStepNumDisplay');
        if (displayNum) displayNum.textContent = (stepIndex + 1);

        // Défiler le stepper horizontal pour centrer la pastille active
        var bubble = document.getElementById('stepBubble_' + stepIndex);
        if (bubble && bubble.scrollIntoView) {
            bubble.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
    };

    window.goToBilan = function() {
        var container = document.getElementById('checklistWizardContent');
        if (!container) return;

        var totalSteps = parseInt(container.getAttribute('data-total-steps'), 10) || 0;
        for (var i = 0; i < totalSteps; i++) {
            var pane = document.getElementById('stepPane_' + i);
            if (pane) pane.style.display = 'none';
        }
        var bilanPane = document.getElementById('stepPane_bilan');
        if (bilanPane) bilanPane.style.display = 'block';

        var displayNum = document.getElementById('currentStepNumDisplay');
        if (displayNum) displayNum.textContent = 'Bilan';
    };

    window.validerEtapeStep = function(etapeId, statut, preparationId, eqId, csrfToken, stepIdx) {
        var container = document.getElementById('checklistWizardContent');
        var totalSteps = container ? (parseInt(container.getAttribute('data-total-steps'), 10) || 0) : 0;

        var obs = '';
        var obsInput = document.getElementById('obsInputStep_' + stepIdx);
        if (obsInput) obs = obsInput.value.trim();

        var body = new FormData();
        body.append('_token', csrfToken);
        body.append('statut', statut);
        if (obs) body.append('observations', obs);

        var circle = document.getElementById('stepCircle_' + stepIdx);
        if (circle) circle.style.opacity = '0.5';

        fetch('/equipements/' + eqId + '/checklist/' + preparationId + '/etape/' + etapeId + '/valider', {
            method: 'POST',
            body: body,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                if (data.checklistTerminee || stepIdx >= totalSteps - 1) {
                    window.rechargerWizard(preparationId, eqId, data.checklistTerminee, 'bilan');
                } else {
                    window.rechargerWizard(preparationId, eqId, false, stepIdx + 1);
                }
            }
        })
        .catch(function() {
            if (circle) circle.style.opacity = '1';
            alert('Erreur lors de la validation.');
        });
    };

    window.ajouterDisqueDepuisStep = function(preparationId, csrfToken, currentIdx) {
        var input = document.getElementById('inputDisqueStep_' + currentIdx);
        if (!input) return;
        var libelle = input.value.trim();
        if (!libelle) {
            alert('Veuillez renseigner le nom ou la lettre du disque.');
            return;
        }

        var body = new FormData();
        body.append('_token', csrfToken);
        body.append('libelle_disque', libelle);

        fetch('/equipements/' + equipementId + '/checklist/' + preparationId + '/ajouter-disque', {
            method: 'POST',
            body: body,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                window.rechargerWizard(preparationId, equipementId, false, currentIdx + 1);
            }
        })
        .catch(function() {
            alert('Erreur lors de l\'ajout du disque.');
        });
    };

    /* ═══ DÉMARRAGE ═════════════════════════════════════════════ */
    window.demarrerChecklist = function() {
        var form   = document.getElementById('checklistStartForm');
        var token  = document.getElementById('checklistCsrfToken');
        if (!form) return;

        afficherEcran('loading');

        var body = new FormData();
        body.append('_token', token ? token.value : '');

        fetch(form.dataset.action, { method: 'POST', body: body, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function(r) { return r.text(); })
            .then(function(html) {
                document.getElementById('checklistWizardScreen').innerHTML = html;
                afficherEcran('wizard');
                window.initStepper();
            })
            .catch(function() {
                afficherEcran('start');
                alert('Erreur lors du démarrage de la checklist.');
            });
    };

    /* ═══ PRÉPARATION NOUVELLE CHECKLIST (BOUTON DU HAUT) ══════ */
    window.preparerNouveauModal = function() {
        afficherEcran('start');
        var ws = document.getElementById('checklistWizardScreen');
        if (ws) ws.innerHTML = '';
    };

    /* ═══ CHARGER UNE CHECKLIST EXISTANTE (HISTORIQUE) ══════════ */
    window.ouvrirChecklistExistante = function(preparationId, eqId) {
        var modal = document.getElementById('modalChecklist');
        if (!modal) {
            alert('Modale introuvable.');
            return;
        }

        var bsModal = bootstrap.Modal.getOrCreateInstance(modal);

        var ws = document.getElementById('checklistWizardScreen');
        if (ws) ws.innerHTML = '';
        afficherEcran('loading');
        bsModal.show();

        fetch('/equipements/' + eqId + '/checklist/' + preparationId, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function(r) {
            if (!r.ok) throw new Error('Erreur HTTP ' + r.status);
            return r.text();
        })
        .then(function(html) {
            if (ws) ws.innerHTML = html;
            afficherEcran('wizard');
            window.initStepper();
        })
        .catch(function(err) {
            console.error(err);
            afficherEcran('start');
            alert('Impossible de charger cette session de préparation.');
        });
    };

    /* ═══ VALIDER UNE ÉTAPE ═════════════════════════════════════ */
    window.validerEtape = function(etapeId, statut, preparationId, eqId, csrfToken) {
        var obs = '';
        var obsField = document.getElementById('obs-text-' + etapeId);
        if (obsField) obs = obsField.value;

        var card = document.getElementById('etape-card-' + etapeId);
        if (card) card.style.opacity = '0.6';

        var body = new FormData();
        body.append('_token', csrfToken);
        body.append('statut', statut);
        if (obs) body.append('observations', obs);

        fetch('/equipements/' + eqId + '/checklist/' + preparationId + '/etape/' + etapeId + '/valider', {
            method: 'POST', body: body, headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    // Recharger le wizard complet pour refléter l'état
                    rechargerWizard(preparationId, eqId, data.checklistTerminee);
                }
            })
            .catch(function() {
                if (card) card.style.opacity = '1';
                alert('Erreur lors de la validation.');
            });
    };

    /* ═══ RÉ-OUVRIR UNE ÉTAPE ═══════════════════════════════════ */
    window.reouvrirEtape = function(etapeId, preparationId, eqId, csrfToken) {
        var body = new FormData();
        body.append('_token', csrfToken);
        body.append('statut', 'en_attente');

        fetch('/equipements/' + eqId + '/checklist/' + preparationId + '/etape/' + etapeId + '/valider', {
            method: 'POST', body: body, headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) rechargerWizard(preparationId, eqId, false);
            });
    };

    /* ═══ AJOUTER UN DISQUE SUPPLÉMENTAIRE ══════════════════════ */
    window.afficherAjoutDisque = function(preparationId) {
        var form = document.getElementById('ajoutDisqueForm_' + preparationId);
        if (form) form.classList.toggle('d-none');
    };

    window.ajouterDisque = function(preparationId, csrfToken) {
        var libelle = document.getElementById('libelleDisque_' + preparationId).value.trim();
        if (!libelle) { alert('Veuillez renseigner le libellé du disque (ex: E: — Archives).'); return; }

        var body = new FormData();
        body.append('_token', csrfToken);
        body.append('libelle_disque', libelle);

        fetch('/equipements/' + equipementId + '/checklist/' + preparationId + '/ajouter-disque', {
            method: 'POST', body: body, headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) rechargerWizard(preparationId, equipementId, false);
            })
            .catch(function() { alert('Erreur lors de l\'ajout du disque.'); });
    };

    /* ═══ TERMINER / ABANDONNER ════════════════════════════════ */
    window.terminerChecklist = function(preparationId, csrfToken, eqId) {
        var body = new FormData();
        body.append('_token', csrfToken);
        body.append('statut', 'terminee');

        fetch('/equipements/' + eqId + '/checklist/' + preparationId + '/cloturer', {
            method: 'POST', body: body, headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) rechargerWizard(preparationId, eqId, true);
            });
    };

    window.abandonnerChecklist = function(preparationId, csrfToken, eqId) {
        if (!confirm('Voulez-vous vraiment abandonner cette session de préparation ?')) return;

        var body = new FormData();
        body.append('_token', csrfToken);
        body.append('statut', 'abandonnee');

        fetch('/equipements/' + eqId + '/checklist/' + preparationId + '/cloturer', {
            method: 'POST', body: body, headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    afficherEcran('start');
                    location.reload();
                }
            });
    };

    /* ═══ AFFICHER UN FORMULAIRE D'OBSERVATIONS ════════════════ */
    window.afficherObsEtape = function(etapeId) {
        var form = document.getElementById('obs-form-' + etapeId);
        if (form) {
            form.classList.toggle('d-none');
            var textarea = document.getElementById('obs-text-' + etapeId);
            if (textarea && !form.classList.contains('d-none')) textarea.focus();
        }
    };

    /* ═══ UTILITAIRES ═══════════════════════════════════════════ */
    window.rechargerWizard = function(preparationId, eqId, estTerminee, targetStep) {
        afficherEcran('loading');

        fetch('/equipements/' + eqId + '/checklist/' + preparationId, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function(r) { return r.text(); })
            .then(function(html) {
                document.getElementById('checklistWizardScreen').innerHTML = html;
                afficherEcran('wizard');

                // Positionner sur l'étape cible, le bilan, ou la première étape en attente
                if (targetStep === 'bilan') {
                    window.goToBilan();
                } else if (typeof targetStep === 'number') {
                    window.goToStep(targetStep);
                } else {
                    window.initStepper();
                }

                if (estTerminee) {
                    setTimeout(function() {
                        var modal = document.getElementById('modalChecklist');
                        if (modal) {
                            modal.addEventListener('hidden.bs.modal', function() {
                                location.reload();
                            }, { once: true });
                        }
                    }, 200);
                }
            })
            .catch(function() { afficherEcran('wizard'); });
    };

    function afficherEcran(nom) {
        var screens = { start: 'checklistStartScreen', loading: 'checklistLoadingScreen', wizard: 'checklistWizardScreen' };
        Object.keys(screens).forEach(function(k) {
            var el = document.getElementById(screens[k]);
            if (el) el.classList.toggle('d-none', k !== nom);
        });
    }

})();
</script>
{% endif %}

{% endblock %}

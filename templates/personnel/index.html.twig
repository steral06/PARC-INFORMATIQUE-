{% extends 'base.html.twig' %}

{% block title %}Personnel & Intervenants | GTAC2A-IARDT{% endblock %}

{% block stylesheets %}
<style>
    /* ─── Badges de types ─── */
    .badge-type-employe {
        background-color: rgba(16, 185, 129, 0.12);
        color: #059669;
        border: 1px solid rgba(16, 185, 129, 0.3);
        font-weight: 600;
    }
    .badge-type-prestataire {
        background-color: rgba(37, 99, 235, 0.12);
        color: #2563eb;
        border: 1px solid rgba(37, 99, 235, 0.3);
        font-weight: 600;
    }
    .badge-type-stagiaire {
        background-color: rgba(147, 51, 234, 0.12);
        color: #9333ea;
        border: 1px solid rgba(147, 51, 234, 0.3);
        font-weight: 600;
    }
    .badge-type-visiteur {
        background-color: rgba(228, 112, 0, 0.12);
        color: var(--gta-orange);
        border: 1px solid rgba(228, 112, 0, 0.35);
        font-weight: 600;
    }

    [data-bs-theme="dark"] .badge-type-employe  { background-color: rgba(5, 46, 22, 0.35);   color: #6ee7b7; border-color: rgba(16, 185, 129, 0.3); }
    [data-bs-theme="dark"] .badge-type-prestataire { background-color: rgba(12, 35, 64, 0.45); color: #93c5fd; border-color: rgba(59, 130, 246, 0.3); }
    [data-bs-theme="dark"] .badge-type-stagiaire { background-color: rgba(46, 16, 101, 0.4); color: #d8b4fe; border-color: rgba(168, 85, 247, 0.3); }
    [data-bs-theme="dark"] .badge-type-visiteur  { background-color: rgba(69, 26, 3, 0.4);   color: #fbbf24; border-color: rgba(228, 112, 0, 0.4); }

    /* ─── Tableau et expand rows ─── */
    .personnel-table tr.personnel-row {
        cursor: default;
        transition: background 0.12s;
    }
    .personnel-table tr.personnel-row:hover {
        background: rgba(228, 112, 0, 0.04);
    }
    .personnel-table tr.personnel-row.is-selected {
        background: rgba(228, 112, 0, 0.08) !important;
        outline: 2px solid rgba(228, 112, 0, 0.3);
        outline-offset: -2px;
    }
    [data-bs-theme="dark"] .personnel-table tr.personnel-row:hover { background: rgba(228, 112, 0, 0.07); }
    [data-bs-theme="dark"] .personnel-table tr.personnel-row.is-selected { background: rgba(228, 112, 0, 0.13) !important; }

    /* Bordure colorée gauche selon le type */
    .personnel-table tr.personnel-row.type-employe td:first-child { border-left: 3px solid #059669; }
    .personnel-table tr.personnel-row.type-prestataire td:first-child { border-left: 3px solid #2563eb; }
    .personnel-table tr.personnel-row.type-stagiaire td:first-child { border-left: 3px solid #9333ea; }
    .personnel-table tr.personnel-row.type-visiteur td:first-child { border-left: 3px solid var(--gta-orange); }

    /* Bouton flèche d'expansion */
    .btn-expand-row {
        width: 26px;
        height: 26px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: transparent;
        color: #94a3b8;
        border-radius: 6px;
        transition: all 0.15s ease;
        cursor: pointer;
        padding: 0;
        font-size: 0.85rem;
    }
    .btn-expand-row:hover { background: rgba(0,0,0,0.06); color: var(--gta-orange); }
    .btn-expand-row.expanded { color: var(--gta-orange); transform: rotate(90deg); }
    [data-bs-theme="dark"] .btn-expand-row:hover { background: rgba(255,255,255,0.08); }

    /* Ligne d'expansion */
    tr.expand-row td {
        padding: 0 !important;
        background: transparent !important;
        border-top: none !important;
    }
    .expand-panel {
        background: rgba(248, 250, 252, 0.95);
        border-top: 1px dashed rgba(228, 112, 0, 0.25);
        border-bottom: 1px solid rgba(228, 112, 0, 0.15);
        padding: 1rem 1.25rem 1rem 3.5rem;
    }
    [data-bs-theme="dark"] .expand-panel {
        background: rgba(22, 26, 38, 0.95);
        border-color: rgba(228, 112, 0, 0.2);
    }

    .equipment-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 10px;
        border: 1px solid rgba(0,0,0,0.1);
        background: #ffffff;
        font-size: 0.82rem;
        transition: box-shadow 0.15s;
    }
    .equipment-chip:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    [data-bs-theme="dark"] .equipment-chip { background: #1c2030; border-color: rgba(255,255,255,0.1); }

    /* ─── Modale Modification groupée ─── */
    .bulk-field-card {
        border-radius: 12px;
        border: 2px solid #e2e8f0;
        background: #ffffff;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .bulk-field-card .card-header { background: #f8fafc; border-radius: 10px 10px 0 0; }
    .bulk-field-card.active-field { border-color: #E47000 !important; box-shadow: 0 4px 14px rgba(228,112,0,.15) !important; background: #FFFDFB; }
    .bulk-field-card.active-field .card-header { background: rgba(228,112,0,.08); }
    [data-bs-theme="dark"] .bulk-field-card { background: #191d28; border-color: rgba(255,255,255,.12); }
    [data-bs-theme="dark"] .bulk-field-card .card-header { background: #1e2433; }
    [data-bs-theme="dark"] .bulk-field-card.active-field { background: #202636 !important; border-color: var(--gta-orange) !important; box-shadow: 0 4px 14px rgba(228,112,0,.25) !important; }
    [data-bs-theme="dark"] .bulk-field-card.active-field .card-header { background: rgba(228,112,0,.18); }

    .type-btn-opt {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 14px; border-radius: 20px; border: 1px solid #e2e8f0;
        background: #ffffff; font-size: 0.82rem; font-weight: 500; color: #475569;
        transition: all 0.15s; cursor: pointer;
    }
    .type-btn-opt:hover { border-color: #cbd5e1; background: #f8fafc; transform: translateY(-1px); }
    .type-btn-opt.active { background: var(--gta-orange) !important; border-color: var(--gta-orange) !important; color: #fff !important; box-shadow: 0 2px 8px rgba(228,112,0,.3) !important; }
    [data-bs-theme="dark"] .type-btn-opt { background: #151822; border-color: rgba(255,255,255,.12); color: #cbd5e1; }
    [data-bs-theme="dark"] .type-btn-opt:hover { background: #232838; color: #fff; }
    [data-bs-theme="dark"] .type-btn-opt.active { background: var(--gta-orange) !important; border-color: var(--gta-orange) !important; color: #fff !important; }

    .checkbox-cell { cursor: pointer; user-select: none; }
</style>
{% endblock %}

{% block body %}
{# ── En-tête ── #}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 gap-2 flex-shrink-0">
    <div>
        <h1 class="h3 fw-bold mb-1" style="color: #121212;">Personnel &amp; Intervenants</h1>
        <p class="text-muted mb-0 small">Répertoire des employés, prestataires, stagiaires et visiteurs de GTAC2A-IARDT</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_personnel_new') }}" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm fw-bold" data-shortcut="n" title="Raccourci : N">
            <i class="bi bi-person-plus-fill fs-5"></i>
            <span>Nouveau Personnel</span>
        </a>
    </div>
</div>

{# ── Métriques Bento par Catégorie ── #}
<div class="row g-2 mb-3 flex-shrink-0">
    <div class="col-6 col-md-3 col-xl">
        <a href="{{ path('app_personnel_index') }}" class="card p-2 text-center border-0 shadow-sm text-decoration-none {% if current_type == 'all' %}border border-warning border-opacity-75{% endif %}">
            <span class="text-muted small fw-semibold text-uppercase" style="font-size: 0.68rem;">Total Effectif</span>
            <span class="fs-4 fw-bold text-dark">{{ stats.total }}</span>
            <span class="text-muted small" style="font-size: 0.7rem;">Tous profils</span>
        </a>
    </div>
    <div class="col-6 col-md-3 col-xl">
        <a href="{{ path('app_personnel_index', {'type': 'Employé'}) }}" class="card p-2 text-center border-0 shadow-sm text-decoration-none {% if current_type == 'Employé' %}border border-success border-opacity-75{% endif %}">
            <span class="text-muted small fw-semibold text-uppercase" style="font-size: 0.68rem;">👔 Employés</span>
            <span class="fs-4 fw-bold text-success">{{ stats['Employé'] ?? 0 }}</span>
            <span class="text-muted small" style="font-size: 0.7rem;">Salariés CDI / CDD</span>
        </a>
    </div>
    <div class="col-6 col-md-3 col-xl">
        <a href="{{ path('app_personnel_index', {'type': 'Prestataire'}) }}" class="card p-2 text-center border-0 shadow-sm text-decoration-none {% if current_type == 'Prestataire' %}border border-primary border-opacity-75{% endif %}">
            <span class="text-muted small fw-semibold text-uppercase" style="font-size: 0.68rem;">💼 Prestataires</span>
            <span class="fs-4 fw-bold text-primary">{{ stats['Prestataire'] ?? 0 }}</span>
            <span class="text-muted small" style="font-size: 0.7rem;">Consultants / ESN</span>
        </a>
    </div>
    <div class="col-6 col-md-3 col-xl">
        <a href="{{ path('app_personnel_index', {'type': 'Stagiaire'}) }}" class="card p-2 text-center border-0 shadow-sm text-decoration-none {% if current_type == 'Stagiaire' %}border border-purple border-opacity-75{% endif %}">
            <span class="text-muted small fw-semibold text-uppercase" style="font-size: 0.68rem;">🎓 Stagiaires</span>
            <span class="fs-4 fw-bold" style="color: #9333ea;">{{ stats['Stagiaire'] ?? 0 }}</span>
            <span class="text-muted small" style="font-size: 0.7rem;">Stages &amp; Alternances</span>
        </a>
    </div>
    <div class="col-6 col-md-3 col-xl">
        <a href="{{ path('app_personnel_index', {'type': 'Visiteur'}) }}" class="card p-2 text-center border-0 shadow-sm text-decoration-none {% if current_type == 'Visiteur' %}border border-warning border-opacity-75{% endif %}">
            <span class="text-muted small fw-semibold text-uppercase" style="font-size: 0.68rem;">🏷️ Visiteurs</span>
            <span class="fs-4 fw-bold text-warning">{{ stats['Visiteur'] ?? 0 }}</span>
            <span class="text-muted small" style="font-size: 0.7rem;">Invités temporaires</span>
        </a>
    </div>
</div>

{# ── Barre de Recherche & Filtres ── #}
<div class="card mb-3 flex-shrink-0">
    <div class="card-body p-2 px-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="q" value="{{ current_search }}" class="form-control bg-light border-start-0" placeholder="Rechercher nom, matricule, service, email..." data-shortcut="/">
                </div>
            </div>
            <div class="col-6 col-md-3">
                <select name="type" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="all">-- Toutes les catégories --</option>
                    {% for t in types %}
                        <option value="{{ t }}" {% if current_type == t %}selected{% endif %}>{{ t }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select name="service" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="all">-- Tous les services --</option>
                    {% for s in services %}
                        <option value="{{ s }}" {% if current_service == s %}selected{% endif %}>{{ s }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-dark btn-sm flex-grow-1">Filtrer</button>
                {% if current_search or current_type != 'all' or current_service != 'all' or current_statut != 'all' %}
                    <a href="{{ path('app_personnel_index') }}" class="btn btn-outline-secondary btn-sm" title="Réinitialiser filtres">
                        <i class="bi bi-x-lg"></i>
                    </a>
                {% endif %}
            </div>
        </form>
    </div>
</div>

{# ── Formulaire d'Action Groupée ── #}
<form id="bulkPersonnelForm" method="post" action="{{ path('app_personnel_bulk_action') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('personnel_bulk_action') }}">
    <input type="hidden" name="bulk_action" id="bulkActionInput" value="modify">

    {# Barre flottante contextuelle d'actions groupées #}
    <div id="bulkActionBar" class="card mb-3 border-0 shadow-sm d-none" style="background: linear-gradient(90deg, #181c24 0%, #222733 100%); color: #fff; border-radius: 12px; border-left: 4px solid var(--gta-orange) !important;">
        <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-warning text-dark fs-6 px-3 py-2 fw-bold" id="bulkCountBadge">0</span>
                <span class="fw-semibold">personnel(s) sélectionné(s)</span>
                <button type="button" class="btn btn-sm btn-link text-white-50 p-0 ms-2 text-decoration-none" onclick="deselectAllPersonnels()">
                    <i class="bi bi-x-circle me-1"></i>Tout désélectionner
                </button>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-warning text-dark fw-bold d-flex align-items-center gap-2 shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#bulkModifyPersonnelModal">
                    <i class="bi bi-pencil-square"></i>
                    <span>Modifier la sélection</span>
                </button>
                {% if is_granted('ROLE_SUPER_ADMIN') %}
                <button type="button" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1" onclick="confirmBulkDelete()">
                    <i class="bi bi-trash3"></i>
                    <span>Supprimer</span>
                </button>
                {% endif %}
            </div>
        </div>
    </div>

    {# ── Tableau du Personnel ── #}
    <div class="card shadow-sm border flex-grow-1">
        <div class="scroll-table-container">
            <table class="table table-hover align-middle mb-0 personnel-table">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 32px;" class="text-center">
                            <input type="checkbox" id="checkAllPersonnels" class="form-check-input" onchange="toggleAllBulk(this.checked)" title="Tout cocher / décocher">
                        </th>
                        <th style="width: 30px;"></th>{# flèche expand #}
                        <th>Matricule</th>
                        <th>Nom &amp; Prénoms</th>
                        <th>Catégorie</th>
                        <th>Service</th>
                        <th>Machines</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    {% for p in personnels %}
                        {% set typeClass = 'type-employe' %}
                        {% if p.type == 'Prestataire' %}{% set typeClass = 'type-prestataire' %}
                        {% elseif p.type == 'Stagiaire' %}{% set typeClass = 'type-stagiaire' %}
                        {% elseif p.type == 'Visiteur' %}{% set typeClass = 'type-visiteur' %}
                        {% endif %}

                        {% set badgeClass = 'badge-type-employe' %}
                        {% if p.type == 'Prestataire' %}{% set badgeClass = 'badge-type-prestataire' %}
                        {% elseif p.type == 'Stagiaire' %}{% set badgeClass = 'badge-type-stagiaire' %}
                        {% elseif p.type == 'Visiteur' %}{% set badgeClass = 'badge-type-visiteur' %}
                        {% endif %}

                        {# Ligne principale #}
                        <tr class="personnel-row {{ typeClass }}" data-shortcuts-target="row" data-personnel-id="{{ p.id }}">
                            <td class="text-center checkbox-cell" style="width: 32px;" onclick="handleCellClick(this, event)">
                                <input type="checkbox" name="ids[]" value="{{ p.id }}" class="form-check-input bulk-personnel-checkbox" style="cursor: pointer;">
                            </td>
                            <td style="width: 30px; padding-left: 6px;">
                                {% set activeAtts = p.activeAttributionsCount %}
                                {% if activeAtts > 0 %}
                                <button type="button"
                                    class="btn-expand-row"
                                    aria-label="Voir les équipements de {{ p.nom }}"
                                    onclick="toggleExpandRow(this, {{ p.id }})">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                                {% else %}
                                <span style="width: 26px; display: inline-block;"></span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge bg-dark text-warning font-monospace px-2 py-1 border" style="font-size: 0.78rem;">
                                    {{ p.matricule }}
                                </span>
                            </td>
                            <td>
                                <div class="fw-semibold">
                                    <a href="{{ path('app_personnel_show', {'id': p.id}) }}" class="text-decoration-none text-dark">{{ p.nom }}</a>
                                </div>
                                {% if p.email or p.telephone %}
                                    <div class="text-muted" style="font-size: 0.72rem;">
                                        {% if p.email %}<i class="bi bi-envelope me-1"></i>{{ p.email }}{% endif %}
                                        {% if p.email and p.telephone %} &bull; {% endif %}
                                        {% if p.telephone %}<i class="bi bi-telephone me-1"></i>{{ p.telephone }}{% endif %}
                                    </div>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge {{ badgeClass }} px-2 py-1 rounded-pill" style="font-size: 0.75rem;">
                                    {% if p.type == 'Employé' %}👔
                                    {% elseif p.type == 'Prestataire' %}💼
                                    {% elseif p.type == 'Stagiaire' %}🎓
                                    {% elseif p.type == 'Visiteur' %}🏷️
                                    {% endif %}
                                    {{ p.type }}
                                </span>
                            </td>
                            <td>
                                {% if p.service %}
                                    <span class="badge bg-secondary-subtle text-dark border">{{ p.service }}</span>
                                {% else %}
                                    <span class="text-muted fst-italic">—</span>
                                {% endif %}
                            </td>
                            <td>
                                {% set activeAtts = p.activeAttributionsCount %}
                                {% if activeAtts > 0 %}
                                    <span class="badge bg-success-subtle text-success border fw-bold" title="{{ activeAtts }} équipement(s) actuellement en possession">
                                        <i class="bi bi-laptop me-1"></i>{{ activeAtts }}
                                    </span>
                                {% else %}
                                    <span class="text-muted small">—</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if p.statut == 'Actif' %}
                                    <span class="badge bg-success-subtle text-success border">Actif</span>
                                {% elseif p.statut == 'Suspendu' %}
                                    <span class="badge bg-warning-subtle text-warning border">Suspendu</span>
                                {% else %}
                                    <span class="badge bg-secondary-subtle text-secondary border">Inactif</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ path('app_personnel_show', {'id': p.id}) }}" class="btn btn-outline-dark" title="Consulter la fiche">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="{{ path('app_attribution_new', {'personnel_id': p.id}) }}" class="btn btn-outline-primary" title="Attribuer un équipement" data-shortcut="a">
                                        <i class="bi bi-laptop"></i>
                                    </a>
                                    <a href="{{ path('app_personnel_edit', {'id': p.id}) }}" class="btn btn-outline-secondary" title="Modifier la fiche" data-shortcut="e">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" title="Supprimer" onclick="confirmDeleteSingle({{ p.id }}, '{{ p.nom|e('js') }}')" data-shortcut="d">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>

                        {# ── Ligne d'expansion (équipements) ── #}
                        <tr class="expand-row" id="expand-row-{{ p.id }}" style="display: none;">
                            <td colspan="9">
                                <div class="expand-panel">
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-laptop-fill text-primary"></i>
                                            <span class="fw-semibold">Équipements attribués à <strong>{{ p.nom }}</strong></span>
                                        </div>
                                        <a href="{{ path('app_attribution_new', {'personnel_id': p.id}) }}" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-plus-lg"></i>
                                            <span>Attribuer un équipement</span>
                                        </a>
                                    </div>

                                    {% set activeAttributions = [] %}
                                    {% for a in p.attributions %}
                                        {% if a.statut == 'En cours' and a.equipement %}
                                            {% set activeAttributions = activeAttributions|merge([a]) %}
                                        {% endif %}
                                    {% endfor %}

                                    {% if activeAttributions|length > 0 %}
                                        <div class="d-flex flex-wrap gap-2">
                                            {% for a in activeAttributions %}
                                                <div class="equipment-chip">
                                                    <span class="text-muted" style="font-size: 1rem;">
                                                        {% set cat = a.equipement.categorie|default('') %}
                                                        {% if cat == 'Ordinateur portable' %}💻
                                                        {% elseif cat == 'Ordinateur de bureau' %}🖥️
                                                        {% elseif cat == 'Imprimante' %}🖨️
                                                        {% elseif cat == 'Téléphone' %}📱
                                                        {% elseif cat == 'Serveur' %}🗄️
                                                        {% elseif cat == 'Écran' %}🖥
                                                        {% else %}📦{% endif %}
                                                    </span>
                                                    <div>
                                                        <div class="fw-semibold text-dark" style="font-size: 0.83rem;">{{ a.equipement.nom }}</div>
                                                        <div class="text-muted" style="font-size: 0.7rem;">
                                                            {{ a.equipement.tagInventaire ?: (a.equipement.numeroSerie ?: '—') }}
                                                            &bull; depuis {{ a.dateDebut|date('d/m/Y') }}
                                                        </div>
                                                    </div>
                                                    {# Bouton Retirer #}
                                                    <form method="post" action="{{ path('app_attribution_restituer', {'id': a.id}) }}" class="ms-auto" onsubmit="return confirm('Retirer cet équipement à {{ p.nom|e('js') }} ?')">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('restituer' ~ a.id) }}">
                                                        <input type="hidden" name="dateRestitution" value="{{ 'now'|date('Y-m-d') }}">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" title="Retirer cet équipement">
                                                            <i class="bi bi-x-circle"></i>
                                                            <span>Retirer</span>
                                                        </button>
                                                    </form>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    {% else %}
                                        <div class="text-muted small fst-italic">
                                            <i class="bi bi-inbox me-1"></i>Aucun équipement en cours d'attribution.
                                        </div>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>

                    {% else %}
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                Aucun personnel ne correspond aux critères.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</form>

{# Formulaire caché pour suppression unitaire #}
<form id="deleteSingleForm" method="post" action="" class="d-none">
    <input type="hidden" name="_token" id="deleteSingleToken" value="">
</form>
{% endblock %}

{% block modals %}
{# ── MODALE D'ACTION GROUPÉE SÉLECTIVE ── #}
<div class="modal fade" id="bulkModifyPersonnelModal" tabindex="-1" aria-labelledby="bulkModifyPersonnelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1rem; overflow: hidden;">
            <div class="modal-header border-bottom py-3 px-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0"
                         style="width: 42px; height: 42px; background: linear-gradient(135deg, var(--gta-orange) 0%, #ff8c1a 100%);">
                        <i class="bi bi-pencil-square fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="bulkModifyPersonnelModalLabel">Modification groupée du personnel</h5>
                        <span class="text-muted small">Cochez les interrupteurs pour activer les champs à appliquer</span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark px-3 py-2 fw-bold rounded-pill" id="bulkPersonnelModalCountBadge">0 sélectionné(s)</span>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
            </div>

            <div class="modal-body p-4">
                <div class="d-flex flex-column gap-3">

                    {# 1. CATÉGORIE / TYPE #}
                    <div class="card bulk-field-card shadow-sm" id="card_modify_type">
                        <div class="card-header py-2 px-3 d-flex align-items-center justify-content-between border-bottom">
                            <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
                                <input class="form-check-input bulk-field-toggle" type="checkbox" id="toggle_modify_type" name="modify_type" value="1" onchange="toggleBulkFieldSection('type')">
                                <label class="form-check-label fw-bold cursor-pointer" for="toggle_modify_type">
                                    <i class="bi bi-person-badge text-primary me-1"></i>Catégorie / Statut intervenant
                                </label>
                            </div>
                            <span class="badge bg-light text-muted border bulk-field-badge" id="badge_modify_type">
                                <i class="bi bi-dash-circle me-1"></i>Inchangé
                            </span>
                        </div>
                        <div class="card-body p-3 bulk-field-body" id="body_modify_type">
                            <label class="form-label small text-muted mb-2">Choisir la nouvelle catégorie à appliquer :</label>
                            <div class="d-flex flex-wrap gap-2">
                                {% for t in types %}
                                    <button type="button" class="type-btn-opt" data-type="{{ t }}" onclick="setBulkType('{{ t }}')">
                                        <span>
                                            {% if t == 'Employé' %}👔
                                            {% elseif t == 'Prestataire' %}💼
                                            {% elseif t == 'Stagiaire' %}🎓
                                            {% elseif t == 'Visiteur' %}🏷️
                                            {% endif %}
                                            {{ t }}
                                        </span>
                                    </button>
                                {% endfor %}
                            </div>
                            <input type="hidden" name="new_type" id="bulk_new_type" value="">
                        </div>
                    </div>

                    {# 2. SERVICE / DIRECTION #}
                    <div class="card bulk-field-card shadow-sm" id="card_modify_service">
                        <div class="card-header py-2 px-3 d-flex align-items-center justify-content-between border-bottom">
                            <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
                                <input class="form-check-input bulk-field-toggle" type="checkbox" id="toggle_modify_service" name="modify_service" value="1" onchange="toggleBulkFieldSection('service')">
                                <label class="form-check-label fw-bold cursor-pointer" for="toggle_modify_service">
                                    <i class="bi bi-diagram-3 text-success me-1"></i>Service / Direction
                                </label>
                            </div>
                            <span class="badge bg-light text-muted border bulk-field-badge" id="badge_modify_service">
                                <i class="bi bi-dash-circle me-1"></i>Inchangé
                            </span>
                        </div>
                        <div class="card-body p-3 bulk-field-body" id="body_modify_service">
                            <label for="bulk_new_service_input" class="form-label small text-muted mb-1">Nouveau service d'affectation :</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-building"></i></span>
                                <input type="text" name="new_service" id="bulk_new_service_input" class="form-control" placeholder="Ex: PRODUCTION, SANTE, DSI..." list="services_bulk_datalist" oninput="activateBulkField('service')" onfocus="activateBulkField('service')">
                            </div>
                            <datalist id="services_bulk_datalist">
                                {% for s in services %}
                                    <option value="{{ s }}">
                                {% endfor %}
                            </datalist>
                        </div>
                    </div>

                    {# 3. STATUT OPÉRATIONNEL #}
                    <div class="card bulk-field-card shadow-sm" id="card_modify_statut">
                        <div class="card-header py-2 px-3 d-flex align-items-center justify-content-between border-bottom">
                            <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
                                <input class="form-check-input bulk-field-toggle" type="checkbox" id="toggle_modify_statut" name="modify_statut" value="1" onchange="toggleBulkFieldSection('statut')">
                                <label class="form-check-label fw-bold cursor-pointer" for="toggle_modify_statut">
                                    <i class="bi bi-check2-circle text-info me-1"></i>Statut opérationnel
                                </label>
                            </div>
                            <span class="badge bg-light text-muted border bulk-field-badge" id="badge_modify_statut">
                                <i class="bi bi-dash-circle me-1"></i>Inchangé
                            </span>
                        </div>
                        <div class="card-body p-3 bulk-field-body" id="body_modify_statut">
                            <select name="new_statut" id="bulk_new_statut" class="form-select" onchange="activateBulkField('statut')">
                                <option value="Actif">🟢 Actif (En poste)</option>
                                <option value="Inactif">⚪ Inactif / Parti</option>
                                <option value="Suspendu">🟡 Suspendu</option>
                            </select>
                        </div>
                    </div>

                    {# 4. NOTES / REMARQUES #}
                    <div class="card bulk-field-card shadow-sm" id="card_modify_notes">
                        <div class="card-header py-2 px-3 d-flex align-items-center justify-content-between border-bottom">
                            <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
                                <input class="form-check-input bulk-field-toggle" type="checkbox" id="toggle_modify_notes" name="modify_notes" value="1" onchange="toggleBulkFieldSection('notes')">
                                <label class="form-check-label fw-bold cursor-pointer" for="toggle_modify_notes">
                                    <i class="bi bi-chat-left-text text-secondary me-1"></i>Notes &amp; Remarques
                                </label>
                            </div>
                            <span class="badge bg-light text-muted border bulk-field-badge" id="badge_modify_notes">
                                <i class="bi bi-dash-circle me-1"></i>Inchangé
                            </span>
                        </div>
                        <div class="card-body p-3 bulk-field-body" id="body_modify_notes">
                            <textarea name="new_notes" id="bulk_new_notes" class="form-control" rows="2" placeholder="Ajouter une mention pour l'ensemble des personnels sélectionnés..." oninput="activateBulkField('notes')" onfocus="activateBulkField('notes')"></textarea>
                        </div>
                    </div>

                </div>
            </div>

            <div class="modal-footer border-top py-3 px-4 d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-warning text-dark fw-bold px-4 shadow-sm" onclick="submitBulkModify()">
                    <i class="bi bi-check2-all me-1"></i>Appliquer aux personnels sélectionnés
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// ── Sélection par case à cocher ──
const selectedPersonnelIds = new Set();

function updateBulkBar() {
    const checkboxes = document.querySelectorAll('.bulk-personnel-checkbox');
    selectedPersonnelIds.clear();
    checkboxes.forEach(cb => { if (cb.checked) selectedPersonnelIds.add(cb.value); });

    const count = selectedPersonnelIds.size;
    const bar = document.getElementById('bulkActionBar');
    const badge = document.getElementById('bulkCountBadge');
    const checkAll = document.getElementById('checkAllPersonnels');
    const modalBadge = document.getElementById('bulkPersonnelModalCountBadge');

    if (count > 0) { bar.classList.remove('d-none'); badge.textContent = count; }
    else { bar.classList.add('d-none'); badge.textContent = '0'; }

    if (modalBadge) modalBadge.textContent = `${count} sélectionné(s)`;
    if (checkAll) {
        checkAll.checked = (checkboxes.length > 0 && count === checkboxes.length);
        checkAll.indeterminate = (count > 0 && count < checkboxes.length);
    }
}

function toggleAllBulk(checked) {
    document.querySelectorAll('.bulk-personnel-checkbox').forEach(cb => { cb.checked = checked; });
    updateBulkBar();
}

function deselectAllPersonnels() { toggleAllBulk(false); }

function handleCellClick(td, event) {
    if (event.target.tagName !== 'INPUT') {
        const cb = td.querySelector('input[type="checkbox"]');
        if (cb) { cb.checked = !cb.checked; updateBulkBar(); }
    }
}

document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.bulk-personnel-checkbox').forEach(cb => cb.addEventListener('change', updateBulkBar));
});

// ── Expand rows ──
function toggleExpandRow(btn, personnelId) {
    const expandRow = document.getElementById('expand-row-' + personnelId);
    if (!expandRow) return;
    const isOpen = expandRow.style.display !== 'none';
    if (isOpen) {
        expandRow.style.display = 'none';
        btn.classList.remove('expanded');
    } else {
        expandRow.style.display = '';
        btn.classList.add('expanded');
    }
}

// ── Modale de modification groupée ──
function setBulkType(type) {
    document.querySelectorAll('.type-btn-opt').forEach(btn => btn.classList.toggle('active', btn.getAttribute('data-type') === type));
    document.getElementById('bulk_new_type').value = type;
    activateBulkField('type');
}

function activateBulkField(field) {
    const toggle = document.getElementById('toggle_modify_' + field);
    if (toggle && !toggle.checked) { toggle.checked = true; syncBulkFieldState(field); }
}

function toggleBulkFieldSection(field) { syncBulkFieldState(field); }

function syncBulkFieldState(field) {
    const toggle = document.getElementById('toggle_modify_' + field);
    const card   = document.getElementById('card_modify_'   + field);
    const badge  = document.getElementById('badge_modify_'  + field);
    if (toggle && toggle.checked) {
        card.classList.add('active-field');
        badge.className = 'badge bg-warning text-dark border bulk-field-badge';
        badge.innerHTML = '<i class="bi bi-check2 me-1"></i>Sera appliqué';
    } else {
        card.classList.remove('active-field');
        badge.className = 'badge bg-light text-muted border bulk-field-badge';
        badge.innerHTML = '<i class="bi bi-dash-circle me-1"></i>Inchangé';
    }
}

function submitBulkModify() {
    const fields = ['type', 'service', 'statut', 'notes'];
    const activeFields = fields.filter(f => { const t = document.getElementById('toggle_modify_' + f); return t && t.checked; });

    if (activeFields.length === 0) { alert('Veuillez activer au moins un champ à modifier.'); return; }
    if (selectedPersonnelIds.size === 0) { alert('Aucun personnel sélectionné.'); return; }

    if (confirm(`Appliquer ces modifications à ${selectedPersonnelIds.size} personnel(s) sélectionné(s) ?`)) {
        const form = document.getElementById('bulkPersonnelForm');
        document.getElementById('bulkActionInput').value = 'modify';

        form.querySelectorAll('input[name="ids[]"]').forEach(el => el.remove());
        selectedPersonnelIds.forEach(id => {
            const hidden = document.createElement('input');
            hidden.type = 'hidden'; hidden.name = 'ids[]'; hidden.value = id;
            form.appendChild(hidden);
        });

        const modal = document.getElementById('bulkModifyPersonnelModal');
        if (modal) {
            modal.querySelectorAll('input, select, textarea').forEach(el => {
                if (!el.name) return;
                if ((el.type === 'checkbox' || el.type === 'radio') && !el.checked) return;
                let existing = form.querySelector('[name="' + el.name + '"]');
                if (existing) { existing.value = el.value; }
                else {
                    const hidden = document.createElement('input');
                    hidden.type = 'hidden'; hidden.name = el.name; hidden.value = el.value;
                    form.appendChild(hidden);
                }
            });
        }
        form.submit();
    }
}

function confirmBulkDelete() {
    if (selectedPersonnelIds.size === 0) return;
    if (confirm(`ATTENTION : Supprimer définitivement les ${selectedPersonnelIds.size} personnels sélectionnés ?`)) {
        document.getElementById('bulkActionInput').value = 'delete';
        document.getElementById('bulkPersonnelForm').submit();
    }
}

function confirmDeleteSingle(id, nom) {
    if (confirm(`Supprimer définitivement le personnel « ${nom} » ?`)) {
        const form = document.getElementById('deleteSingleForm');
        form.action = `/personnel/${id}`;
        document.getElementById('deleteSingleToken').value = `{{ csrf_token('delete_personnel_') }}${id}`;
        form.submit();
    }
}
</script>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Sauvegardes & Sécurité des Postes | GTAC2A-IARDT{% endblock %}

{% block body %}
{# En-tête de la page #}
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-3 gap-2 flex-shrink-0">
    <div>
        <h1 class="h3 fw-bold mb-1" style="color: #121212;">Sauvegardes & Restauration Postes</h1>
        <p class="text-muted mb-0 small">Points de restauration système à distance et sauvegarde incrémentielle des fichiers utilisateurs (Bureau, Documents, Maquettes)</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" 
                class="btn btn-warning d-inline-flex align-items-center gap-2 shadow-sm text-dark fw-semibold" 
                data-bs-toggle="modal" 
                data-bs-target="#modalAutorisationBackup"
                data-action="CAMPAGNE"
                data-equipement-id="0"
                data-machine-name="Tous les ordinateurs du parc (Campagne Globale)"
                data-beneficiaire="Ensemble des collaborateurs du domaine"
                onclick="window.ouvrirModalAutorisation('CAMPAGNE', 0, 'Tous les ordinateurs du parc (Campagne Globale)', 'Ensemble des collaborateurs du domaine')">
            <i class="bi bi-broadcast"></i>
            <span>⚡ Campagne Points de Restauration</span>
        </button>
    </div>
</div>

{# Cartes de statut global #}
<div class="row g-2 mb-3 flex-shrink-0">
    <div class="col-6 col-md-3">
        <div class="card p-2 text-center border-0 shadow-sm h-100">
            <span class="text-muted small">Total Postes Clients</span>
            <span class="fs-4 fw-bold text-dark">{{ stats.total }}</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card p-2 text-center border-0 shadow-sm h-100 border-start border-4 border-success">
            <span class="text-muted small">🛡️ Postes Sécurisés (&lt; 7j)</span>
            <span class="fs-4 fw-bold text-success">{{ stats.securises }}</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card p-2 text-center border-0 shadow-sm h-100 border-start border-4 border-warning">
            <span class="text-muted small">⚠️ À Renouveler (&gt; 7j)</span>
            <span class="fs-4 fw-bold text-warning">{{ stats.a_renouveler }}</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card p-2 text-center border-0 shadow-sm h-100 border-start border-4 border-danger">
            <span class="text-muted small">🚨 Non Protégés / En retard</span>
            <span class="fs-4 fw-bold text-danger">{{ stats.danger }}</span>
        </div>
    </div>
</div>

{# Recherche & Filtres #}
<div class="card mb-3 flex-shrink-0">
    <div class="card-body p-2 px-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="q" value="{{ current_search }}" class="form-control bg-light border-start-0" placeholder="Rechercher par bénéficiaire, machine, service, IP..." data-shortcut="/">
                </div>
            </div>
            <div class="col-6 col-md-4">
                <select name="securite" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="all" {{ current_securite == 'all' ? 'selected' : '' }}>-- Tous les états de sécurité --</option>
                    <option value="excellent" {{ current_securite == 'excellent' ? 'selected' : '' }}>🛡️ Sécurisé (Récent)</option>
                    <option value="warning" {{ current_securite == 'warning' ? 'selected' : '' }}>⚠️ À renouveler</option>
                    <option value="danger" {{ current_securite == 'danger' ? 'selected' : '' }}>🚨 Non protégé / En retard</option>
                </select>
            </div>
            <div class="col-6 col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-dark w-100">Filtrer</button>
                {% if current_search is not empty or current_securite != 'all' %}
                    <a href="{{ path('app_sauvegarde_poste_index') }}" class="btn btn-outline-secondary btn-sm" title="Réinitialiser les filtres">
                        <i class="bi bi-x-lg"></i>
                    </a>
                {% endif %}
            </div>
        </form>
    </div>
</div>

{# ═══════════════════════════════════════════════════════════════════════════
    Layout côte à côte : Tableau des postes (gauche) + Journal ops (droite)
    Couleurs 100% Bootstrap (data-bs-theme compatible light/dark)
═══════════════════════════════════════════════════════════════════════════ #}
<div class="d-flex gap-3 align-items-start" style="min-height: 0;">

    {# ── PANNEAU GAUCHE : Tableau des postes ── #}
    <div class="card flex-grow-1 shadow-sm overflow-hidden" style="min-width: 0; border: 1px solid var(--bs-border-color);">

        {# En-tête — utilise les classes Bootstrap body-secondary adaptatives #}
        <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center border-bottom">
            <div class="d-flex align-items-center gap-2">
                <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width: 30px; height: 30px;">
                    <i class="bi bi-hdd-network-fill text-primary" style="font-size: 0.82rem;"></i>
                </div>
                <div>
                    <div class="fw-bold text-body" style="font-size: 0.85rem; letter-spacing: 0.02em;">
                        Parc Informatique — Domaine GTAC2A
                    </div>
                    <div class="text-primary" style="font-size: 0.7rem; opacity: 0.85;">
                        Surveillance &amp; Protection des postes clients
                    </div>
                </div>
            </div>
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 d-flex align-items-center gap-1"
                  style="font-size: 0.72rem;">
                <i class="bi bi-pc-display-horizontal"></i>
                {{ ordinateurs|length }} poste(s) surveillé(s)
            </span>
        </div>

        {# Tableau défilant #}
        <div style="overflow-y: auto; max-height: 520px;">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.82rem;">
                <thead class="table-light sticky-top" style="z-index: 2;">
                    <tr class="border-bottom-2">
                        <th class="py-2 px-3 text-uppercase text-body-secondary fw-semibold" style="font-size: 0.68rem; letter-spacing: 0.06em;">Poste / Machine</th>
                        <th class="py-2 px-3 text-uppercase text-body-secondary fw-semibold" style="font-size: 0.68rem; letter-spacing: 0.06em;">Bénéficiaire</th>
                        <th class="py-2 px-3 text-uppercase text-body-secondary fw-semibold" style="font-size: 0.68rem; letter-spacing: 0.06em;">OS</th>
                        <th class="py-2 px-3 text-uppercase text-body-secondary fw-semibold" style="font-size: 0.68rem; letter-spacing: 0.06em;">Dernier Point</th>
                        <th class="py-2 px-3 text-uppercase text-body-secondary fw-semibold" style="font-size: 0.68rem; letter-spacing: 0.06em;">Dernière Sauvegarde</th>
                        <th class="py-2 px-3 text-uppercase text-body-secondary fw-semibold" style="font-size: 0.68rem; letter-spacing: 0.06em;">Sécurité</th>
                        <th class="py-2 px-3 text-end text-uppercase text-body-secondary fw-semibold" style="font-size: 0.68rem; letter-spacing: 0.06em;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in ordinateurs %}
                        {% set eq = item.equipement %}
                        <tr id="row-pc-{{ eq.id }}">
                            <td class="py-2 px-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded bg-body-secondary d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width: 30px; height: 30px;">
                                        <i class="bi bi-laptop text-body-secondary" style="font-size: 0.85rem;"></i>
                                    </div>
                                    <div>
                                        <a href="javascript:void(0)" class="fw-bold text-body text-decoration-none" style="font-size: 0.82rem;" onclick="window.ouvrirFichePoste({{ eq.id }})" title="Consulter la fiche détaillée du poste">
                                            {{ item.nom }} <i class="bi bi-box-arrow-up-right ms-1 text-primary" style="font-size: 0.65rem;"></i>
                                        </a>
                                        <div class="text-body-secondary d-flex align-items-center gap-1" style="font-size: 0.7rem;">
                                            <span class="font-monospace">{{ item.ip }}</span>
                                            <button type="button"
                                                    class="btn p-0 border-0 bg-transparent lh-1"
                                                    title="Test Ping en direct"
                                                    onclick="window.testerPingLigne({{ eq.id }}, this)">
                                                <i class="bi bi-activity text-primary" style="font-size: 0.75rem;"></i>
                                                <span class="ping-lbl" style="font-size: 0.68rem;">Ping</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-2 px-3">
                                {% if item.beneficiaire %}
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                                             style="width: 28px; height: 28px; font-size: 0.72rem;">
                                            {{ item.beneficiaire|slice(0, 2)|upper }}
                                        </div>
                                        <div style="min-width: 0;">
                                            <div class="fw-semibold text-body text-truncate" style="max-width: 150px; font-size: 0.8rem;" title="{{ item.beneficiaire }}">
                                                {{ item.beneficiaire }}
                                            </div>
                                            {% if item.beneficiaire_service %}
                                                <span class="text-body-secondary" style="font-size: 0.68rem;">
                                                    <i class="bi bi-building"></i> {{ item.beneficiaire_service }}
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% else %}
                                    <span class="text-body-secondary" style="font-size: 0.75rem;">
                                        <i class="bi bi-dash-circle"></i> Libre
                                    </span>
                                {% endif %}
                            </td>
                            <td class="py-2 px-3">
                                {% if item.os %}
                                    <span class="badge bg-body-secondary text-body border" style="font-size: 0.68rem;">{{ item.os }}</span>
                                {% else %}
                                    <span class="text-body-secondary" style="font-size: 0.72rem;">—</span>
                                {% endif %}
                            </td>
                            <td class="py-2 px-3">
                                {% if item.dernier_point %}
                                    <div class="fw-semibold text-body" style="font-size: 0.75rem;">
                                        <i class="bi bi-clock-history text-primary me-1"></i>{{ item.dernier_point.dateExecution|date('d/m/y H:i') }}
                                    </div>
                                    <span class="badge bg-primary-subtle text-primary" style="font-size: 0.65rem;">
                                        {{ item.dernier_point.tailleEstimee ?: 'Actif' }}
                                    </span>
                                {% else %}
                                    <span class="badge bg-danger-subtle text-danger" style="font-size: 0.68rem;">Aucun</span>
                                {% endif %}
                            </td>
                            <td class="py-2 px-3">
                                {% if item.derniere_sauvegarde %}
                                    <div class="fw-semibold text-body" style="font-size: 0.75rem;">
                                        <i class="bi bi-check2-circle text-success me-1"></i>{{ item.derniere_sauvegarde.dateExecution|date('d/m/y H:i') }}
                                    </div>
                                    <span class="badge bg-success-subtle text-success" style="font-size: 0.65rem;">Incrémentiel</span>
                                {% else %}
                                    <span class="badge bg-warning-subtle text-warning-emphasis" style="font-size: 0.68rem;">Jamais</span>
                                {% endif %}
                            </td>
                            <td class="py-2 px-3">
                                <span class="badge {{ item.securite.badge }} d-inline-flex align-items-center gap-1" style="font-size: 0.7rem;">
                                    <i class="bi {{ item.securite.icone }}"></i>
                                    {{ item.securite.label }}
                                </span>
                            </td>
                            <td class="py-2 px-3 text-end">
                                {% set labelBenef = item.beneficiaire ? (item.beneficiaire ~ (item.beneficiaire_service ? ' (' ~ item.beneficiaire_service ~ ')' : '')) : 'Non attribué' %}
                                <div class="d-flex justify-content-end gap-1 flex-nowrap">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1"
                                            style="font-size: 0.72rem;"
                                            title="Consulter la fiche complète de sécurité du poste"
                                            onclick="window.ouvrirFichePoste({{ eq.id }})">
                                        <i class="bi bi-eye"></i>
                                        <span>Fiche</span>
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1"
                                            style="font-size: 0.72rem;"
                                            title="Point de Restauration Windows à distance"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalAutorisationBackup"
                                            data-action="POINT_RESTAURATION"
                                            data-equipement-id="{{ eq.id }}"
                                            data-machine-name="{{ item.nom|e('html_attr') }}"
                                            data-beneficiaire="{{ labelBenef|e('html_attr') }}"
                                            data-code-inventaire="{{ item.code_inventaire|e('html_attr') }}"
                                            data-session="{{ item.session_suggeree|e('html_attr') }}"
                                            data-preview-path="{{ item.preview_path|e('html_attr') }}"
                                            onclick="window.ouvrirModalAutorisation('POINT_RESTAURATION', {{ eq.id }}, '{{ item.nom|e('js') }}', '{{ labelBenef|e('js') }}', '{{ item.code_inventaire|e('js') }}', '{{ item.session_suggeree|e('js') }}', '{{ item.preview_path|e('js') }}')">
                                        <i class="bi bi-lightning-charge-fill"></i>
                                        <span>Point</span>
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1"
                                            style="font-size: 0.72rem;"
                                            title="Sauvegarde Incrémentielle : Documents, Bureau, Musique, Vidéos, Images, Téléchargements"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalAutorisationBackup"
                                            data-action="SAUVEGARDE_PROFIL"
                                            data-equipement-id="{{ eq.id }}"
                                            data-machine-name="{{ item.nom|e('html_attr') }}"
                                            data-beneficiaire="{{ labelBenef|e('html_attr') }}"
                                            data-code-inventaire="{{ item.code_inventaire|e('html_attr') }}"
                                            data-session="{{ item.session_suggeree|e('html_attr') }}"
                                            data-preview-path="{{ item.preview_path|e('html_attr') }}"
                                            onclick="window.ouvrirModalAutorisation('SAUVEGARDE_PROFIL', {{ eq.id }}, '{{ item.nom|e('js') }}', '{{ labelBenef|e('js') }}', '{{ item.code_inventaire|e('js') }}', '{{ item.session_suggeree|e('js') }}', '{{ item.preview_path|e('js') }}')">
                                        <i class="bi bi-cloud-arrow-up-fill"></i>
                                        <span>Sauvegarder</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="bi bi-pc-display text-body-secondary fs-1 d-block mb-2"></i>
                                <h6 class="fw-bold text-body">Aucun ordinateur trouvé</h6>
                                <p class="text-body-secondary small mb-0">Ajoutez des ordinateurs fixes ou portables dans le menu Matériels.</p>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# ── PANNEAU DROIT : Journal des opérations ── #}
    <div class="card shadow-sm flex-shrink-0 overflow-hidden" style="width: 400px; min-width: 340px; border: 1px solid var(--bs-border-color);">

        {# En-tête journal — classes Bootstrap pures #}
        <div class="card-header py-2 px-3 d-flex align-items-center justify-content-between border-bottom">
            <div class="d-flex align-items-center gap-2">
                {# Indicateur live pulsant #}
                <div class="position-relative flex-shrink-0" style="width: 10px; height: 10px;">
                    <span class="position-absolute top-0 start-0 w-100 h-100 rounded-circle bg-success"
                          style="animation: gparc-pulse 2s ease-in-out infinite; opacity: 0.6;"></span>
                    <span class="position-absolute top-0 start-0 w-100 h-100 rounded-circle bg-success"></span>
                </div>
                <div>
                    <div class="fw-bold text-body" style="font-size: 0.83rem; letter-spacing: 0.03em;">
                        Journal des Opérations
                    </div>
                    <div class="text-success" style="font-size: 0.68rem; letter-spacing: 0.04em; opacity: 0.9;">
                        LIVE · Audit Trail · G-PARC
                    </div>
                </div>
            </div>
            <span class="badge bg-success-subtle text-success border border-success border-opacity-25"
                  style="font-size: 0.68rem;">
                {{ historique|length }} entrée(s)
            </span>
        </div>

        {# Timeline défilante — fond adaptatif #}
        <div id="journal-feed" class="bg-body-tertiary"
             style="overflow-y: auto; max-height: 520px; padding: 12px 14px;">

            {% if historique is empty %}
                <div class="d-flex flex-column align-items-center justify-content-center py-5 text-body-secondary">
                    <div class="rounded-circle bg-body-secondary d-flex align-items-center justify-content-center mb-3"
                         style="width: 52px; height: 52px;">
                        <i class="bi bi-journal-x fs-4"></i>
                    </div>
                    <div class="fw-semibold small">Aucune opération enregistrée</div>
                    <div class="text-body-secondary text-center" style="font-size: 0.72rem; max-width: 220px; margin-top: 4px;">
                        Le journal se remplit automatiquement après chaque action de protection.
                    </div>
                </div>
            {% else %}
                {% for h in historique %}
                    {% set isPoint   = h.isPointRestauration %}
                    {% set iconClass = isPoint ? 'bi-lightning-charge-fill' : 'bi-cloud-arrow-up-fill' %}
                    {% set typeLabel = isPoint ? 'Point Restauration' : 'Sauvegarde Profil' %}
                    {% set badgeType = isPoint ? 'bg-primary-subtle text-primary' : 'bg-success-subtle text-success' %}

                    <div class="journal-entry d-flex gap-2 mb-3"
                         style="animation: gparc-fadein 0.3s ease both;">

                        {# Colonne icône + trait vertical #}
                        <div class="d-flex flex-column align-items-center flex-shrink-0" style="width: 30px;">
                            <div class="rounded-circle {{ badgeType }} d-flex align-items-center justify-content-center flex-shrink-0 border"
                                 style="width: 26px; height: 26px;">
                                <i class="bi {{ iconClass }}" style="font-size: 0.72rem;"></i>
                            </div>
                            {% if not loop.last %}
                                <div class="bg-border flex-grow-1 my-1" style="width: 1.5px; min-height: 10px; background: var(--bs-border-color);"></div>
                            {% endif %}
                        </div>

                        {# Contenu #}
                        <div class="flex-grow-1 pb-1" style="min-width: 0;">
                            <div class="d-flex justify-content-between align-items-baseline gap-1 mb-1">
                                <div class="fw-bold text-body text-truncate" style="font-size: 0.8rem; max-width: 170px;" title="{{ h.nomMachine }}">
                                    <i class="bi bi-laptop me-1 text-body-secondary" style="font-size: 0.68rem;"></i>{{ h.nomMachine }}
                                </div>
                                <span class="text-body-secondary font-monospace flex-shrink-0" style="font-size: 0.64rem;">
                                    {{ h.dateExecution|date('d/m H:i') }}
                                </span>
                            </div>

                            <div class="d-flex align-items-center flex-wrap gap-1 mb-1">
                                <span class="badge {{ badgeType }} border d-inline-flex align-items-center gap-1"
                                      style="font-size: 0.64rem; font-weight: 600;">
                                    <i class="bi {{ iconClass }}"></i>{{ typeLabel }}
                                </span>
                                <span class="badge bg-success-subtle text-success" style="font-size: 0.62rem;">
                                    <i class="bi bi-check-circle-fill"></i> Succès
                                </span>
                                {% if h.tailleEstimee %}
                                    <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.62rem;">
                                        {{ h.tailleEstimee }}
                                    </span>
                                {% endif %}
                            </div>

                            <div class="d-flex justify-content-between align-items-end gap-1">
                                <div class="text-body-secondary text-truncate" style="font-size: 0.69rem; max-width: 230px; line-height: 1.3;"
                                     title="{{ h.details }}">
                                    {{ h.details|split('\n')|first }}
                                </div>
                                <span class="text-body-secondary fw-semibold flex-shrink-0" style="font-size: 0.62rem; white-space: nowrap;">
                                    <i class="bi bi-person-badge-fill me-1"></i>{{ h.lancePar ?: 'admin' }}
                                </span>
                            </div>
                        </div>
                    </div>
                {% endfor %}

                <div class="text-center mt-2 text-body-secondary" style="font-size: 0.64rem; letter-spacing: 0.06em;">
                    <i class="bi bi-three-dots"></i> FIN DU JOURNAL · {{ historique|length }} opération(s) <i class="bi bi-three-dots"></i>
                </div>
            {% endif %}
        </div>

        {# Pied adaptatif #}
        <div class="card-footer border-top py-2 px-3 d-flex justify-content-between align-items-center bg-body-tertiary"
             style="font-size: 0.68rem;">
            <span class="text-body-secondary"><i class="bi bi-arrow-clockwise me-1"></i>Actualisé à chaque action</span>
            <span id="journal-last-update" class="font-monospace text-body-secondary">
                {{ "now"|date('H:i:s') }}
            </span>
        </div>
    </div>

</div>{# /d-flex gap-3 #}

<style>
@keyframes gparc-pulse {
    0%, 100% { transform: scale(1); opacity: 0.6; }
    50%       { transform: scale(2.4); opacity: 0; }
}
@keyframes gparc-fadein {
    from { opacity: 0; transform: translateY(5px); }
    to   { opacity: 1; transform: translateY(0); }
}
/* Sticky thead dans un div overflow-y */
.card .table thead th { position: sticky; top: 0; z-index: 2; }
</style>

{% endblock %}

{% block modals %}
{# ═══════════════════════════════════════════════════════════════════════════
   Modale Fiche Détaillée de Sécurité, Sauvegarde & Continuité du Poste
═══════════════════════════════════════════════════════════════════════════ #}
<div class="modal fade" id="modalFichePoste" tabindex="-1" aria-labelledby="modalFichePosteLabel" aria-hidden="true" style="z-index: 1055;">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom py-2 px-3 bg-body-tertiary">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-shield-check text-primary fs-5"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h5 class="modal-title fw-bold text-body mb-0" id="fiche-nom-machine">PC-COMPTA-01</h5>
                            <span class="badge bg-secondary-subtle text-body border" id="fiche-os-badge">Windows</span>

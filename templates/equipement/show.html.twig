{% extends 'base.html.twig' %}

{% block title %}{{ equipement.nom }} | GTAC2A-IARDT{% endblock %}

{% block stylesheets %}
<style>
    [data-bs-theme="dark"] #quickPersonnelCardPreview {
        background: #191e2b !important;
        border-color: rgba(255, 255, 255, 0.08) !important;
    }
    [data-bs-theme="dark"] #quickPreviewNom {
        color: #f8fafc !important;
    }
</style>
{% endblock %}

{% block body %}
<div class="mb-3 flex-shrink-0">
    <a href="{{ path('app_equipement_index') }}" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 mb-2">
        <i class="bi bi-arrow-left"></i>
        <span>Retour à l'inventaire</span>
    </a>
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color: #121212;">{{ equipement.nom }}</h1>
            <p class="text-muted mb-0 small">
                {{ equipement.marque }} &bull; {{ equipement.modele }} &bull; N° Série : <strong class="font-monospace text-dark">{{ equipement.numeroSerie }}</strong>
            </p>
        </div>
        <div class="d-flex gap-2">
            {# Bouton PDF grisé pour version ultérieure #}
            <button type="button"
                    class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 shadow-sm opacity-50"
                    disabled
                    title="Export PDF bientôt disponible (version ultérieure)"
                    style="cursor: not-allowed;">
                <i class="bi bi-file-earmark-pdf text-secondary"></i>
                <span>PDF</span>
                <span class="badge bg-secondary-subtle text-secondary border ms-1" style="font-size: 0.65rem;">Bientôt</span>
            </button>
            {# ── Bouton Préparer / Vérifier (Ordinateurs En stock ou En service uniquement) ── #}
            {% if equipement.isEligiblePreparation %}
            <button type="button"
                    class="btn btn-sm d-inline-flex align-items-center gap-1 shadow-sm fw-semibold"
                    style="background: linear-gradient(135deg,#111317,#2d3748); color:#fff; border:none;"
                    data-bs-toggle="modal"
                    data-bs-target="#modalChecklist"
                    onclick="window.preparerNouveauModal()"
                    title="Lancer la vérification étape par étape de la machine">
                <i class="bi bi-clipboard2-check{% if equipement.statut == 'En service' %}-fill{% endif %}"></i>
                <span>{% if equipement.statut == 'En service' %}Sauvegarder &amp; Préparer{% else %}Préparer{% endif %}</span>
            </button>
            {% endif %}
            <button type="button"
                    class="btn btn-dark btn-sm d-inline-flex align-items-center gap-1 shadow-sm"
                    id="btnAttribuerRapide"
                    data-bs-toggle="modal"
                    data-bs-target="#modalAttribuerRapide">
                <i class="bi bi-person-plus"></i>
                <span>Attribuer</span>
            </button>
            <a href="{{ path('app_maintenance_new', {'equipement_id': equipement.id}) }}" class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-tools"></i>
                <span>Signaler Panne</span>
            </a>
            <a href="{{ path('app_equipement_edit', {'id': equipement.id}) }}" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 shadow-sm" data-shortcut="m" title="Raccourci : M">
                <i class="bi bi-pencil"></i>
                <span>Modifier</span>
            </a>
        </div>
    </div>
</div>

<div class="row g-4 align-items-start">
    <!-- COLONNE GAUCHE (Fiche Spécifications FIXE sous les yeux) -->
    <div class="col-12 col-lg-5" style="position: sticky; top: 0;">
        <div class="card card-form mb-3">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <span class="fw-bold small"><i class="bi bi-pc-display me-1 text-primary"></i> Spécifications</span>
                {% if equipement.statut == 'En service' %}
                    <span class="badge bg-success-subtle text-success border border-success-subtle">En service</span>
                {% elseif equipement.statut == 'En stock' %}
                    <span class="badge bg-secondary-subtle text-dark border">En stock</span>
                {% elseif equipement.statut == 'En panne' %}
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">En panne</span>
                {% else %}
                    <span class="badge bg-warning-subtle text-dark border">{{ equipement.statut }}</span>
                {% endif %}
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted">Numéro de série (S/N)</span>
                        <strong class="font-monospace text-dark">{{ equipement.numeroSerie }}</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted">Code inventaire</span>
                        <span class="badge bg-light text-dark border font-monospace">{{ equipement.tagInventaire ?? '—' }}</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted">Adresse IP</span>
                        {% if equipement.adresseIp %}
                            <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace">
                                <i class="bi bi-broadcast me-1"></i>{{ equipement.adresseIp }}
                            </span>
                        {% else %}
                            <span class="text-muted">Non configurée</span>
                        {% endif %}
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted">Système d'exploitation</span>
                        {% if equipement.systemeExploitation %}
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace">
                                <i class="bi bi-window me-1"></i>{{ equipement.systemeExploitation }}
                            </span>
                        {% else %}
                            <span class="text-muted">Non renseigné</span>
                        {% endif %}
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted">Catégorie</span>
                        <span class="fw-semibold">{{ equipement.categorie ? equipement.categorie.nomCat : 'Non classé' }}</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted">Emplacement</span>
                        <span class="fw-semibold">{{ equipement.lieu ? equipement.lieu.nomLieu : 'Non affecté' }}</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted">Date d'acquisition</span>
                        <span>{{ equipement.dateAcquisition ? equipement.dateAcquisition|date('d/m/Y') : 'Non renseignée' }}</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted">Âge</span>
                        <span>
                            {% if equipement.ageAnnees is not null %}
                                {% if equipement.isObsolete %}
                                    <span class="badge badge-age-obsolete">
                                        <i class="bi bi-exclamation-octagon-fill me-1"></i>{{ equipement.ageAnnees }} ans (Obsolète)
                                    </span>
                                {% elseif equipement.isVieillissant %}
                                    <span class="badge badge-age-warning">
                                        <i class="bi bi-clock-history me-1"></i>{{ equipement.ageAnnees }} ans (Vieillissant)
                                    </span>
                                {% else %}
                                    <span class="badge badge-age-ok">
                                        <i class="bi bi-check-circle me-1"></i>{{ equipement.ageAnnees }} ans
                                    </span>
                                {% endif %}
                            {% else %}
                                <span class="text-muted small">Non renseigné</span>
                            {% endif %}
                        </span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted">Fin de garantie</span>
                        <span>
                            {% if equipement.finGarantie %}
                                {{ equipement.finGarantie|date('d/m/Y') }}
                                {% if equipement.finGarantie|date('Y-m-d') < 'now'|date('Y-m-d') %}
                                    <span class="badge bg-danger-subtle text-danger ms-1">Expirée</span>
                                {% else %}
                                    <span class="badge bg-success-subtle text-success ms-1">Valide</span>
                                {% endif %}
                            {% else %}
                                N/C
                            {% endif %}
                        </span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted">Prix d'achat</span>
                        <span class="fw-bold">{{ equipement.prixAchat ? (equipement.prixAchat|number_format(0, ',', ' ') ~ ' FCFA') : 'N/C' }}</span>
                    </li>
                </ul>
            </div>
            {% if equipement.notes %}
                <div class="card-footer bg-light p-3">
                    <small class="text-muted fw-bold d-block mb-1">Notes & Spécifications :</small>
                    <p class="small text-dark mb-0">{{ equipement.notes }}</p>
                </div>
            {% endif %}
        </div>

        {# Préparation de l'avertissement de scandale / impact si relations existantes #}
        {% set totalRelations = (attributions|length) + (tickets|length) + (composants|length) %}
        {% set scandalText = '' %}
        {% if totalRelations > 0 %}
            {% set scandalText = '⚠️ Cet équipement est actuellement associé à ' ~ attributions|length ~ ' attribution(s), ' ~ tickets|length ~ ' ticket(s) de maintenance et ' ~ composants|length ~ ' composant(s) interne(s). Sa suppression rompra la liaison de ces données dans le parc !' %}
        {% endif %}

        {# Bouton de suppression déclenchant la modale GTA avec avertissement #}
        <button type="button" 
                class="btn btn-outline-danger btn-sm w-100 d-flex align-items-center justify-content-center gap-1 shadow-sm"
                data-bs-toggle="modal" 
                data-bs-target="#gtaDeleteModal"
                data-delete-url="{{ path('app_equipement_delete', {'id': equipement.id}) }}"
                data-item-name="{{ equipement.nom }} (S/N: {{ equipement.numeroSerie }})"
                data-token="{{ csrf_token('delete' ~ equipement.id) }}"
                data-scandal-count="{{ totalRelations }}"
                data-scandal-text="{{ scandalText }}"
                data-shortcut="s">
            <i class="bi bi-trash3"></i>
            <span>Supprimer cet équipement</span>
        </button>
    </div>

    <!-- COLONNE DROITE (Historique des Attributions & Maintenances indépendant) -->
    <div class="col-12 col-lg-7 scroll-pane-right">
        <!-- Historique des Utilisateurs & Attributions -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold small text-dark">
                        <i class="bi bi-people-fill me-1 text-primary"></i> Historique des Utilisateurs
                    </span>
                    {% if attributions|length > 0 %}
                        <span class="badge bg-secondary-subtle text-secondary border font-monospace" style="font-size: 0.72rem;">
                            {{ attributions|length }} bénéficiaire(s)
                        </span>
                    {% endif %}
                </div>
                <button type="button"
                        class="btn btn-outline-dark btn-sm py-0 px-2"
                        style="font-size: 0.78rem;"
                        data-bs-toggle="modal"
                        data-bs-target="#modalAttribuerRapide">
                    <i class="bi bi-plus-lg me-1"></i>Nouveau prêt
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Utilisateur / Bénéficiaire</th>
                                <th>Période d'utilisation</th>
                                <th>Motif</th>
                                <th class="text-end">Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for att in attributions %}
                                <tr class="{{ att.statut == 'En cours' ? 'table-warning-subtle' : '' }}">
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0" style="width: 32px; height: 32px; background: {{ att.statut == 'En cours' ? 'var(--gta-orange)' : '#64748b' }}; font-size: 0.75rem; font-weight: 700;">
                                                {{ att.beneficiaireNom|slice(0, 1)|upper }}
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark small d-flex align-items-center gap-1">
                                                    <span>{{ att.beneficiaireNom }}</span>
                                                    {% if att.statut == 'En cours' %}
                                                        <span class="badge bg-success text-white" style="font-size: 0.65rem;">Actuel</span>
                                                    {% endif %}
                                                </div>
                                                <div class="text-muted small d-flex align-items-center gap-1" style="font-size: 0.72rem;">
                                                    {% if att.personnel and att.personnel.matricule %}
                                                        <span class="badge bg-light text-dark border font-monospace px-1 py-0" style="font-size: 0.65rem;">{{ att.personnel.matricule }}</span>
                                                    {% endif %}
                                                    <span>{{ att.beneficiaireService ?? 'GTAC2A-IARDT' }}</span>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small">
                                            <i class="bi bi-calendar-check me-1 text-muted"></i>
                                            <strong>{{ att.dateDebut|date('d/m/Y') }}</strong>
                                            <i class="bi bi-arrow-right mx-1 text-muted"></i>
                                            {% if att.dateRestitution %}
                                                <span class="text-muted">{{ att.dateRestitution|date('d/m/Y') }}</span>
                                            {% else %}
                                                <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.68rem;">En cours</span>
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td>
                                        <small class="text-muted fst-italic" style="font-size: 0.75rem;">
                                            {{ att.motif ? (att.motif|length > 35 ? att.motif|slice(0, 35) ~ '…' : att.motif) : 'Dotation standard' }}
                                        </small>
                                    </td>
                                    <td class="text-end">
                                        {% if att.statut == 'En cours' %}
                                            <div class="d-flex align-items-center justify-content-end gap-1">
                                                <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.72rem;">
                                                    <i class="bi bi-check-circle-fill me-1"></i>En service
                                                </span>
                                                <form method="post" action="{{ path('app_attribution_restituer', {'id': att.id}) }}" class="d-inline" onsubmit="return confirm('Confirmer la restitution de cet équipement ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('restituer' ~ att.id) }}">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm p-1 py-0" title="Restituer l'équipement en stock" style="font-size: 0.72rem;">
                                                        <i class="bi bi-box-arrow-in-down-left"></i> Restituer
                                                    </button>
                                                </form>
                                            </div>
                                        {% else %}
                                            <span class="badge bg-light text-muted border" style="font-size: 0.72rem;">
                                                <i class="bi bi-clock-history me-1"></i>Restitué
                                            </span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted small">
                                        <i class="bi bi-box-seam fs-4 d-block mb-1 text-secondary opacity-50"></i>
                                        Aucun historique d'utilisateur enregistré pour ce matériel.<br>
                                        <span class="text-muted opacity-75">Équipement neuf ou en stock disponible.</span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- Composants & Pièces installés -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <span class="fw-bold small text-dark"><i class="bi bi-cpu me-1 text-primary"></i> Composants & Pièces Installés</span>
                <a href="{{ path('app_composant_new', {'equipement_id': equipement.id}) }}" class="btn btn-outline-dark btn-sm py-0 px-2" style="font-size: 0.78rem;">
                    + Ajouter composant
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Désignation</th>
                                <th>Type</th>
                                <th>S/N</th>
                                <th>Vétusté</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for comp in composants %}
                                <tr>
                                    <td class="fw-semibold text-dark small">{{ comp.nom }}</td>
                                    <td><span class="badge bg-light text-dark border" style="font-size: 0.75rem;">{{ comp.type }}</span></td>
                                    <td><small class="font-monospace text-muted" style="font-size: 0.75rem;">{{ comp.numeroSerie ?? '-' }}</small></td>
                                    <td>
                                        {% if comp.ageAnnees is not null %}
                                            {% if comp.isObsolete %}
                                                <span class="badge badge-age-obsolete" style="font-size: 0.7rem;">{{ comp.ageAnnees }} ans</span>
                                            {% elseif comp.isVieillissant %}
                                                <span class="badge badge-age-warning" style="font-size: 0.7rem;">{{ comp.ageAnnees }} ans</span>
                                            {% else %}
                                                <span class="badge badge-age-ok" style="font-size: 0.7rem;">{{ comp.ageAnnees }} ans</span>
                                            {% endif %}
                                        {% else %}
                                            <small class="text-muted">-</small>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border" style="font-size: 0.75rem;">{{ comp.statut }}</span>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center py-3 text-muted small">Aucun composant spécifique rattaché à cette machine.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Tickets de maintenance -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <span class="fw-bold small text-danger"><i class="bi bi-tools me-1"></i> Historique des Pannes & Réparations</span>
                <a href="{{ path('app_maintenance_new', {'equipement_id': equipement.id}) }}" class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size: 0.78rem;">
                    + Déclarer panne
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Incident</th>
                                <th>Date</th>
                                <th>Priorité</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ticket in tickets %}
                                <tr>
                                    <td>
                                        <div class="fw-semibold text-dark small">{{ ticket.titre }}</div>
                                        <small class="text-muted" style="font-size: 0.75rem;">{{ ticket.technicien ? ('Par ' ~ ticket.technicien) : 'Non assigné' }}</small>
                                    </td>
                                    <td><small style="font-size: 0.8rem;">{{ ticket.dateCreation|date('d/m/Y') }}</small></td>
                                    <td>
                                        <span class="badge bg-{{ ticket.priorite == 'Critique' or ticket.priorite == 'Haute' ? 'danger' : 'warning' }}-subtle text-dark border" style="font-size: 0.75rem;">
                                            {{ ticket.priorite }}
                                        </span>
                                    </td>
                                    <td>
                                        {% if ticket.statut == 'Résolu' %}
                                            <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.75rem;">Résolu</span>
                                        {% else %}
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size: 0.75rem;">{{ ticket.statut }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center py-3 text-muted small">Aucun incident technique enregistré.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

{# ── Historique des préparations checklist ── #}
{% if preparations is defined and preparations|length > 0 %}
{{ include('checklist/_historique.html.twig', {preparations: preparations, equipement: equipement}) }}
{% endif %}

{% endblock %}

{% block modals %}
{# ===== Modale Attribution Rapide ===== #}
<div class="modal fade" id="modalAttribuerRapide" tabindex="-1" aria-labelledby="modalAttribuerRapideLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 540px;">
        <div class="modal-content border-0 shadow-lg">

            {# En-tête #}
            <div class="modal-header border-0 pb-1 px-4 pt-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 44px; height: 44px; background: #121212; color: #E47000;">
                        <i class="bi bi-person-plus-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="modalAttribuerRapideLabel">Attribuer l'équipement</h5>
                        <p class="text-muted small mb-0">
                            <i class="bi bi-pc-display me-1"></i>
                            <strong>{{ equipement.nom }}</strong>
                            {% if equipement.marque %} — {{ equipement.marque }}{% endif %}
                        </p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>

            {# Corps du formulaire #}
            <form method="post" action="{{ path('app_equipement_attribuer_rapide', {id: equipement.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('attribuer_rapide_' ~ equipement.id) }}">

                <div class="modal-body px-4 py-3">

                    {# Info équipement #}
                    <div class="d-flex align-items-center gap-2 p-3 rounded-3 border mb-3"
                         style="background: #F9FAFB;">
                        <i class="bi bi-info-circle text-muted"></i>
                        <span class="small text-muted">
                            Cette attribution passera automatiquement le statut de l'équipement à
                            <strong class="text-success">En service</strong>.
                        </span>
                    </div>

                    {# Bénéficiaire par défaut : Liste du Personnel GTA #}
                    <div class="mb-3">
                        <label for="attr_personnel_id" class="form-label fw-bold small">
                            <i class="bi bi-people-fill me-1 text-primary"></i>
                            Personnel bénéficiaire (Par défaut) <span class="text-danger">*</span>
                        </label>
                        <select id="attr_personnel_id" name="personnel_id" class="form-select" onchange="onQuickModalPersonnelChange(this)">
                            <option value="">-- Choisir un collaborateur dans la liste GTA --</option>
                            {% set currentGroup = '' %}
                            {% for p in personnels|default([]) %}
                                {% if p.type != currentGroup %}
                                    {% if currentGroup != '' %}</optgroup>{% endif %}
                                    {% set currentGroup = p.type %}
                                    <optgroup label="{% if p.type == 'Employé' %}👔 Employés (Salariés){% elseif p.type == 'Prestataire' %}💼 Prestataires & Consultants{% elseif p.type == 'Stagiaire' %}🎓 Stagiaires & Alternants{% elseif p.type == 'Visiteur' %}🏷️ Visiteurs{% else %}👤 Autre Personnel{% endif %}">

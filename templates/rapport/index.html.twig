{% extends 'base.html.twig' %}

{% block title %}Rapports & Exports | GTAC2A-IARDT{% endblock %}

{% block body %}
{# En-tête de page #}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 gap-2 flex-shrink-0">
    <div>
        <h1 class="h3 fw-bold mb-1" style="color: #121212;">Rapports & Exports</h1>
        <p class="text-muted mb-0 small">Génération et export des rapports d'inventaire</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" onclick="window.print()" class="btn btn-outline-dark d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-printer"></i>
            <span>Imprimer</span>
        </button>
        <a href="#custom-generator" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-file-earmark-excel-fill"></i>
            <span>Export Excel</span>
        </a>
    </div>
</div>

{# 1. Raccourcis Rapports Spécialisés #}
<div class="card rapport-dark-card mb-4 border-0 shadow-sm" style="background: #1e1e1e;">
    <div class="card-body p-3">
        <div class="small text-uppercase fw-bold text-light mb-2 opacity-75">
            <i class="bi bi-collection me-1 text-warning"></i> Rapports Prédéfinis
        </div>
        <div class="row g-2">
            <div class="col-6 col-md-4 col-xl-2">
                <a href="{{ path('app_rapport_index', {'scope': 'equipements'}) }}"
                   class="btn btn-sm w-100 text-start py-2 d-flex align-items-center gap-2 {{ current_scope == 'equipements' ? 'btn-warning text-dark fw-bold' : 'btn-outline-light' }}">
                    <i class="bi bi-pc-display fs-5"></i>
                    <span class="text-truncate">Actifs & Matériel</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <a href="{{ path('app_rapport_index', {'scope': 'composants'}) }}"
                   class="btn btn-sm w-100 text-start py-2 d-flex align-items-center gap-2 {{ current_scope == 'composants' ? 'btn-warning text-dark fw-bold' : 'btn-outline-light' }}">
                    <i class="bi bi-cpu fs-5"></i>
                    <span class="text-truncate">Composants & Pièces</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <a href="{{ path('app_rapport_index', {'scope': 'attributions'}) }}"
                   class="btn btn-sm w-100 text-start py-2 d-flex align-items-center gap-2 {{ current_scope == 'attributions' ? 'btn-warning text-dark fw-bold' : 'btn-outline-light' }}">
                    <i class="bi bi-arrow-left-right fs-5"></i>
                    <span class="text-truncate">Dotations & Prêts</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <a href="{{ path('app_rapport_index', {'scope': 'maintenances'}) }}"
                   class="btn btn-sm w-100 text-start py-2 d-flex align-items-center gap-2 {{ current_scope == 'maintenances' ? 'btn-warning text-dark fw-bold' : 'btn-outline-light' }}">
                    <i class="bi bi-tools fs-5"></i>
                    <span class="text-truncate">Pannes & Coûts</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <a href="{{ path('app_rapport_index', {'scope': 'equipements', 'age': 'obsolete'}) }}"
                   class="btn btn-sm w-100 text-start py-2 d-flex align-items-center gap-2 {{ current_scope == 'equipements' and current_age == 'obsolete' ? 'btn-danger text-white fw-bold' : 'btn-outline-danger' }}">
                    <i class="bi bi-hourglass-bottom fs-5"></i>
                    <span class="text-truncate">Audit Obsolète (&gt;5 ans)</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <a href="{{ path('app_rapport_index', {'scope': 'bilan'}) }}"
                   class="btn btn-sm w-100 text-start py-2 d-flex align-items-center gap-2 {{ current_scope == 'bilan' ? 'btn-info text-dark fw-bold' : 'btn-outline-info' }}">
                    <i class="bi bi-layers-fill fs-5"></i>
                    <span class="text-truncate">Bilan Global</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <a href="{{ path('app_rapport_export', {'scope': current_scope, 'format': 'excel', 'statut': current_statut, 'categorie_id': current_categorie, 'lieu_id': current_lieu, 'age': current_age}) }}"
                   class="btn btn-sm w-100 text-start py-2 d-flex align-items-center gap-2 btn-success text-white fw-bold shadow-sm">
                    <i class="bi bi-cloud-arrow-down-fill fs-5"></i>
                    <span class="text-truncate">Export Immédiat Excel</span>
                </a>
            </div>
        </div>
    </div>
</div>

{# Conteneur défilant #}
<div class="scroll-table-container pb-5">

    {# 2. Cartes de Métriques Clés GTA #}
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card h-100 shadow-sm border-0">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Valorisation Globale</span>
                        <div class="fs-4 fw-bold mt-1" style="color: var(--gta-orange);">
                            {{ valeurTotaleParc|number_format(0, ',', ' ') }} <span class="fs-6 text-muted">FCFA</span>
                        </div>
                        <small class="text-secondary">{{ totalEquipements }} équipements + {{ totalComposantsPieces }} pièces</small>
                    </div>
                    <div class="stat-icon" style="background: rgba(228, 112, 0, 0.12); color: var(--gta-orange);">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card h-100 shadow-sm border-0" style="border-left-color: #16a34a !important;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Taux de Disponibilité</span>
                        <div class="fs-4 fw-bold mt-1 text-success">{{ tauxDisponibilite }}%</div>
                        <small class="text-muted">{{ statutCounts['En service'] ?? 0 }} machines en service</small>
                    </div>
                    <div class="stat-icon bg-success-subtle text-success">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card h-100 shadow-sm border-0" style="border-left-color: #2563eb !important;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Coûts de Maintenance</span>
                        <div class="fs-4 fw-bold mt-1 text-primary">
                            {{ coutTotalMaintenance|number_format(0, ',', ' ') }} <span class="fs-6 text-muted">FCFA</span>
                        </div>
                        <small class="text-muted">{{ ticketsResolus }} interventions résolues</small>
                    </div>
                    <div class="stat-icon bg-primary-subtle text-primary">
                        <i class="bi bi-tools"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card h-100 shadow-sm border-0" style="border-left-color: {{ equipementsObsoletes > 0 ? '#dc3545' : '#eab308' }} !important;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Parc Vétuste (&gt; 3 ans)</span>
                        <div class="fs-4 fw-bold mt-1 {{ equipementsObsoletes > 0 ? 'text-danger' : 'text-warning' }}">
                            {{ equipementsObsoletes + equipementsVieillissants }} <span class="fs-6 text-muted">unités</span>
                        </div>
                        <small class="text-muted">{{ equipementsObsoletes }} obsolètes critiques (&gt; 5 ans)</small>
                    </div>
                    <div class="stat-icon bg-danger-subtle text-danger">
                        <i class="bi bi-hourglass-bottom"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# 3. Générateur de Rapport Personnalisé #}
    <div class="card shadow-sm mb-4 border" id="custom-generator">
        <div class="card-header py-3 border-bottom d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <div>
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    {% if is_bilan %}
                        <i class="bi bi-layers-fill fs-5 text-info"></i>
                        <span>Bilan Global - Synthèse Unifiée 360°</span>
                        <span class="badge bg-info text-dark font-monospace ms-2">TABLEAU UNIQUE</span>
                    {% else %}
                        <i class="bi bi-sliders2-vertical fs-5" style="color: var(--gta-orange);"></i>
                        <span>Générateur de Rapport Personnalisé</span>
                        <span class="badge bg-dark text-white font-monospace ms-2">SCOPE : {{ current_scope|upper }}</span>
                    {% endif %}
                </h5>
                {% if is_bilan %}
                    <small class="text-muted">Cochez les informations souhaitées par domaine (Équipement, Dotation, Composants, Maintenance) — le fichier Excel regroupe tout dans <strong>un seul tableau</strong> (matériel, adresse IP, modèle, utilisateur, pièces, tickets).</small>
                {% else %}
                    <small class="text-muted">Cochez les colonnes souhaitées et téléchargez directement votre fichier Excel (.xls) ou CSV</small>
                {% endif %}
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="checkAllColumns(true)">
                    <i class="bi bi-check-all me-1"></i> Tout cocher
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="checkAllColumns(false)">
                    <i class="bi bi-x me-1"></i> Tout décocher
                </button>
            </div>
        </div>

        <div class="card-body p-4 bg-light-subtle">
            <form id="customReportForm" method="get" action="{{ path('app_rapport_index') }}">
                <input type="hidden" name="scope" value="{{ current_scope }}">

                {# A. Onglets de sélection de Scope #}
                <div class="mb-4">
                    <label class="form-label small fw-bold text-uppercase text-muted d-block mb-2">
                        1. Domaine / Scope du rapport :
                    </label>
                    <div class="btn-group flex-wrap" role="group">
                        <a href="{{ path('app_rapport_index', {'scope': 'equipements'}) }}" class="btn btn-sm {{ current_scope == 'equipements' ? 'btn-dark fw-bold' : 'btn-outline-dark' }}">
                            <i class="bi bi-pc-display-horizontal me-1"></i> Équipements IT
                        </a>
                        <a href="{{ path('app_rapport_index', {'scope': 'composants'}) }}" class="btn btn-sm {{ current_scope == 'composants' ? 'btn-dark fw-bold' : 'btn-outline-dark' }}">
                            <i class="bi bi-cpu me-1"></i> Composants & Pièces
                        </a>
                        <a href="{{ path('app_rapport_index', {'scope': 'attributions'}) }}" class="btn btn-sm {{ current_scope == 'attributions' ? 'btn-dark fw-bold' : 'btn-outline-dark' }}">
                            <i class="bi bi-arrow-left-right me-1"></i> Dotations & Prêts
                        </a>
                        <a href="{{ path('app_rapport_index', {'scope': 'maintenances'}) }}" class="btn btn-sm {{ current_scope == 'maintenances' ? 'btn-dark fw-bold' : 'btn-outline-dark' }}">
                            <i class="bi bi-tools me-1"></i> Maintenances & SAV
                        </a>
                        <a href="{{ path('app_rapport_index', {'scope': 'bilan'}) }}" class="btn btn-sm {{ current_scope == 'bilan' ? 'btn-info text-dark fw-bold shadow-sm' : 'btn-outline-secondary' }}">
                            <i class="bi bi-layers-fill me-1"></i> Bilan Global (Tout réuni en un seul tableau)
                        </a>
                    </div>
                </div>

                {# B. Matrice des Colonnes à Cocher #}
                <div class="mb-4">
                    <label class="form-label small fw-bold text-uppercase text-muted d-block mb-2">
                        2. Cochez les informations à faire figurer dans le tableau :
                    </label>

                    {% if is_bilan %}
                        {# Affichage groupé par domaine : Équipements, Dotations, Composants, Maintenances #}
                        <div class="row g-3">
                            {% for groupKey, group in bilan_groups %}
                                <div class="col-12 col-xl-6">
                                    <div class="card border rounded-3 shadow-sm h-100 overflow-hidden">
                                        <div class="card-header py-2 px-3 d-flex align-items-center justify-content-between" style="border-left: 4px solid {{ group.color }};">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi {{ group.icon }} fs-5" style="color: {{ group.color }};"></i>
                                                <span class="fw-bold text-dark">{{ group.title }}</span>
                                                {% set groupSelectedCount = 0 %}
                                                {% for colKey in group.columns|keys %}
                                                    {% if colKey in selected_columns %}
                                                        {% set groupSelectedCount = groupSelectedCount + 1 %}
                                                    {% endif %}
                                                {% endfor %}
                                                <span class="badge bg-secondary-subtle text-dark border ms-1" style="font-size:0.75rem;">
                                                    <span id="badge-count-{{ groupKey }}">{{ groupSelectedCount }}</span>/{{ group.columns|length }}
                                                </span>
                                            </div>
                                            <div class="d-flex gap-1">
                                                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" style="font-size: 0.72rem;" onclick="checkGroupColumns('{{ groupKey }}', true)">
                                                    Tout cocher
                                                </button>
                                                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" style="font-size: 0.72rem;" onclick="checkGroupColumns('{{ groupKey }}', false)">
                                                    Tout décocher
                                                </button>
                                            </div>
                                        </div>
                                        <div class="card-body p-3 bg-light-subtle">
                                            <div class="row g-2">
                                                {% for colKey, colConf in group.columns %}
                                                    <div class="col-12 col-sm-6">
                                                        <div class="form-check">
                                                            <input class="form-check-input report-col-checkbox group-col-{{ groupKey }}"
                                                                   type="checkbox"
                                                                   name="columns[]"
                                                                   value="{{ colKey }}"
                                                                   id="col_{{ colKey }}"
                                                                   data-group="{{ groupKey }}"
                                                                   onchange="updateGroupCount('{{ groupKey }}')"
                                                                   {{ colKey in selected_columns ? 'checked' : '' }}>
                                                            <label class="form-check-label small text-dark" for="col_{{ colKey }}">
                                                                {{ colConf.label }}
                                                                {% if colConf.type == 'currency' %}
                                                                    <span class="badge bg-light text-muted border py-0 px-1" style="font-size: 0.65rem;">FCFA</span>
                                                                {% elseif colConf.type == 'date' %}
                                                                    <span class="badge bg-light text-muted border py-0 px-1" style="font-size: 0.65rem;">Date</span>
                                                                {% elseif colConf.type == 'badge' %}
                                                                    <span class="badge bg-light text-muted border py-0 px-1" style="font-size: 0.65rem;">Statut</span>
                                                                {% endif %}
                                                            </label>
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        {# Scope unique : grille classique #}
                        <div class="p-3 border rounded-3 shadow-sm">
                            <div class="row g-2">
                                {% for colKey, colConf in available_columns %}
                                    <div class="col-12 col-sm-6 col-md-4 col-xl-3">
                                        <div class="form-check">
                                            <input class="form-check-input report-col-checkbox"
                                                   type="checkbox"
                                                   name="columns[]"
                                                   value="{{ colKey }}"
                                                   id="col_{{ colKey }}"
                                                   {{ colKey in selected_columns ? 'checked' : '' }}>
                                            <label class="form-check-label small text-dark" for="col_{{ colKey }}">
                                                {{ colConf.label }}
                                                {% if colConf.type == 'currency' %}
                                                    <span class="badge bg-light text-muted border py-0 px-1" style="font-size: 0.65rem;">FCFA</span>
                                                {% elseif colConf.type == 'date' %}
                                                    <span class="badge bg-light text-muted border py-0 px-1" style="font-size: 0.65rem;">Date</span>
                                                {% endif %}
                                            </label>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>

                {# C. Filtres de données #}
                <div class="mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <label class="form-label small fw-bold text-uppercase text-muted mb-0">
                            3. Filtres &amp; Critères de sélection {% if is_bilan %}<span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">Actifs sur le Bilan Global</span>{% endif %} :
                        </label>
                        {% if current_statut != 'all' or current_categorie != 'all' or current_lieu != 'all' or current_age != 'all' %}
                            <a href="{{ path('app_rapport_index', {'scope': current_scope}) }}" class="btn btn-link btn-sm text-danger p-0 text-decoration-none" title="Réinitialiser les filtres">
                                <i class="bi bi-x-circle me-1"></i>Effacer les filtres
                            </a>
                        {% endif %}
                    </div>
                    <div class="row g-2">
                        <div class="col-12 col-md-3">
                            <label class="small text-muted mb-1">Statut opérationnel</label>
                            <select name="statut" class="form-select form-select-sm">
                                <option value="all" {{ current_statut == 'all' ? 'selected' : '' }}>-- Tous les statuts --</option>
                                <option value="En service" {{ current_statut == 'En service' ? 'selected' : '' }}>En service</option>
                                <option value="En stock" {{ current_statut == 'En stock' ? 'selected' : '' }}>En stock</option>
                                <option value="En panne" {{ current_statut == 'En panne' ? 'selected' : '' }}>En panne</option>
                                <option value="Prêté" {{ current_statut == 'Prêté' ? 'selected' : '' }}>Prêté</option>
                                <option value="Au rebut" {{ current_statut == 'Au rebut' ? 'selected' : '' }}>Au rebut</option>
                            </select>
                        </div>

                        {% if current_scope == 'equipements' or is_bilan %}
                            <div class="col-12 col-md-3">
                                <label class="small text-muted mb-1">Catégorie</label>
                                <select name="categorie_id" class="form-select form-select-sm">
                                    <option value="all">-- Toutes les catégories --</option>
                                    {% for cat in categories %}
                                        <option value="{{ cat.id }}" {{ current_categorie == cat.id ? 'selected' : '' }}>{{ cat.nomCat }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endif %}

                        <div class="col-12 col-md-3">
                            <label class="small text-muted mb-1">Emplacement / Salle</label>
                            <select name="lieu_id" class="form-select form-select-sm">
                                <option value="all">-- Tous les emplacements --</option>
                                {% for lieu in lieux %}
                                    <option value="{{ lieu.id }}" {{ current_lieu == lieu.id ? 'selected' : '' }}>{{ lieu.nomLieu }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        {% if current_scope in ['equipements', 'composants'] or is_bilan %}
                            <div class="col-12 col-md-3">
                                <label class="small text-muted mb-1">Vétusté / Âge</label>
                                <select name="age" class="form-select form-select-sm">
                                    <option value="all" {{ current_age == 'all' ? 'selected' : '' }}>-- Tout âge --</option>
                                    <option value="vieillissant" {{ current_age == 'vieillissant' ? 'selected' : '' }}>⚠️ Vieillissant (3 à 5 ans)</option>
                                    <option value="obsolete" {{ current_age == 'obsolete' ? 'selected' : '' }}>🚨 Obsolète (&gt; 5 ans)</option>
                                </select>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# D. Boutons d'Action & Téléchargement #}
                <div class="d-flex flex-wrap align-items-center justify-content-between pt-3 border-top gap-2">
                    <button type="submit" class="btn btn-outline-dark d-inline-flex align-items-center gap-2" data-shortcut="v" title="Raccourci : V">
                        <i class="bi bi-arrow-repeat"></i>
                        <span>Actualiser l'Aperçu Direct</span>
                    </button>

                    <div class="d-flex gap-2">
                        <button type="button" onclick="submitExport('csv')" class="btn btn-outline-success d-inline-flex align-items-center gap-2 shadow-sm">
                            <i class="bi bi-filetype-csv fs-5"></i>
                            <span>Télécharger CSV</span>
                        </button>
                        <button type="button" onclick="submitExport('excel')" class="btn btn-success d-inline-flex align-items-center gap-2 shadow-sm px-4 fw-bold">
                            <i class="bi bi-file-earmark-excel-fill fs-5"></i>
                            <span>{{ is_bilan ? 'Télécharger Bilan Excel (Tableau Unique)' : 'Télécharger Excel (.xls)' }}</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {# 4. Tableau Live Preview (Tableau Unique) #}
    <div class="card shadow-sm border mb-4">
        <div class="card-header py-3 border-bottom d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <div>
                <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-table text-primary"></i>
                    {% if is_bilan %}
                        <span>Aperçu en Direct du Bilan Global (Tableau Unique 360°)</span>
                        <span class="badge bg-info-subtle text-dark border">
                            {{ preview_columns|length }} colonnes cochées
                        </span>
                    {% else %}
                        <span>Aperçu en Direct du Rapport Excel</span>
                        <span class="badge bg-secondary-subtle text-dark border">
                            {{ preview_columns|length }} colonnes cochées
                        </span>
                    {% endif %}
                </h6>
                <small class="text-muted">
                    {% if is_bilan %}
                        Chaque ligne regroupe l'équipement, son modèle, son adresse IP, la personne qui l'utilise, ses pièces et son historique SAV ({{ preview_rows|length }} affichés sur {{ total_matching_rows }}).
                    {% else %}
                        Affichage des {{ preview_rows|length }} premiers enregistrements sur {{ total_matching_rows }} résultats trouvés
                    {% endif %}
                </small>
            </div>
            <div class="d-flex gap-2">
                <button type="button" onclick="submitExport('csv')" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-filetype-csv"></i>
                    <span>Export CSV</span>
                </button>
                <button type="button" onclick="submitExport('excel')" class="btn btn-sm btn-success d-inline-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-file-earmark-excel-fill"></i>
                    <span>Télécharger Excel (.xls)</span>
                </button>
            </div>
        </div>

        <div class="table-responsive" style="max-height: 540px; overflow-y: auto;">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark sticky-top small" style="background-color: #121212 !important;">
                    <tr>
                        {% for colKey, colLabel in preview_columns %}
                            <th class="py-2 px-3 text-nowrap">{{ colLabel }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody class="small">
                    {% for row in preview_rows %}
                        <tr>
                            {% for colKey, colLabel in preview_columns %}
                                <td class="px-3 text-nowrap">
                                    {% set val = row[colKey] ?? '-' %}
                                    {% if colKey in ['statut', 'vetuste', 'priorite', 'statutGarantie', 'statutAttribution', 'dernierTicketStatut'] %}
                                        {% if val in ['En service', 'Résolu', 'Récent (< 3 ans)', 'Valide', 'Disponible'] %}
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">{{ val }}</span>
                                        {% elseif val in ['Obsolète (> 5 ans)', 'En panne', 'Critique', 'Expirée', 'Au rebut'] %}
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">{{ val }}</span>
                                        {% elseif val in ['Vieillissant (3-5 ans)', 'En cours', 'Prêté', 'Haute', 'Prolongé'] %}
                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle">{{ val }}</span>
                                        {% else %}
                                            <span class="badge bg-light text-dark border">{{ val }}</span>
                                        {% endif %}
                                    {% elseif colKey in ['prixAchat', 'valeurTotale', 'composantsValeur', 'cout', 'coutTotalMaintenance'] and val != '-' and val != 0 %}
                                        <span class="fw-bold font-monospace">{{ val|number_format(0, ',', ' ') }} FCFA</span>
                                    {% elseif colKey == 'adresseIp' and val != '-' %}
                                        <span class="font-monospace text-primary fw-semibold">{{ val }}</span>
                                    {% elseif colKey == 'beneficiaireNom' and val not in ['-', 'Non renseigné', 'En stock DSI (Non attribué)'] %}
                                        <span class="fw-bold text-dark"><i class="bi bi-person me-1 text-muted"></i>{{ val }}</span>
                                    {% else %}
                                        {{ val }}
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="{{ max(1, preview_columns|length) }}" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Aucun enregistrement correspondant ou aucune colonne sélectionnée.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% if total_matching_rows > preview_rows|length %}
            <div class="card-footer bg-light text-muted small text-center py-2">
                <i class="bi bi-info-circle me-1"></i>
                Le fichier Excel complet contiendra l'intégralité des <strong>{{ total_matching_rows }} lignes</strong> du parc avec l'ensemble des colonnes cochées.
            </div>
        {% endif %}
    </div>

</div>

<script>
    function checkAllColumns(checked) {
        document.querySelectorAll('.report-col-checkbox').forEach(cb => {
            cb.checked = checked;
        });
        document.querySelectorAll('[id^="badge-count-"]').forEach(badge => {
            const groupKey = badge.id.replace('badge-count-', '');
            updateGroupCount(groupKey);
        });
    }

    function checkGroupColumns(groupKey, checked) {
        document.querySelectorAll('.group-col-' + groupKey).forEach(cb => {
            cb.checked = checked;
        });
        updateGroupCount(groupKey);
    }

    function updateGroupCount(groupKey) {
        const checked = document.querySelectorAll('.group-col-' + groupKey + ':checked').length;
        const badge = document.getElementById('badge-count-' + groupKey);
        if (badge) {
            badge.textContent = checked;
        }
    }

    function submitExport(format) {
        const form = document.getElementById('customReportForm');
        if (!form) return;

        const btnExcel = document.querySelector('button[onclick*="submitExport(\'excel\')"]');
        const originalContent = btnExcel ? btnExcel.innerHTML : '';
        if (btnExcel && format === 'excel') {
            btnExcel.disabled = true;
            btnExcel.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Génération...';
            setTimeout(() => {
                btnExcel.disabled = false;
                btnExcel.innerHTML = originalContent;
            }, 4000);
        }

        const formData = new FormData(form);
        const params = new URLSearchParams();

        for (const [key, value] of formData.entries()) {
            params.append(key, value);
        }
        params.set('format', format);

        const exportUrl = '{{ path("app_rapport_export") }}?' + params.toString();
        window.location.href = exportUrl;
    }
</script>
{% endblock %}
